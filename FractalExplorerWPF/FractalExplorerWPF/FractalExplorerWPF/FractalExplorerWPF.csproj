<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Icons\FractalExplorer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Resource Include="Assets\Previews\**\*" />
    <Resource Include="Assets\Icons\**\*" />
    <EmbeddedResource Include="Assets\Certificates\fractalcloud-caddy-root.crt" />
    <None Update="cloud-connection.local.json" Condition="Exists('cloud-connection.local.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Проверочный проект использует внутренние тестовые швы движка (напр. выбор
         представления δ глубокого зума). -->
    <InternalsVisibleTo Include="SavePreviewVerification" />
    <!-- Генератор скриншотов заполняет облачный менеджер без сети (ShowEntriesForPreview). -->
    <InternalsVisibleTo Include="ScreenshotGen" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
