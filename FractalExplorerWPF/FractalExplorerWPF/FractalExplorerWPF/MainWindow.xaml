<Window x:Class="FractalExplorerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:models="clr-namespace:FractalExplorerWPF.Models"
        Title="Менеджер фракталов - WPF"
        Width="1180"
        Height="740"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Icons/FractalExplorer.ico"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        PreviewMouseDown="MainWindow_OnPreviewMouseDown">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Кнопки верхней панели: без рамки, пока на них не навели. Текст берёт цвет кнопки,
             иначе общий стиль TextBlock перекрасил бы его и в выключенном состоянии. -->
        <Style x:Key="TopBarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="TopBarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ThemeToggleButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <!-- Поле поиска со значком слева и кнопками справа. Отступы текста задаёт сам TextBox через
             Padding, поэтому, в отличие от общего шаблона, у области ввода нет собственного отступа. -->
        <Style x:Key="CatalogSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="34,0,112,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Theme.InteractiveBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Theme.FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ToolTip" Value="Перетащите, чтобы изменить ширину панели"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="GripLine" Width="1" Margin="0,24" HorizontalAlignment="Center"
                                    Background="{DynamicResource Theme.BorderBrush}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripLine" Property="Width" Value="3"/>
                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                <Setter TargetName="GripLine" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="GripLine" Property="Width" Value="3"/>
                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource Theme.AccentSecondaryBrush}"/>
                                <Setter TargetName="GripLine" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Контекстное меню плитки. Всплывающее меню живёт вне дерева окна, поэтому стиль задаётся явно. -->
        <Style x:Key="CatalogMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CatalogContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CatalogMenuItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="200">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Меню разделов ===== -->
        <Style x:Key="ScopeItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="12,6,10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <!-- Оба выравнивания заданы явно: иначе системный стиль привязывает их к родительскому списку,
                 и у отсоединённого контейнера это даёт ошибку привязки. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Body" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"/>
                            <Border x:Name="Marker" Width="3" Margin="1,7" HorizontalAlignment="Left" CornerRadius="1.5"
                                    Background="{DynamicResource Theme.AccentPrimaryBrush}" Visibility="Hidden"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Theme.HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Theme.ControlBackgroundBrush}"/>
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Theme.FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSection}" Value="True">
                    <Setter Property="Margin" Value="0,14,0,1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ScopeTemplate" DataType="{x:Type models:CatalogScope}">
            <Grid x:Name="Row" Margin="{Binding Indent}" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph" Width="24" Style="{StaticResource IconText}"
                           Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="{Binding Glyph}"/>
                <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center"
                           TextWrapping="Wrap" Text="{Binding DisplayTitle}"/>
                <TextBlock x:Name="CountText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                           Text="{Binding Count}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Glyph}" Value="">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:CatalogScopeKind.Favorites}">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Theme.WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSection}" Value="True">
                    <Setter TargetName="TitleText" Property="FontSize" Value="14"/>
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.45"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Сетка ===== -->
        <Style x:Key="CatalogTileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Theme.HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Theme.ControlBackgroundBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Theme.FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CatalogTileTemplate" DataType="{x:Type models:CatalogTile}">
            <StackPanel>
                <StackPanel.ContextMenu>
                    <ContextMenu Style="{StaticResource CatalogContextMenuStyle}" Opened="TileContextMenu_OnOpened">
                        <MenuItem Header="Запустить" FontWeight="SemiBold" Click="TileLaunchMenuItem_OnClick"/>
                        <MenuItem Header="Добавить в избранное" Click="TileFavoriteMenuItem_OnClick"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <!-- Квадрат по ширине плитки: превью квадратные, подпись под ними переносится. -->
                <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                    <Border CornerRadius="6" Background="{DynamicResource Theme.ControlBackgroundAltBrush}"/>
                    <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock HorizontalAlignment="Center" FontSize="18" Style="{StaticResource IconText}"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="&#xE895;"
                               ToolTip="Превью строится"
                               Visibility="{Binding IsPreviewPending, Converter={StaticResource BoolToVisibility}}"/>
                    <Border Width="24" Height="24" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                            CornerRadius="12" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                            ToolTip="В избранном"
                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Style="{StaticResource IconText}"
                                   Foreground="{DynamicResource Theme.WarningBrush}" Text="&#xE735;"/>
                    </Border>
                </Grid>
                <TextBlock Margin="2,7,2,2" FontSize="12.5" TextWrapping="Wrap" Text="{Binding DisplayName}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CatalogGroupHeaderTemplate">
            <WrapPanel Margin="6,16,6,4">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Text="{Binding Name.Title}"/>
                <Border Margin="0,0,10,0" Padding="7,1" VerticalAlignment="Center" CornerRadius="9"
                        Background="{DynamicResource Theme.ControlBackgroundBrush}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="{Binding ItemCount}"/>
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                           Text="{Binding Name.ParentPath}"/>
            </WrapPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Верхняя панель ===== -->
        <Grid Margin="16,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel MinWidth="220" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="22" Height="22" Source="Assets/Icons/FractalExplorer.ico"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Каталог"/>
            </StackPanel>

            <Grid Grid.Column="1" MaxWidth="640" Margin="12,0,16,0" HorizontalAlignment="Stretch">
                <TextBox x:Name="SearchBox" Style="{StaticResource CatalogSearchBoxStyle}"
                         AutomationProperties.Name="Поиск по каталогу"
                         TextChanged="SearchBox_OnTextChanged" PreviewKeyDown="SearchBox_OnPreviewKeyDown"/>
                <TextBlock Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                           Style="{StaticResource IconText}" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                           Text="&#xE721;"/>
                <TextBlock x:Name="SearchPlaceholder" Margin="36,0,112,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                           Text="Поиск по названию, описанию и разделу"/>
                <StackPanel Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="ClearSearchButton" Width="28" Height="28" MinHeight="0" Padding="0"
                            Style="{StaticResource TopBarButtonStyle}" Visibility="Collapsed"
                            ToolTip="Очистить поиск (Esc)" AutomationProperties.Name="Очистить поиск"
                            Click="ClearSearchButton_OnClick">
                        <TextBlock FontSize="11" Style="{StaticResource IconText}" Text="&#xE711;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Border Margin="4,0,0,0" Padding="6,3" VerticalAlignment="Center" CornerRadius="4" Cursor="Hand"
                            Background="{DynamicResource Theme.ControlBackgroundAltBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                            ToolTip="Быстрый переключатель (Ctrl+K)"
                            MouseLeftButtonDown="QuickSwitcherHint_OnMouseLeftButtonDown">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Ctrl+K"/>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Style="{StaticResource TopBarButtonStyle}" ToolTip="Облачные сохранения FractalCloud"
                        Click="CloudButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE753;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Облако"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="SettingsToggle" Margin="4,0" Style="{StaticResource TopBarToggleStyle}"
                              ToolTip="Порядок отрисовки и тема оформления"
                              Checked="SettingsToggle_OnChecked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Настройки"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </StackPanel>
                </ToggleButton>
                <Button Width="36" Padding="0" Style="{StaticResource TopBarButtonStyle}"
                        ToolTip="О программе" AutomationProperties.Name="О программе"
                        Click="AboutButton_OnClick">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE946;"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Меню разделов | сетка | детали ===== -->
        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240*" MinWidth="190" MaxWidth="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="562*" MinWidth="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="330*" MinWidth="270" MaxWidth="520"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CatalogPanelStyle}" Padding="6,4,4,8">
                <ListBox x:Name="ScopeList" Padding="0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.CanContentScroll="False"
                         ItemContainerStyle="{StaticResource ScopeItemStyle}"
                         ItemTemplate="{StaticResource ScopeTemplate}"
                         AutomationProperties.Name="Разделы каталога"
                         SelectionChanged="ScopeList_OnSelectionChanged"/>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource CatalogSplitterStyle}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="8,2,8,0">
                    <TextBlock x:Name="GalleryTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GallerySubtitle" Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                </StackPanel>

                <ListBox x:Name="CatalogGallery" Grid.Row="1" Margin="0,4,0,0" Padding="2,0,4,12"
                         Background="Transparent" BorderThickness="0" SelectionMode="Single"
                         ScrollViewer.CanContentScroll="False"
                         ItemContainerStyle="{StaticResource CatalogTileItemStyle}"
                         ItemTemplate="{StaticResource CatalogTileTemplate}"
                         AutomationProperties.Name="Режимы каталога"
                         SelectionChanged="CatalogGallery_OnSelectionChanged"
                         PreviewKeyDown="CatalogGallery_OnPreviewKeyDown"
                         MouseDoubleClick="CatalogGallery_OnMouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:UniformWrapPanel MinItemWidth="150" HorizontalSpacing="4" VerticalSpacing="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource CatalogGroupHeaderTemplate}">
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <StackPanel x:Name="GalleryEmptyState" Grid.Row="1" MaxWidth="440" Margin="24,56,24,0"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock x:Name="GalleryEmptyGlyph" HorizontalAlignment="Center" FontSize="34"
                               Style="{StaticResource IconText}" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               Text="&#xE721;"/>
                    <TextBlock x:Name="GalleryEmptyTitle" Margin="0,14,0,0" HorizontalAlignment="Center"
                               FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GalleryEmptyText" Margin="0,6,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <Button x:Name="GalleryEmptyAction" Margin="0,16,0,0" HorizontalAlignment="Center"
                            Click="GalleryEmptyAction_OnClick"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Style="{StaticResource CatalogSplitterStyle}"/>

            <Border Grid.Column="4" Style="{StaticResource CatalogPanelStyle}">
                <Grid>
                    <!-- DataContext — выбранная плитка (CatalogTile), задаётся из кода. -->
                    <!-- Постоянное место под полосу исключает колебания Auto-прокрутки:
                         сужение квадратного превью уменьшало высоту и снова скрывало полосу. -->
                    <ScrollViewer x:Name="DetailsContent" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible">
                        <StackPanel Margin="16">
                            <Grid x:Name="DetailsPreviewFrame" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                                <Border CornerRadius="6" Background="{DynamicResource Theme.ControlBackgroundAltBrush}"
                                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"/>
                                <Border Margin="1" CornerRadius="5" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding DisplayPreview}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Строится превью…"
                                           Visibility="{Binding IsPreviewPending, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>

                            <TextBlock x:Name="DetailsBreadcrumb" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="{Binding Breadcrumb}"/>
                            <TextBlock x:Name="DetailsTitle" Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Text="{Binding DisplayName}"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LaunchButton" Height="40" Style="{StaticResource Theme.AccentButtonStyle}"
                                        IsEnabled="{Binding CanLaunch}" Click="LaunchButton_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE768;"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Запустить"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanLaunch}" Value="False">
                                                            <Setter Property="Text" Value="Запуск недоступен"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FavoriteButton" Grid.Column="2" Width="40" Height="40" Padding="0"
                                        Click="FavoriteButton_OnClick">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="ToolTip" Value="Добавить в избранное"/>
                                            <Setter Property="AutomationProperties.Name" Value="Добавить в избранное"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="ToolTip" Value="Убрать из избранного"/>
                                                    <Setter Property="AutomationProperties.Name" Value="Убрать из избранного"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock FontSize="16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                                <Setter Property="Text" Value="&#xE734;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Text" Value="&#xE735;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="DetailsDescription" Margin="0,16,0,0" FontSize="14" LineHeight="22"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                       Text="{Binding Description}"/>
                            <TextBlock Margin="0,18,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                       Text="Enter или двойной щелчок по плитке — запуск, правая кнопка — меню плитки."/>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock x:Name="DetailsEmptyText" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               Text="Выберите режим в каталоге"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Настройки: всплывающая панель поверх содержимого ===== -->
        <Grid x:Name="SettingsFlyout" Grid.Row="1" Width="330" Margin="0,-6,12,0"
              HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="20"
              Visibility="{Binding IsChecked, ElementName=SettingsToggle, Converter={StaticResource BoolToVisibility}}">
            <!-- Тень — отдельным слоем, чтобы эффект не размывал текст панели. -->
            <Border CornerRadius="8" Background="{DynamicResource Theme.PanelBackgroundBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.4"/>
                </Border.Effect>
            </Border>
            <Border Padding="16,14,16,16" CornerRadius="8"
                    Background="{DynamicResource Theme.PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource Theme.InteractiveBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Настройки"/>

                    <TextBlock Margin="0,14,0,5" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               Text="Порядок отрисовки тайлов"/>
                    <ComboBox x:Name="RenderPatternSelector" MinHeight="32" SelectedIndex="0"
                              AutomationProperties.Name="Порядок отрисовки тайлов"
                              SelectionChanged="RenderPatternSelector_OnSelectionChanged">
                        <ComboBoxItem Content="Классический (от центра)"/>
                        <ComboBoxItem Content="Построчный"/>
                        <ComboBoxItem Content="Спиральный"/>
                        <ComboBoxItem Content="Случайный"/>
                        <ComboBoxItem Content="Шахматный"/>
                        <ComboBoxItem Content="Диагональный"/>
                        <ComboBoxItem Content="От краев к центру"/>
                        <ComboBoxItem Content="Z-кривая (Мортон)"/>
                    </ComboBox>
                    <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               Text="В каком порядке появляются участки кадра при рендере во всех окнах."/>

                    <TextBlock Margin="0,16,0,5" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               Text="Тема оформления"/>
                    <ComboBox x:Name="ThemeSelector" MinHeight="32"
                              AutomationProperties.Name="Тема оформления"
                              SelectionChanged="ThemeSelector_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Margin="0,8,0,0" Content="Редактор тем…" Click="ThemeEditor_OnClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
