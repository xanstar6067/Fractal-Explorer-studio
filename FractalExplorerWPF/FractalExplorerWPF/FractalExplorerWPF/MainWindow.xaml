<Window x:Class="FractalExplorerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер фракталов - WPF"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Icons/FractalExplorer.ico"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style x:Key="AboutButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="ToolTip" Value="Сведения о приложении"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CatalogSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Перетащите, чтобы изменить ширину каталога"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="GripLine"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Theme.BorderBrush}"
                                    Opacity="0.65"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripLine" Property="Width" Value="3"/>
                                <Setter TargetName="GripLine" Property="Background"
                                        Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                <Setter TargetName="GripLine" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="GripLine" Property="Width" Value="3"/>
                                <Setter TargetName="GripLine" Property="Background"
                                        Value="{DynamicResource Theme.AccentSecondaryBrush}"/>
                                <Setter TargetName="GripLine" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="260"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="12" Padding="10"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="7">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Облачные сохранения…" Margin="0,8,0,0" Click="CloudButton_OnClick"/>
                <TextBlock DockPanel.Dock="Top" Margin="5,3,5,12"
                           FontSize="18" FontWeight="SemiBold"
                           Text="Каталог"/>
                <Button DockPanel.Dock="Bottom"
                        Margin="0,10,0,0"
                        Style="{StaticResource AboutButtonStyle}"
                        Click="AboutButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="20"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="16"
                                   Text="ℹ"/>
                        <TextBlock VerticalAlignment="Center" Text="О программе"/>
                    </StackPanel>
                </Button>

                <Grid DockPanel.Dock="Top" Margin="5,0,5,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox"
                                 TextChanged="SearchBox_OnTextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                   Text="Поиск фракталов..."/>
                    </Grid>

                    <Border Grid.Column="1" VerticalAlignment="Center"
                            Margin="6,0,0,0" Padding="6,3" CornerRadius="4"
                            Background="{DynamicResource Theme.ControlBackgroundAltBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Быстрый переключатель"
                            MouseLeftButtonDown="QuickSwitcherHint_OnMouseLeftButtonDown">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                   Text="Ctrl+K"/>
                    </Border>
                </Grid>

                <Grid>
                    <TreeView x:Name="FractalTree"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="FractalTree_OnSelectedItemChanged"
                              PreviewMouseLeftButtonDown="FractalTree_OnPreviewMouseLeftButtonDown"
                              MouseDoubleClick="FractalTree_OnMouseDoubleClick"/>
                    <TextBlock x:Name="EmptySearchText"
                               Margin="10,20,10,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               Text="Ничего не найдено"
                               Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="0"
                      Width="12"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="CurrentAndNext"
                      Style="{StaticResource CatalogSplitterStyle}"/>

        <Border Grid.Column="1" Margin="0,12,12,12" Padding="20"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FractalName" Margin="0,0,0,16"
                           FontSize="25" FontWeight="SemiBold"
                           Text="Выберите элемент каталога"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource Theme.ControlBackgroundAltBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <Image x:Name="FractalPreview" Margin="6" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,5"
                                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                   Text="Тип рендера:"/>
                        <ComboBox x:Name="RenderPatternSelector" SelectedIndex="0"
                                  SelectionChanged="RenderPatternSelector_OnSelectionChanged">
                            <ComboBoxItem Content="Классический (от центра)"/>
                            <ComboBoxItem Content="Построчный"/>
                            <ComboBoxItem Content="Спиральный"/>
                            <ComboBoxItem Content="Случайный"/>
                            <ComboBoxItem Content="Шахматный"/>
                            <ComboBoxItem Content="Диагональный"/>
                            <ComboBoxItem Content="От краев к центру"/>
                            <ComboBoxItem Content="Z-кривая (Мортон)"/>
                        </ComboBox>

                        <TextBlock Margin="0,18,0,5"
                                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                   Text="Тема оформления приложения:"/>
                        <ComboBox x:Name="ThemeSelector" SelectionChanged="ThemeSelector_OnSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Margin="0,7,0,0" Content="Настроить темы…" Click="ThemeEditor_OnClick"/>

                        <Button x:Name="LaunchButton"
                                Margin="0,14,0,0" Height="44"
                                IsEnabled="False"
                                Content="Запуск недоступен"
                                Click="LaunchButton_OnClick"
                                FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" Margin="0,18,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="FractalDescription"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               FontSize="15" LineHeight="23"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
