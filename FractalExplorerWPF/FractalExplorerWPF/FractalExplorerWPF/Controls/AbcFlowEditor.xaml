<UserControl x:Class="FractalExplorerWPF.Controls.AbcFlowEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:FractalExplorerWPF.Controls"
    Foreground="{DynamicResource Theme.PrimaryTextBrush}">
    <UserControl.Resources><Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Margin" Value="0,7,0,2"/><Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/></Style></UserControl.Resources>
    <StackPanel>
        <TextBlock Text="A" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="ASlider" Minimum="-3" Maximum="3" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=ASlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="B" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="BSlider" Minimum="-3" Maximum="3" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=BSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="C" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="CSlider" Minimum="-3" Maximum="3" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=CSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="Группа начальных точек" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="GroupBox" SelectionChanged="Changed">
            <ComboBoxItem Content="Облако в кубе"/><ComboBoxItem Content="Кольцо в плоскости XY"/>
            <ComboBoxItem Content="Плоскость XY"/><ComboBoxItem Content="Соседние точки вдоль X"/>
        </ComboBox>
        <TextBlock Text="Число траекторий" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="CountSlider" Minimum="1" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=CountSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:0}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="Центр группы · x (рад)" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="XSlider" Minimum="-3.141592653589793" Maximum="3.141592653589793" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=XSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="Центр группы · y (рад)" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="YSlider" Minimum="-3.141592653589793" Maximum="3.141592653589793" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=YSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="Центр группы · z (рад)" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="ZSlider" Minimum="-3.141592653589793" Maximum="3.141592653589793" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=ZSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="Радиус / разброс группы (рад)" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="SpreadSlider" Minimum="0.0001" Maximum="3.141592653589793" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=SpreadSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F4}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="Отсчётов на траекторию" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="SamplesSlider" Minimum="64" Maximum="2048" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=SamplesSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:0}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="Шаг времени" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="StepSlider" Minimum="0.001" Maximum="0.04" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=StepSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="x′ = A sin z + C cos y&#x0a;y′ = B sin x + A cos z&#x0a;z′ = C sin y + B cos x" Margin="0,8,0,4"/>
        <TextBlock Text="Координаты периодичны с периодом 2π. Каждый отсчёт содержит четыре шага RK4. Уменьшите шаг для проверки тонких деталей." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Text="Толщина линий" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="ThicknessSlider" Minimum="0.002" Maximum="0.04" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=ThicknessSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <CheckBox x:Name="TrailsBox" Content="Показать траектории" Checked="Changed" Unchecked="Changed"/>
        <CheckBox x:Name="ParticlesBox" Content="Показать частицы" Checked="Changed" Unchecked="Changed"/>
        <TextBlock Text="Положение частиц во времени" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="PhaseSlider" Minimum="0" Maximum="1" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=PhaseSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="Скорость воспроизведения · единиц времени / с" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="20" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=SpeedSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F1}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock x:Name="TimeText" TextWrapping="Wrap" Margin="0,5,0,3"/>
        <Button x:Name="PlayButton" Content="▶ Движение частиц" Click="PlayClicked"/>
        <Expander Header="Сечение Пуанкаре" IsExpanded="True" Margin="0,10,0,0"><StackPanel>
            <TextBlock Text="Нормаль плоскости" Style="{StaticResource Caption}"/>
            <ComboBox x:Name="AxisBox" SelectionChanged="Changed"><ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/><ComboBoxItem Content="Z"/></ComboBox>
        <TextBlock Text="Положение плоскости (рад)" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="SectionSlider" Minimum="-3.141592653589793" Maximum="3.141592653589793" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=SectionSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
            <CheckBox x:Name="PositiveBox" Content="Только пересечения в положительном направлении" Checked="Changed" Unchecked="Changed"/>
            <CheckBox x:Name="SectionOnlyBox" Content="В 3D показать только точки сечения" Checked="Changed" Unchecked="Changed"/>
            <c:AbcPoincarePlot x:Name="SectionPlot"/>
            <TextBlock x:Name="SectionText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        </StackPanel></Expander>
        <TextBlock Text="Диапазон окраски λ(t): −λ … +λ" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
            <Slider x:Name="RangeSlider" Minimum="0.01" Maximum="2" ValueChanged="Changed" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding ElementName=RangeSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F3}}" c:NumericSpinner.IsEnabled="True"/>
        </Grid>
        <TextBlock Text="λ(t) — конечновременная оценка растяжения малого возмущения. Положительное значение за конечное время само по себе не доказывает хаос. Выберите «По расхождению» в панели окраски." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,5,0,0"/>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
