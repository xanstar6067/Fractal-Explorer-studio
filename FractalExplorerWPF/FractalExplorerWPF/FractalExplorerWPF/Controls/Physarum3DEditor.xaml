<UserControl x:Class="FractalExplorerWPF.Controls.Physarum3DEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FractalExplorerWPF.Controls">
    <UserControl.Resources>
        <ResourceDictionary Source="Fractal3DPanelStyles.xaml"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Агенты чувствуют след, выбирают путь и оставляют новые нити. Сеть непрерывно перестраивается." TextWrapping="Wrap" Margin="0,4,0,8"/>
        <TextBlock x:Name="PhysarumDeviceText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <Expander Header="Поиск интересных форм" IsExpanded="True" Margin="0,8,0,4"><StackPanel>
            <Button x:Name="PhysarumSearchButton" Content="Найти интересную форму" Click="PhysarumSearch_OnClick"/>
            <Button x:Name="PhysarumVariationButton" Content="Вариация текущей" Click="PhysarumVariation_OnClick"/>
            <Button x:Name="PhysarumSearchUndoButton" Content="Вернуть предыдущую сеть" Click="PhysarumSearchUndo_OnClick" IsEnabled="False"/>
            <ProgressBar x:Name="PhysarumSearchProgress" Minimum="0" Maximum="100" Height="4" Margin="0,6,0,6" Visibility="Collapsed"/>
            <TextBlock x:Name="PhysarumSearchStatus" Text="10 быстрых проб и подбор яркости. Вариация меняет параметры рядом с текущими." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        </StackPanel></Expander>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Сетка объёма"/>
        <ComboBox x:Name="PhysarumSizeBox" SelectedIndex="3">
            <ComboBoxItem Content="48³ · быстро"/><ComboBoxItem Content="64³"/><ComboBoxItem Content="96³ · стандарт"/><ComboBoxItem Content="128³ · подробно"/>
        </ComboBox>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Число агентов (1024–262144)"/>
        <TextBox x:Name="PhysarumCountBox" Text="16384" c:NumericSpinner.IsEnabled="True" c:NumericSpinner.IsInteger="True"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Начальное распределение"/>
        <ComboBox x:Name="PhysarumSeedBox" SelectedIndex="0">
            <ComboBoxItem Content="Облако"/><ComboBoxItem Content="Оболочка"/><ComboBoxItem Content="Тор"/><ComboBoxItem Content="Две звезды"/>
        </ComboBox>
        <Expander Header="Чувства и движение" IsExpanded="True"><StackPanel>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Дальность чувств · ячеек (1–16)"/>
            <TextBox x:Name="PhysarumSensorBox" Text="2" c:NumericSpinner.IsEnabled="True"/>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Угол обзора · градусов (5–85)"/>
            <TextBox x:Name="PhysarumAngleBox" Text="40" c:NumericSpinner.IsEnabled="True"/>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Поворот · градусов (1–70)"/>
            <TextBox x:Name="PhysarumTurnBox" Text="22" c:NumericSpinner.IsEnabled="True"/>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Скорость · ячеек за шаг (0,1–2)"/>
            <TextBox x:Name="PhysarumMoveBox" Text="0.8" c:NumericSpinner.IsEnabled="True"/>
        </StackPanel></Expander>
        <Expander Header="Память следа"><StackPanel>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Сила следа (0,1–8)"/>
            <TextBox x:Name="PhysarumDepositBox" Text="2" c:NumericSpinner.IsEnabled="True"/>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Размывание (0–1)"/>
            <TextBox x:Name="PhysarumDiffusionBox" Text="0.12" c:NumericSpinner.IsEnabled="True"/>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Испарение за шаг (0,001–0,2)"/>
            <TextBox x:Name="PhysarumDecayBox" Text="0.025" c:NumericSpinner.IsEnabled="True"/>
        </StackPanel></Expander>
        <Expander Header="Подготовка и воспроизводимость"><StackPanel>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Случайное число"/>
            <TextBox x:Name="PhysarumRandomBox" Text="42" c:NumericSpinner.IsEnabled="True" c:NumericSpinner.IsInteger="True"/>
            <TextBlock Style="{StaticResource FieldCaption}" Text="Шагов подготовки (0–2000)"/>
            <TextBox x:Name="PhysarumWarmupBox" Text="80" c:NumericSpinner.IsEnabled="True" c:NumericSpinner.IsInteger="True"/>
        </StackPanel></Expander>
        <Button Content="Применить и начать заново" Click="PhysarumRestart_OnClick"/>
        <Button Content="Только новая затравка" Click="PhysarumRandom_OnClick"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Шагов на кадр"/>
        <Slider x:Name="PhysarumSpeedSlider" Minimum="1" Maximum="32" Value="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Яркость нитей"/>
        <Slider x:Name="PhysarumExposureSlider" Minimum="0.05" Maximum="4" Value="0.12" ValueChanged="PhysarumView_OnChanged"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Порог видимости"/>
        <Slider x:Name="PhysarumLevelSlider" Minimum="0.01" Maximum="0.9" Value="0.35" ValueChanged="PhysarumView_OnChanged"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Срез объёма"/>
        <ComboBox x:Name="PhysarumCutBox" SelectionChanged="PhysarumView_OnChanged">
            <ComboBoxItem Content="Целый объём"/><ComboBoxItem Content="По X"/><ComboBoxItem Content="По Y"/><ComboBoxItem Content="По Z"/>
        </ComboBox>
        <Slider x:Name="PhysarumCutSlider" Minimum="-1" Maximum="1" Value="0.5" ValueChanged="PhysarumView_OnChanged"/>
        <TextBlock Text="Пробел — пауза/продолжение. Свечение показывает сеть насквозь. Сохранение запоминает след и каждого агента." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
</UserControl>
