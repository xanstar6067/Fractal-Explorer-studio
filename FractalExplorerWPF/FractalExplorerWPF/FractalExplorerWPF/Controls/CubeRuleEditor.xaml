<UserControl x:Class="FractalExplorerWPF.Controls.CubeRuleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Button x:Name="AtlasButton" Content="Атлас правил и поколений…" Click="AtlasClicked" Margin="0,0,0,6"/>
        <TextBlock Text="Правило замены куба" FontWeight="SemiBold" Margin="0,6"/>
        <ComboBox x:Name="RuleBox" SelectionChanged="RuleSelected" ToolTip="Готовое правило меняет геометрию, сохраняя камеру и оформление">
            <ComboBoxItem Content="Губка Менгера · 20 кубиков"/>
            <ComboBoxItem Content="Виксек · 7 кубиков"/>
            <ComboBoxItem Content="Пыль Кантора · 8 кубиков"/>
            <ComboBoxItem Content="Углы и центр · 9 кубиков"/>
            <ComboBoxItem Content="Оболочка · 26 кубиков"/>
            <ComboBoxItem Content="Своё правило" IsEnabled="False"/>
        </ComboBox>
        <TextBlock Text="Три слоя XY: X вправо, Y вверх. Нажмите на клетку, чтобы оставить или убрать кубик." TextWrapping="Wrap" FontSize="11" Margin="0,6" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <UniformGrid x:Name="Layers" Columns="3"/>
        <TextBlock Text="Зеркальные правки по осям" FontSize="11" Margin="0,6,0,2"/>
        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="MirrorXBox" Content="X" Margin="0,0,12,0" ToolTip="Отражать следующие правки относительно X = 0"/>
            <CheckBox x:Name="MirrorYBox" Content="Y" Margin="0,0,12,0" ToolTip="Отражать следующие правки относительно Y = 0"/>
            <CheckBox x:Name="MirrorZBox" Content="Z" ToolTip="Отражать следующие правки относительно Z = 0"/>
        </StackPanel>
        <WrapPanel Margin="0,4,0,0">
            <Button x:Name="RandomButton" Content="Случайное" Click="RandomClicked" Margin="0,2,4,2"/>
            <Button x:Name="UndoButton" Content="Отменить" Click="UndoClicked" Margin="0,2,0,2"/>
        </WrapPanel>
        <WrapPanel>
            <Button x:Name="ClearButton" Content="Убрать всё" Click="ClearClicked" Margin="0,2,4,2"/>
            <Button x:Name="FillButton" Content="Заполнить" Click="FillClicked" Margin="0,2,0,2"/>
        </WrapPanel>
        <Button x:Name="ResetButton" Content="Вернуть правило этого режима" Click="ResetClicked" HorizontalAlignment="Left" Margin="0,4,0,2"/>
        <TextBlock x:Name="RuleStatus" TextWrapping="Wrap" Margin="0,4"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="PreviousLevelButton" Content="− поколение" Click="PreviousLevelClicked" Margin="0,2,4,2"/>
            <Button x:Name="NextLevelButton" Content="+ поколение" Click="NextLevelClicked" Margin="0,2,0,2"/>
        </StackPanel>
        <TextBlock Text="Глубина задаётся полем «Итерации» ниже (для своего правила — до 12 поколений). Случайное правило учитывает отмеченные оси; симметрия не меняет уже расставленные кубики. Толщина элементов действует на классическую форму режима." TextWrapping="Wrap" FontSize="11" Margin="0,6" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
</UserControl>
