<UserControl x:Class="FractalExplorerWPF.Controls.Excitable3DEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FractalExplorerWPF.Controls">
    <UserControl.Resources>
        <ResourceDictionary Source="Fractal3DPanelStyles.xaml"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Модель возбудимой среды"/>
        <ComboBox x:Name="ExModelBox" SelectionChanged="ExModel_OnChanged">
            <ComboBoxItem Content="Баркли"/><ComboBoxItem Content="Oregonator · Белоусов–Жаботинский"/>
            <ComboBoxItem Content="FitzHugh–Nagumo"/><ComboBoxItem Content="Aliev–Panfilov"/>
        </ComboBox>
        <TextBlock x:Name="ExEquationText" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8"/>
        <TextBlock x:Name="ExDeviceText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Сетка по каждой оси (32–128)"/>
        <TextBox x:Name="ExSizeBox" Text="64" c:NumericSpinner.IsEnabled="True" c:NumericSpinner.IsInteger="True"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0">
                <TextBlock x:Name="ExALabel" Style="{StaticResource FieldCaption}" Text="a"/><TextBox x:Name="ExABox" Text="0.75"/>
                <TextBlock Style="{StaticResource FieldCaption}" Text="Диффузия U"/><TextBox x:Name="ExDuBox" Text="1"/>
                <TextBlock Style="{StaticResource FieldCaption}" Text="Шаг времени Δt"/><TextBox x:Name="ExDtBox" Text="0.005"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="ExBLabel" Style="{StaticResource FieldCaption}" Text="b"/><TextBox x:Name="ExBBox" Text="0.06"/>
                <TextBlock Style="{StaticResource FieldCaption}" Text="Диффузия V"/><TextBox x:Name="ExDvBox" Text="0"/>
                <TextBlock Style="{StaticResource FieldCaption}" Text="Шаг сетки Δx"/><TextBox x:Name="ExSpacingBox" Text="0.75"/>
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Разделение времён ε"/><TextBox x:Name="ExEpsilonBox" Text="0.02"/>
        <StackPanel x:Name="ExMuPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldCaption}" Text="Восстановление μ₁ / μ₂"/>
            <TextBox x:Name="ExMu1Box" Text="0.2"/><TextBox x:Name="ExMu2Box" Text="0.3"/>
        </StackPanel>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Границы"/>
        <ComboBox x:Name="ExBoundaryBox"><ComboBoxItem Content="Непроницаемые стенки"/><ComboBoxItem Content="Периодические"/></ComboBox>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Затравка"/>
        <ComboBox x:Name="ExSeedBox">
            <ComboBoxItem Content="Прямой свиток"/><ComboBoxItem Content="Вихревое кольцо"/><ComboBoxItem Content="Перекрещённые свитки"/><ComboBoxItem Content="Сферическая волна"/><ComboBoxItem Content="Покоящаяся среда"/>
        </ComboBox>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Шаги подготовки (0–20 000)"/>
        <TextBox x:Name="ExWarmupBox" Text="1200"/>
        <Button Content="Применить и начать заново" Click="ExRestart_OnClick"/>
        <TextBlock Text="Новый свиток сначала проходит подготовку и встаёт на паузу. Пробел — пауза и продолжение. Модель и уравнение применяются кнопкой." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Шагов на кадр"/>
        <Slider x:Name="ExSpeedSlider" Minimum="1" Maximum="256" Value="16" TickFrequency="1" IsSnapToTickEnabled="True"/>
        <TextBlock Text="{Binding ElementName=ExSpeedSlider, Path=Value, StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Показывать"/>
        <ComboBox x:Name="ExViewBox" SelectionChanged="ExView_OnChanged"><ComboBoxItem Content="Фронты волн"/><ComboBoxItem Content="Вихревые нити"/><ComboBoxItem Content="Волны и нити"/></ComboBox>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Уровень поверхности"/>
        <Slider x:Name="ExThresholdSlider" Minimum="0.05" Maximum="0.95" Value="0.5" ValueChanged="ExView_OnChanged"/>
        <TextBlock Text="{Binding ElementName=ExThresholdSlider, Path=Value, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Срез объёма"/>
        <ComboBox x:Name="ExCutBox" SelectionChanged="ExView_OnChanged">
            <ComboBoxItem Content="Целый объём"/><ComboBoxItem Content="По X"/>
            <ComboBoxItem Content="По Y"/><ComboBoxItem Content="По Z"/>
        </ComboBox>
        <Slider x:Name="ExCutSlider" Minimum="-1" Maximum="1" Value="0" ValueChanged="ExView_OnChanged"/>
        <TextBlock Text="{Binding ElementName=ExCutSlider, Path=Value, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Радиус сферической кисти"/>
        <Slider x:Name="ExBrushSlider" Minimum="0.02" Maximum="0.2" Value="0.08"/>
        <Button x:Name="ExBrushButton" Content="Добавить затравку в центре" Click="ExBrush_OnClick"/>
        <TextBlock Text="Shift + щелчок: сферическая затравка на выбранном срезе. Кисть возбуждает U, сохраняя V. «Плотность» показывает прозрачные волны; окраска «По фазе» различает стадии цикла." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
</UserControl>
