<UserControl x:Class="FractalExplorerWPF.Controls.PercolationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,6">
        <TextBlock Text="Вероятность заполнения p"/>
        <Slider x:Name="ProbabilitySlider" Minimum="0" Maximum="1" SmallChange="0.001"
                LargeChange="0.01" TickFrequency="0.1" TickPlacement="BottomRight"
                ValueChanged="Probability_OnChanged" Margin="0,4"/>
        <UniformGrid Columns="3">
            <Button Content="Ниже pс" Click="Below_OnClick" ToolTip="p = pс − 0,08"/>
            <Button Content="Порог pс" Click="Critical_OnClick"/>
            <Button Content="Выше pс" Click="Above_OnClick" ToolTip="p = pс + 0,08"/>
        </UniformGrid>
        <TextBlock x:Name="ThresholdText" TextWrapping="Wrap" Margin="0,5"/>
        <TextBlock Text="Окраска"/>
        <ComboBox x:Name="ColoringBox" SelectionChanged="Coloring_OnChanged" Margin="0,3,0,6">
            <ComboBoxItem Content="Все кластеры"/>
            <ComboBoxItem Content="Крупнейший кластер"/>
            <ComboBoxItem Content="Сквозные кластеры"/>
            <ComboBoxItem Content="По размеру кластера"/>
        </ComboBox>
        <TextBlock x:Name="StatisticsText" TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
</UserControl>
