<UserControl x:Class="FractalExplorerWPF.Controls.SaveManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:theme="clr-namespace:FractalExplorerWPF.Theming">
    <UserControl.Resources>
        <sys:Double x:Key="RightActionButtonWidth">110</sys:Double>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Список сохранений:"/>
            <CheckBox x:Name="PointsOfInterestCheckBox" Grid.Column="1" Margin="8,0,0,0"
                      VerticalAlignment="Center" Content="Точки интереса"
                      Visibility="Collapsed" Checked="PointsOfInterestCheckBox_OnChanged"
                      Unchecked="PointsOfInterestCheckBox_OnChanged"/>
        </Grid>
        <TextBlock Grid.Column="2" Text="Предпросмотр:"/>

        <!-- Поиск встроен в ячейку списка (col0), не занимает отдельную строку общего грида —
             колонка превью выровнена по строкам ровно как раньше. -->
        <Grid Grid.Row="1" Grid.RowSpan="3" Margin="0,7,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,7">
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="SearchBox_OnTextChanged"/>
                <TextBlock x:Name="SearchPlaceholder" Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                           Text="Поиск…"/>
            </Grid>
            <ListBox x:Name="SavesList" Grid.Row="1"
                     DisplayMemberPath="DisplayName" SelectionChanged="SavesList_OnSelectionChanged"
                     MouseDoubleClick="SavesList_OnMouseDoubleClick"/>
        </Grid>

        <!-- Snapshots keep the aspect ratio of the source canvas. -->
        <Border x:Name="PreviewHost" Grid.Row="1" Grid.Column="2" Margin="0,7,0,0"
                Width="431" Height="288" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Black"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                CornerRadius="4" ClipToBounds="True" theme:ThemeContract.IgnoreAudit="True">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                <TextBlock x:Name="EmptyPreviewText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="16" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Выберите сохранение"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <TextBlock x:Name="DetailsText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" Margin="0,8,0,0"
                   MaxHeight="66" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>

        <Grid Grid.Row="3" Grid.Column="2" Margin="0,8,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,3" Text="Имя сохранения:"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveNameBox" VerticalContentAlignment="Center"/>
                <Button x:Name="SaveButton" Grid.Column="1" Width="{StaticResource RightActionButtonWidth}" Margin="7,0,0,0"
                        Content="Сохранить" Click="SaveButton_OnClick"/>
            </Grid>
        </Grid>

        <!-- Кнопка рендера превью одновременно служит индикатором прогресса: заливка растёт внутри
             самой кнопки, повторный клик во время рендера отменяет его. Так рендер не добавляет
             в окно отдельную строку и не меняет его высоту. -->
        <Button x:Name="RenderPreviewButton" Grid.Row="4" Grid.Column="2" Height="36" Padding="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Margin="0,0,0,8" Click="RenderPreviewButton_OnClick">
            <Border CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Border x:Name="RenderFillBar" HorizontalAlignment="Left" Width="0"
                            Background="{DynamicResource Theme.AccentPrimaryBrush}" Opacity="0.42"/>
                    <TextBlock x:Name="RenderButtonText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="Рендер превью"/>
                </Grid>
            </Border>
        </Button>

        <Grid Grid.Row="5" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Width="90" Content="Удалить" Click="DeleteButton_OnClick"/>
            <Button Grid.Column="1" Content="Облако…" Margin="8,0,0,0" Click="CloudButton_OnClick"/>
        </Grid>

        <Grid Grid.Row="5" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" MinHeight="18" TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
            <Button Grid.Column="1" Width="{StaticResource RightActionButtonWidth}" Margin="0,0,7,0"
                    Content="Закрыть" IsCancel="True" Click="CloseButton_OnClick"/>
            <Button x:Name="LoadButton" Grid.Column="2" Width="{StaticResource RightActionButtonWidth}"
                    Style="{StaticResource Theme.AccentButtonStyle}"
                    Content="Загрузить" IsDefault="True" Click="LoadButton_OnClick"/>
        </Grid>
    </Grid>
</UserControl>
