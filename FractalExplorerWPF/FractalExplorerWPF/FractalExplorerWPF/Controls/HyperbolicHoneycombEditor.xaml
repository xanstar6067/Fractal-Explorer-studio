<UserControl x:Class="FractalExplorerWPF.Controls.HyperbolicHoneycombEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Margin" Value="0,7,0,2"/><Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/></Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Регулярное разбиение {p,q,r}" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="KindBox" SelectedIndex="1" SelectionChanged="Changed">
            <ComboBoxItem Content="{}{4,3,5} · кубы, 5 вокруг ребра"/>
            <ComboBoxItem Content="{}{5,3,4} · додекаэдры, 4 вокруг ребра"/>
            <ComboBoxItem Content="{}{5,3,5} · додекаэдры, 5 вокруг ребра"/>
            <ComboBoxItem Content="{}{3,5,3} · икосаэдры, 3 вокруг ребра"/>
        </ComboBox>
        <TextBlock Text="Шар Пуанкаре: его граница бесконечно далека в гиперболической метрике. Рёбра — дуги геодезических, грани — части сфер, ортогональных границе." TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Text="Глубина · радиальные слои" Style="{StaticResource Caption}"/>
        <Slider x:Name="DepthSlider" Minimum="1" Maximum="6" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Changed"/>
        <TextBlock x:Name="DepthText" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <CheckBox x:Name="EdgesCheck" Content="Геодезические рёбра" IsChecked="True" Checked="Changed" Unchecked="Changed" Margin="0,8,0,0"/>
        <TextBlock Text="Радиус рёбер в H³" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
            <Slider x:Name="EdgeSlider" Minimum="0.012" Maximum="0.2" Value="0.055" Margin="0,0,8,0" ValueChanged="Changed"/>
            <TextBox Grid.Column="1" x:Name="EdgeBox" Text="{Binding ElementName=EdgeSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/>
        </Grid>
        <CheckBox x:Name="FacesCheck" Content="Грани ячеек" Checked="Changed" Unchecked="Changed" Margin="0,8,0,0"/>
        <StackPanel x:Name="FacesPanel">
            <TextBlock Text="Непрозрачность граней · 0 = скрыты, 1 = непрозрачны" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="0.16" Margin="0,0,8,0" ValueChanged="Changed"/>
                <TextBox Grid.Column="1" x:Name="OpacityBox" Text="{Binding ElementName=OpacitySlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/>
            </Grid>
            <TextBlock Text="Толщина граней в H³" Style="{StaticResource Caption}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                <Slider x:Name="ThicknessSlider" Minimum="0.006" Maximum="0.08" Value="0.018" Margin="0,0,8,0" ValueChanged="Changed"/>
                <TextBox Grid.Column="1" x:Name="ThicknessBox" Text="{Binding ElementName=ThicknessSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/>
            </Grid>
        </StackPanel>
        <TextBlock Text="Срез · оставить нижнюю часть" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="CutBox" SelectedIndex="0" SelectionChanged="Changed">
            <ComboBoxItem Content="Без среза"/><ComboBoxItem Content="По X"/><ComboBoxItem Content="По Y"/><ComboBoxItem Content="По Z"/>
        </ComboBox>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
            <Slider x:Name="CutSlider" Minimum="-1" Maximum="1" Value="0" Margin="0,0,8,0" ValueChanged="Changed"/>
            <TextBox Grid.Column="1" x:Name="CutPositionBox" Text="{Binding ElementName=CutSlider,Path=Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/>
        </Grid>
        <TextBlock Text="Перемещение в гиперболическом пространстве" Style="{StaticResource Caption}"/>
        <TextBlock Text="Кнопки перемещают начало координат изометрией на 0,3 в H³. Камера вращается обычным способом. Для вида изнутри выберите соответствующий готовый вид." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <UniformGrid Columns="3" Margin="0,5,0,0">
            <Button Content="X −" Tag="X-" Click="MoveClick"/><Button Content="Y −" Tag="Y-" Click="MoveClick"/><Button Content="Z −" Tag="Z-" Click="MoveClick"/>
            <Button Content="X +" Tag="X+" Click="MoveClick"/><Button Content="Y +" Tag="Y+" Click="MoveClick"/><Button Content="Z +" Tag="Z+" Click="MoveClick"/>
        </UniformGrid>
        <TextBlock Text="Положение наблюдателя в исходном шаре (|a| ≤ 0,85)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        <UniformGrid Columns="3">
            <StackPanel><TextBlock Text="X"/><TextBox x:Name="ObserverXBox" Text="0" numeric:NumericSpinner.IsEnabled="True"/></StackPanel>
            <StackPanel><TextBlock Text="Y"/><TextBox x:Name="ObserverYBox" Text="0" numeric:NumericSpinner.IsEnabled="True"/></StackPanel>
            <StackPanel><TextBlock Text="Z"/><TextBox x:Name="ObserverZBox" Text="0" numeric:NumericSpinner.IsEnabled="True"/></StackPanel>
        </UniformGrid>
        <UniformGrid Columns="2"><Button Content="Применить положение" Click="ApplyPosition"/><Button Content="В центр" Click="ResetPosition"/></UniformGrid>
        <TextBlock x:Name="PositionStatus" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
</UserControl>
