<UserControl x:Class="FractalExplorerWPF.Controls.Phoenix3DExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FractalExplorerWPF.Controls">
    <StackPanel Margin="0,8,0,0">
        <Button x:Name="AtlasButton" Content="Атлас C₁ / C₂…" Click="Atlas_OnClick"/>
        <TextBlock Text="Вариации рядом с текущей формой" Margin="0,8,0,3" TextWrapping="Wrap"/>
        <ComboBox x:Name="TargetBox" SelectedIndex="0">
            <ComboBoxItem Content="Менять C₁ и C₂"/>
            <ComboBoxItem Content="Менять только C₁"/>
            <ComboBoxItem Content="Менять только C₂"/>
        </ComboBox>
        <TextBlock Text="Максимальное изменение компоненты" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBox x:Name="RadiusBox" Text="0.04" controls:NumericSpinner.IsEnabled="True"/>
        <Button x:Name="VariationButton" Content="Вариация текущей формы" Click="Variation_OnClick" Margin="0,5,0,0"/>
        <Button x:Name="UndoButton" Content="Вернуть константы" Click="Undo_OnClick" IsEnabled="False" Margin="0,5,0,0"/>
        <TextBlock Text="Вариация может дать пустую форму. Возврат отменяет выбор в атласе или вариацию; хранится до 32 изменений. Камера и окраска сохраняются."
                   FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
</UserControl>
