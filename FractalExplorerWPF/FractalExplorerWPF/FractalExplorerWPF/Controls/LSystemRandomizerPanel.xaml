<UserControl x:Class="FractalExplorerWPF.Controls.LSystemRandomizerPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FractalExplorerWPF.Controls">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Выберите устройство формы, затем создайте новую или измените текущую. Результат сразу виден в исследователе." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Устройство формы" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ListBox x:Name="FamilyBox" SelectedIndex="0" HorizontalContentAlignment="Stretch" SelectionChanged="Family_OnChanged">
      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBoxItem Content="♧ Растения"/><ListBoxItem Content="✳ Радиальные"/>
      <ListBoxItem Content="〰 Кривые"/><ListBoxItem Content="⌘ Геометрия"/>
     </ListBox>
     <StackPanel x:Name="CurveSettings" Margin="0,8,0,0" Visibility="Collapsed">
      <TextBlock Text="Тип кривой"/>
      <ComboBox x:Name="CurveBox" SelectedIndex="0" Margin="0,4">
       <ComboBoxItem Content="Случайный тип"/><ComboBoxItem Content="Складчатая кривая"/>
       <ComboBoxItem Content="Дракон"/><ComboBoxItem Content="Гильберт"/>
       <ComboBoxItem Content="Меандр"/><ComboBoxItem Content="Спираль"/>
      </ComboBox>
     </StackPanel>
     <StackPanel x:Name="BranchSettings">
      <TextBlock Text="{Binding ElementName=BranchSlider, Path=Value, StringFormat=Ветвистость · {0:0}}" Margin="0,10,0,0"/>
      <Slider x:Name="BranchSlider" Minimum="2" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
     </StackPanel>
     <TextBlock Text="{Binding ElementName=ComplexitySlider, Path=Value, StringFormat=Сложность правил · {0:0} / 4}" Margin="0,8,0,0"/>
     <Slider x:Name="ComplexitySlider" Minimum="1" Maximum="4" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
     <TextBlock Text="Больше → дополнительные мотивы, чередующиеся правила и вложенные ветви. Для кривых — дополнительные изгибы рисующего мотива." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
     <TextBlock Text="{Binding ElementName=StemSlider, Path=Value, StringFormat=Длина участков · до {0:0} шагов}" Margin="0,8,0,0"/>
     <Slider x:Name="StemSlider" Minimum="1" Maximum="4" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
     <TextBlock Text="{Binding ElementName=DetailSlider, Path=Value, StringFormat=Детализация · {0:0} / 5}" Margin="0,8,0,0"/>
     <Slider x:Name="DetailSlider" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
     <CheckBox x:Name="RegularBox" IsChecked="True" Content="Регулярное строение" Margin="0,8" ToolTip="Повторяющиеся мотивы и парные повороты; без флажка ветви и направления свободнее"/>
     <TextBlock Text="{Binding ElementName=VariationSlider, Path=Value, StringFormat=Сила вариации · {0:0} %}" Margin="0,6,0,0"/>
     <Slider x:Name="VariationSlider" Minimum="0" Maximum="100" Value="40" TickFrequency="5"/>
     <TextBlock Text="Вариация текущей меняет её правила и углы. Тип, сложность и длина участков задают новую форму." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="Повороты и пропорции" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Диапазон угла поворота, °"/>
     <UniformGrid Columns="2" Margin="0,4,0,8">
      <StackPanel Margin="0,0,4,0"><TextBlock Text="От" FontSize="11"/><TextBox x:Name="AngleMinBox" Text="15" local:NumericSpinner.IsEnabled="True"/></StackPanel>
      <StackPanel Margin="4,0,0,0"><TextBlock Text="До" FontSize="11"/><TextBox x:Name="AngleMaxBox" Text="90" local:NumericSpinner.IsEnabled="True"/></StackPanel>
     </UniformGrid>
     <StackPanel x:Name="SpatialSettings" Visibility="Collapsed">
      <TextBlock Text="Диапазон наклона, °"/>
      <UniformGrid Columns="2" Margin="0,4,0,8">
       <TextBox x:Name="PitchMinBox" Text="20" Margin="0,0,4,0" local:NumericSpinner.IsEnabled="True"/>
       <TextBox x:Name="PitchMaxBox" Text="100" Margin="4,0,0,0" local:NumericSpinner.IsEnabled="True"/>
      </UniformGrid>
      <TextBlock Text="Диапазон закрутки, °"/>
      <UniformGrid Columns="2" Margin="0,4,0,8">
       <TextBox x:Name="RollMinBox" Text="10" Margin="0,0,4,0" local:NumericSpinner.IsEnabled="True"/>
       <TextBox x:Name="RollMaxBox" Text="160" Margin="4,0,0,0" local:NumericSpinner.IsEnabled="True"/>
      </UniformGrid>
      <TextBlock Text="{Binding ElementName=RadiusSlider, Path=Value, StringFormat=Радиус трубки · {0:0.00}}"/>
      <Slider x:Name="RadiusSlider" Minimum="0.01" Maximum="0.5" Value="0.12" SmallChange="0.01"/>
      <TextBlock Text="{Binding ElementName=TaperSlider, Path=Value, StringFormat=Толщина дочерней ветви · {0:0} %}" Margin="0,6,0,0"/>
      <Slider x:Name="TaperSlider" Minimum="30" Maximum="100" Value="72"/>
      <TextBlock Text="{Binding ElementName=StepSlider, Path=Value, StringFormat=Длина дочерней ветви · {0:0} %}" Margin="0,6,0,0"/>
      <Slider x:Name="StepSlider" Minimum="30" Maximum="100" Value="80"/>
     </StackPanel>
     <TextBlock Text="Углы от 1° до 180°. Радиальные формы используют равномерный шаг лучей. У классических кривых генератор выбирает характерный угол внутри заданного диапазона; у свободных форм — случайный." TextWrapping="Wrap" FontSize="11" Margin="0,4,0,12" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
     <TextBlock Text="Повторить результат" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <CheckBox x:Name="FreshSeedBox" Content="Каждый раз новое случайное число" IsChecked="True"/>
     <TextBlock Text="Случайное число" Margin="0,8,0,4"/>
     <TextBox x:Name="SeedBox" Text="42" local:NumericSpinner.IsEnabled="True" local:NumericSpinner.IsInteger="True"/>
     <TextBlock Text="Одинаковые настройки и число дают одинаковую новую форму. Для повторения вариации нужна также та же исходная форма. Слишком сложные формы автоматически строятся с меньшей глубиной." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <UniformGrid Columns="4">
    <Button x:Name="NewButton" Content="✦ Новая форма" Click="New_OnClick" Margin="0,0,4,0" MinHeight="36"/>
    <Button x:Name="NearbyButton" Content="Вариация текущей" Click="Nearby_OnClick" Margin="4,0" MinHeight="36"/>
    <Button x:Name="UndoButton" Content="↶ Вернуть форму" Click="Undo_OnClick" IsEnabled="False" Margin="4,0" MinHeight="36"/>
    <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_OnClick" IsEnabled="False" Margin="4,0,0,0" MinHeight="36"/>
   </UniformGrid>
   <TextBlock x:Name="ResultText" Text="Результат применяется сразу. Предыдущую форму можно вернуть." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,8,0,0" MinHeight="36"/>
  </StackPanel>
 </Grid>
</UserControl>
