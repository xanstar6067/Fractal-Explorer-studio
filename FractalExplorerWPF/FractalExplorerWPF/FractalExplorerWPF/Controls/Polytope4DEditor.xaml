<UserControl x:Class="FractalExplorerWPF.Controls.Polytope4DEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
 <ResourceDictionary Source="/FractalExplorerWPF;component/Controls/Fractal3DPanelStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel>
 <TextBlock Text="МНОГОГРАННИКИ · 4D" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
 <ComboBox x:Name="BodyBox" SelectionChanged="Changed"/>
 <Button x:Name="DualButton" Content="Двойственный тип ↔" Click="DualClicked" Margin="0,5,0,0" ToolTip="Тессеракт ↔ 16-ячейник; 120 ↔ 600. Симплекс и 24-ячейник самодвойственны."/>
 <TextBlock x:Name="BodyInfo" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,6,0,8"/>
 <TextBlock Text="Способ исследования" Style="{StaticResource FieldCaption}"/>
 <ComboBox x:Name="ViewBox" SelectionChanged="Changed"/>
 <StackPanel x:Name="ProjectionPanel">
 <CheckBox x:Name="PerspectiveBox" Content="Перспектива из 4D" IsChecked="True" Click="Changed" Margin="0,8,0,0"/>
<TextBlock Text="Расстояние 4D-наблюдателя" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="EyeSlider" Minimum="1.25" Maximum="6" Value="2.5" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="EyeBox" Grid.Column="1" Text="{Binding ElementName=EyeSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid></StackPanel>
 <StackPanel x:Name="SectionPanel">
<TextBlock Text="Положение гиперплоскости · w = t" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="OffsetSlider" Minimum="-1.05" Maximum="1.05" Value="0" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="OffsetBox" Grid.Column="1" Text="{Binding ElementName=OffsetSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid>
 <Button Content="В центр многогранника" Click="CenterClicked" Margin="0,5,0,5"/>
 <WrapPanel>
 <CheckBox x:Name="FacesBox" Content="Грани" IsChecked="True" Click="Changed" Margin="0,0,12,0"/>
 <CheckBox x:Name="EdgesBox" Content="Рёбра" IsChecked="True" Click="Changed" Margin="0,0,12,0"/>
 </WrapPanel></StackPanel>
 <CheckBox x:Name="VerticesBox" Content="Показывать вершины" Click="Changed" Margin="0,8,0,0"/>
<TextBlock Text="Толщина каркаса" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="ThicknessSlider" Minimum="0.003" Maximum="0.04" Value="0.012" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="ThicknessBox" Grid.Column="1" Text="{Binding ElementName=ThicknessSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid>
 <Expander Header="Вращения в 4D · градусы" IsExpanded="True" Margin="0,8,0,0"><StackPanel>
 <TextBlock Text="XY → XZ → XW → YZ → YW → ZW. Вращения применяются к телу до построения сечения. Камера мышью вращает уже трёхмерный результат."
 TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
<TextBlock Text="XY" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="XYSlider" Minimum="-180" Maximum="180" Value="0" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="XYBox" Grid.Column="1" Text="{Binding ElementName=XYSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid><TextBlock Text="XZ" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="XZSlider" Minimum="-180" Maximum="180" Value="0" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="XZBox" Grid.Column="1" Text="{Binding ElementName=XZSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid><TextBlock Text="XW" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="XWSlider" Minimum="-180" Maximum="180" Value="22" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="XWBox" Grid.Column="1" Text="{Binding ElementName=XWSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid><TextBlock Text="YZ" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="YZSlider" Minimum="-180" Maximum="180" Value="0" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="YZBox" Grid.Column="1" Text="{Binding ElementName=YZSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid><TextBlock Text="YW" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="YWSlider" Minimum="-180" Maximum="180" Value="15" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="YWBox" Grid.Column="1" Text="{Binding ElementName=YWSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid><TextBlock Text="ZW" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="ZWSlider" Minimum="-180" Maximum="180" Value="0" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="ZWBox" Grid.Column="1" Text="{Binding ElementName=ZWSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid>
 <Button Content="Сбросить шесть углов" Click="ResetClicked" Margin="0,5,0,0"/>
 </StackPanel></Expander>
 <Expander Header="Анимация" IsExpanded="True" Margin="0,8,0,0"><StackPanel>
 <ComboBox x:Name="AnimationBox" SelectionChanged="Changed"/>
<TextBlock Text="Скорость вращения · °/с (срез: % радиуса/с)" Style="{StaticResource FieldCaption}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
 <Slider x:Name="SpeedSlider" Minimum="-60" Maximum="60" Value="18" Margin="0,0,8,0" ValueChanged="Changed"/>
 <TextBox x:Name="SpeedBox" Grid.Column="1" Text="{Binding ElementName=SpeedSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/></Grid>
 <Button x:Name="PlayButton" Content="▶ Запустить" Click="PlayClicked" Margin="0,6,0,0"/>
 </StackPanel></Expander>
 <TextBlock x:Name="SectionInfo" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
 <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
 <Expander Header="Как исследовать" Margin="0,8,0,0"><TextBlock TextWrapping="Wrap"
 Text="Проекция показывает все рёбра тела, включая внутренние в изображении. Сечение — пересечение тела с w = t; его грани получаются из трёхмерных ячеек 4D-тела.&#10;&#10;Для начала выберите тессеракт, сбросьте углы и включите сечение: получится куб. Вращайте XW, YW и ZW, чтобы изменить форму среза; двигайте t, чтобы пройти сквозь тело. За пределами тела сечение пусто.&#10;&#10;В совмещённом виде тонкий каркас даёт контекст. Перспектива влияет на него, но не искажает сечение. Все тела имеют описанный радиус 1. Готовые примеры доступны в менеджере сохранений."/>
 </Expander></StackPanel></UserControl>