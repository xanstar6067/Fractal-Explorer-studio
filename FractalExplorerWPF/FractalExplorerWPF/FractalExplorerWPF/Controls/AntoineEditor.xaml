<UserControl x:Class="FractalExplorerWPF.Controls.AntoineEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FractalExplorerWPF;component/Controls/Fractal3DPanelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Button x:Name="AtlasButton" Content="Атлас параметров ожерелья…" Click="Atlas_OnClick" Margin="0,0,0,8"/>
        <TextBlock Text="Звеньев в каждой цепочке (24–48)" Style="{StaticResource FieldCaption}"/>
        <ComboBox x:Name="LinksBox" SelectionChanged="Changed"/>
        <TextBlock Text="Масштаб звеньев (1,35–1,5)" Style="{StaticResource FieldCaption}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
            <Slider x:Name="ScaleSlider" Minimum="1.35" Maximum="1.5" Value="1.4" Margin="0,0,8,0" ValueChanged="Changed"/>
            <TextBox x:Name="ScaleBox" Grid.Column="1" Text="{Binding ElementName=ScaleSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/>
        </Grid>
        <TextBlock Text="Толщина звеньев (0–1)" Style="{StaticResource FieldCaption}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
            <Slider x:Name="ThicknessSlider" Minimum="0" Maximum="1" Value="0.65" Margin="0,0,8,0" ValueChanged="Changed"/>
            <TextBox x:Name="ThicknessBox" Grid.Column="1" Text="{Binding ElementName=ThicknessSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/>
        </Grid>
        <TextBlock Text="Наклон соседних звеньев (60–90°)" Style="{StaticResource FieldCaption}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
            <Slider x:Name="TiltSlider" Minimum="60" Maximum="90" Value="90" Margin="0,0,8,0" ValueChanged="Changed"/>
            <TextBox x:Name="TiltBox" Grid.Column="1" Text="{Binding ElementName=TiltSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     numeric:NumericSpinner.IsEnabled="True" TextChanged="Changed"/>
        </Grid>
        <TextBlock Text="Толщина выбирается внутри допустимого диапазона: звенья сцеплены, их поверхности не пересекаются, а дочерняя цепочка помещается внутри родительского тора."
                   TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,6,0,0"/>
        <TextBlock Text="0 — исходный тор; каждое следующее поколение заменяет все кольца цепочками меньших колец. Для мелких деталей приблизьте отдельное звено."
                   TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,6,0,0"/>
        <TextBlock x:Name="GeometryStatus" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
