<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Controls.QuantumOrbitalEditor">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FractalExplorerWPF;component/Controls/Fractal3DPanelStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <StackPanel>
        <TextBlock Text="ψ = Rₙₗ(r) · Yₗₘ(θ, φ)" FontSize="17" Margin="0,0,0,6"/>
        <TextBlock Text="Одноэлектронный атом водорода. Облако показывает |ψ|², цвет — фазу волны. Это распределение вероятности, а не траектория электрона." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Text="Базис орбиталей" Style="{StaticResource FieldCaption}"/>
        <ComboBox x:Name="BasisBox" SelectionChanged="OnChanged"><ComboBoxItem Content="Вещественный · привычные лепестки"/><ComboBoxItem Content="Комплексный · фаза вокруг оси Z"/></ComboBox>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,5,0"><TextBlock Text="n · 1–8"/><TextBox x:Name="NBox" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,5,0"><TextBlock Text="l · 0…n−1"/><TextBox x:Name="LBox" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="m · −l…l"/><TextBox x:Name="MBox" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/></StackPanel>
        </Grid>
        <CheckBox x:Name="SuperpositionBox" Content="Смешать две орбитали" Margin="0,10,0,4" Checked="OnChanged" Unchecked="OnChanged"/>
        <StackPanel x:Name="SecondPanel">
            <TextBlock Text="Второе состояние" Style="{StaticResource FieldCaption}"/>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,5,0"><TextBlock Text="n · 1–8"/><TextBox x:Name="N2Box" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,5,0"><TextBlock Text="l · 0…n−1"/><TextBox x:Name="L2Box" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="m · −l…l"/><TextBox x:Name="M2Box" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/></StackPanel>
        </Grid>
        <TextBlock Text="Доля второго состояния · 0–1" Style="{StaticResource FieldCaption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
            <Slider x:Name="MixSlider" Minimum="0" Maximum="1" SmallChange="0.01" Margin="0,0,8,0" ValueChanged="OnChanged"/>
            <TextBox Grid.Column="1" x:Name="MixBox" Text="{Binding ElementName=MixSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/>
        </Grid>
        <TextBlock Text="Относительная фаза · градусы" Style="{StaticResource FieldCaption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
            <Slider x:Name="PhaseSlider" Minimum="-180" Maximum="180" SmallChange="5" Margin="0,0,8,0" ValueChanged="OnChanged"/>
            <TextBox Grid.Column="1" x:Name="PhaseBox" Text="{Binding ElementName=PhaseSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/>
        </Grid>
        <TextBlock Text="ψ = √(1−доля) · ψ₁ + √доли · eⁱᶠ · ψ₂. Меняйте фазу, чтобы исследовать интерференцию. В вещественном базисе m &gt; 0 задаёт cos(mφ), m &lt; 0 — sin(|m|φ)." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        </StackPanel>
        <TextBlock Text="Полуразмер области · a₀" Style="{StaticResource FieldCaption}"/>
        <TextBox x:Name="ExtentBox" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/>
        <Button Content="Подобрать область по n" Click="FitClicked"/>
        <TextBlock Text="Разрешение поля" Style="{StaticResource FieldCaption}"/>
        <ComboBox x:Name="SizeBox" SelectionChanged="OnChanged"><ComboBoxItem Content="64³ · быстро"/><ComboBoxItem Content="96³"/><ComboBoxItem Content="128³ · обычное"/><ComboBoxItem Content="192³ · детали"/></ComboBox>
        <TextBlock Text="Уровень изоповерхности · относительная плотность" Style="{StaticResource FieldCaption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
            <Slider x:Name="LevelSlider" Minimum="0.000001" Maximum="0.8" SmallChange="0.005" Margin="0,0,8,0" ValueChanged="OnChanged"/>
            <TextBox Grid.Column="1" x:Name="LevelBox" Text="{Binding ElementName=LevelSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/>
        </Grid>
        <TextBlock Text="Уровень — доля оценённого пика плотности, а не процент вероятности. Для облака выберите стиль «Плотность» в разделе освещения; другие стили показывают изоповерхность." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Text="Срез · оставить нижнюю часть" Style="{StaticResource FieldCaption}"/>
        <ComboBox x:Name="CutBox" SelectionChanged="OnChanged"><ComboBoxItem Content="Без среза"/><ComboBoxItem Content="По X"/><ComboBoxItem Content="По Y"/><ComboBoxItem Content="По Z"/></ComboBox>
        <TextBlock Text="Положение среза · доля области" Style="{StaticResource FieldCaption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
            <Slider x:Name="CutPositionSlider" Minimum="-1" Maximum="1" SmallChange="0.01" Margin="0,0,8,0" ValueChanged="OnChanged"/>
            <TextBox Grid.Column="1" x:Name="CutPositionBox" Text="{Binding ElementName=CutPositionSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" controls:NumericSpinner.IsEnabled="True" TextChanged="OnChanged"/>
        </Grid>
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
</UserControl>
