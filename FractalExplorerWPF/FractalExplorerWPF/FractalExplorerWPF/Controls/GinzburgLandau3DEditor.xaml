<UserControl x:Class="FractalExplorerWPF.Controls.GinzburgLandau3DEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FractalExplorerWPF.Controls">
    <UserControl.Resources><ResourceDictionary Source="Fractal3DPanelStyles.xaml"/></UserControl.Resources>
    <StackPanel>
        <TextBlock Text="∂ₜA = A + (1+i c₁)∇²A − (1+i c₃)|A|²A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock x:Name="GlDeviceText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Сетка по каждой оси (32–128)"/>
        <TextBox x:Name="GlSizeBox" Text="64" c:NumericSpinner.IsEnabled="True" c:NumericSpinner.IsInteger="True"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0">
                <TextBlock Style="{StaticResource FieldCaption}" Text="Дисперсия c₁ (−3…3)"/><TextBox x:Name="GlC1Box" Text="0.5"/>
                <TextBlock Style="{StaticResource FieldCaption}" Text="Шаг времени Δt"/><TextBox x:Name="GlDtBox" Text="0.02"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource FieldCaption}" Text="Нелинейная частота c₃"/><TextBox x:Name="GlC3Box" Text="1"/>
                <TextBlock Style="{StaticResource FieldCaption}" Text="Шаг сетки Δx"/><TextBox x:Name="GlSpacingBox" Text="1"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Допустимый шаг: Δt·(1+c₁²)/Δx² ≤ 0,15. Размер области равен N·Δx." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Границы"/>
        <ComboBox x:Name="GlBoundaryBox"><ComboBoxItem Content="Непроницаемые стенки"/><ComboBoxItem Content="Периодические"/></ComboBox>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Начальное поле"/>
        <ComboBox x:Name="GlSeedBox">
            <ComboBoxItem Content="Вихревое кольцо"/><ComboBoxItem Content="Прямая вихревая нить"/>
            <ComboBoxItem Content="Пара противоположных вихрей"/><ComboBoxItem Content="Беспорядочное поле"/>
            <ComboBoxItem Content="Фазовая волна"/><ComboBoxItem Content="Однородное поле"/>
        </ComboBox>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Начальное число случайного поля"/><TextBox x:Name="GlSeedNumberBox" Text="712"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Шаги подготовки (0–10 000)"/><TextBox x:Name="GlWarmupBox" Text="400"/>
        <Button Content="Применить и начать заново" Click="GlRestart_OnClick"/>
        <TextBlock Text="После подготовки поле встаёт на паузу. Пробел — продолжить или остановить. Параметры уравнения применяются кнопкой." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Шагов на кадр"/>
        <Slider x:Name="GlSpeedSlider" Minimum="1" Maximum="128" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"/>
        <TextBlock Text="{Binding ElementName=GlSpeedSlider, Path=Value, StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Показывать"/>
        <ComboBox x:Name="GlViewBox" SelectionChanged="GlView_OnChanged">
            <ComboBoxItem Content="Вихревые нити · оборот фазы"/><ComboBoxItem Content="Дефекты амплитуды · 1−|A|"/><ComboBoxItem Content="Амплитуда |A|"/>
        </ComboBox>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Уровень поверхности"/>
        <Slider x:Name="GlThresholdSlider" Minimum="0.02" Maximum="0.95" Value="0.15" ValueChanged="GlView_OnChanged"/>
        <TextBlock Text="{Binding ElementName=GlThresholdSlider, Path=Value, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Срез объёма"/>
        <ComboBox x:Name="GlCutBox" SelectionChanged="GlView_OnChanged">
            <ComboBoxItem Content="Целый объём"/><ComboBoxItem Content="По X"/><ComboBoxItem Content="По Y"/><ComboBoxItem Content="По Z"/>
        </ComboBox>
        <Slider x:Name="GlCutSlider" Minimum="-1" Maximum="1" Value="0" ValueChanged="GlView_OnChanged"/>
        <TextBlock Text="{Binding ElementName=GlCutSlider, Path=Value, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
        <TextBlock Style="{StaticResource FieldCaption}" Text="Сферическая кисть"/>
        <ComboBox x:Name="GlBrushBox" SelectedIndex="0"><ComboBoxItem Content="Погасить амплитуду"/><ComboBoxItem Content="Сдвинуть фазу на π"/></ComboBox>
        <Slider x:Name="GlBrushSlider" Minimum="0.02" Maximum="0.2" Value="0.08"/>
        <Button x:Name="GlBrushButton" Content="Кисть в центре" Click="GlBrush_OnClick"/>
        <TextBlock Text="Shift + щелчок: кисть на выбранном срезе. Окраска «По фазе» показывает угол комплексного поля. Малая амплитуда сама по себе не означает вихрь." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
    </StackPanel>
</UserControl>
