<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.DlaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="DLA — диффузионно-ограниченная агрегация" Width="1140" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="310"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Параметры DLA"/>
                <TextBlock Margin="0,9,0,3" Text="Готовый режим"/>
                <ComboBox x:Name="PresetBox" SelectionChanged="Preset_OnChanged"/>
                <TextBlock Margin="0,7,0,3" Text="Начальная затравка"/>
                <ComboBox x:Name="SeedModeBox" SelectionChanged="Parameter_OnChanged"><ComboBoxItem Content="Точка в центре"/><ComboBoxItem Content="Линия снизу"/><ComboBoxItem Content="Точка снизу"/></ComboBox>
                <TextBlock Margin="0,7,0,3" Text="Раскраска"/>
                <ComboBox x:Name="ColoringBox" SelectionChanged="Parameter_OnChanged"><ComboBoxItem Content="По времени роста"/><ComboBoxItem Content="По глубине ветвей"/><ComboBoxItem Content="По расстоянию от затравки"/></ComboBox>
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Частицы"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="ParticlesBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Размер сетки"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" numeric:NumericSpinner.IntegerStep="2" x:Name="GridSizeBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Шагов блуждания"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="MaxStepsBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Прилипание (0–1)"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="StickinessBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Дрейф X"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DriftXBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Дрейф Y"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DriftYBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Seed генератора"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="RandomSeedBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Радиус частицы"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ParticleRadiusBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                <Separator Margin="0,8"/>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Центр X"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CenterXBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Центр Y"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CenterYBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Ширина вида"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ViewWidthBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Начальный цвет" Click="StartColor_OnClick"/><Border x:Name="StartColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="StartColor_OnClick"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Конечный цвет" Click="EndColor_OnClick"/><Border x:Name="EndColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="EndColor_OnClick"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Цвет фона" Click="BackgroundColor_OnClick"/><Border x:Name="BackgroundColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="BackgroundColor_OnClick"/></Grid>
                <Button Content="Сбросить вид" Click="ResetView_OnClick"/>
                <Button Content="Начать новый рост" Click="Render_OnClick"/>
                <Button x:Name="CancelButton" Content="Остановить" IsEnabled="False" Click="Cancel_OnClick"/>
                <Button Content="Менеджер сохранений" Click="Saves_OnClick"/>
                <Button Content="Сохранить изображение" Click="Export_OnClick"/>
                <TextBlock x:Name="ProgressText" Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Ожидание"/>
                <ProgressBar x:Name="ProgressBar" Height="20" Maximum="100"/>
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Готово"/>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.DisabledTextBrush}" Text="Кластер проявляется в реальном времени. Колесо: масштаб. ЛКМ: перемещение. Положительный Drift Y направляет частицы вниз."/>
            </StackPanel></ScrollViewer>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" ClipToBounds="True" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid><Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="StableImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/><Image x:Name="CurrentImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/></Grid><Border x:Name="GrowthBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000" Visibility="Collapsed"><TextBlock x:Name="GrowthBadgeText" Foreground="White"/></Border></Grid>
        </Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
