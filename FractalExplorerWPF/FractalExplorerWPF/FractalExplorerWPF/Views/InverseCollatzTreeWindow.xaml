<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.InverseCollatzTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Обратное дерево Коллатца" Width="1180" Height="760"
        MinWidth="920" MinHeight="580" WindowStartupLocation="CenterOwner"
        KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6,3"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4,0,4"/></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ControlsColumn" Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Обратное дерево Коллатца"/>
                    <TextBlock Margin="0,5,0,10" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="Точное дерево BigInteger: m → 2m и, при m ≡ 4 (mod 6), m → (m−1)/3."/>

                    <TextBlock Text="Максимальная глубина"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="DepthBox" TextChanged="TreeParameter_OnChanged"/>
                    <TextBlock Text="Лимит узлов"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="MaxNodesBox" TextChanged="TreeParameter_OnChanged"/>
                    <TextBlock Text="Раскладка"/>
                    <ComboBox x:Name="LayoutBox" SelectionChanged="RenderParameter_OnChanged">
                        <ComboBoxItem Content="Радиальная"/>
                        <ComboBoxItem Content="Древовидная сверху вниз"/>
                    </ComboBox>

                    <TextBlock Text="Фильтр по модулю"/>
                    <ComboBox x:Name="ModulusBox" SelectionChanged="ModulusBox_OnSelectionChanged">
                        <ComboBoxItem Content="Выкл." Tag="0"/>
                        <ComboBoxItem Content="mod 3" Tag="3"/>
                        <ComboBoxItem Content="mod 6" Tag="6"/>
                        <ComboBoxItem Content="mod 12" Tag="12"/>
                    </ComboBox>
                    <StackPanel x:Name="ResiduePanel">
                        <TextBlock Text="Остаток"/>
                        <ComboBox x:Name="ResidueBox" SelectionChanged="RenderParameter_OnChanged"/>
                        <TextBlock Text="Поведение фильтра"/>
                        <ComboBox x:Name="FilterBehaviorBox" SelectionChanged="RenderParameter_OnChanged">
                            <ComboBoxItem Content="Подсветить совпадения"/>
                            <ComboBoxItem Content="Показывать только совпадения"/>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="Радиус узла"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="NodeRadiusBox" TextChanged="RenderParameter_OnChanged"/>
                    <TextBlock Text="Толщина линий"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="LineThicknessBox" TextChanged="RenderParameter_OnChanged"/>
                    <TextBlock Text="Сглаживание предпросмотра"/>
                    <ComboBox x:Name="SsaaBox" SelectionChanged="RenderParameter_OnChanged">
                        <ComboBoxItem Content="Выкл. (1×)" Tag="1"/>
                        <ComboBoxItem Content="Низкое (2×)" Tag="2"/>
                    </ComboBox>

                    <TextBlock Text="Интервал роста, мс"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="AnimationIntervalBox" TextChanged="AnimationIntervalBox_OnChanged"/>
                    <UniformGrid Columns="2">
                        <Button x:Name="AnimationButton" Margin="0,4,3,4" Content="Запустить рост"
                                Click="AnimationButton_OnClick"/>
                        <Button Margin="3,4,0,4" Content="Сначала" Click="RestartAnimationButton_OnClick"/>
                    </UniformGrid>

                    <TextBlock Margin="0,5,0,3" Text="Цвет фона"/>
                    <controls:ColorSelectorControl x:Name="BackgroundColorSelector"
                                                   SelectedColorChanged="RenderParameter_OnChanged"/>
                    <Button Content="Настроить палитру глубины" Click="PaletteButton_OnClick"/>
                    <Button Content="Построить / перерисовать" Click="RenderButton_OnClick"/>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>
                    <Button Content="Сбросить вид" Click="ResetViewButton_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="SavesButton_OnClick"/>
                    <Button Content="Сохранить изображение" Click="ExportButton_OnClick"/>

                    <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Прогресс"/>
                    <ProgressBar x:Name="RenderProgress" Height="20" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="DepthStatusText" Margin="0,7,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusText" Margin="0,7,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap" Text="Готово"/>
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Theme.DisabledTextBrush}"
                               TextWrapping="Wrap"
                               Text="Колесо мыши: масштаб. Левая кнопка: перемещение. F11: полноэкранный режим."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black"
                ClipToBounds="True" BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel"
                MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
        </Border>
        <Button x:Name="ToggleControlsButton" Grid.Column="1"
                Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕"
                ToolTip="Скрыть панель параметров" Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
