<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.ImageExportManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер сохранения изображений" Width="560" Height="700"
        MinWidth="520" MinHeight="650" WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Save.ico" Closing="Window_OnClosing">
    <Window.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PresetButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="OptionsPanel">
                <TextBlock Margin="0,0,0,12" FontSize="20" FontWeight="SemiBold"
                           Text="Параметры изображения"/>

                <GroupBox Header="Параметры вывода">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="Разрешение изображения"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="WidthBox" Grid.Column="0"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="ExportOption_OnChanged"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="×"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="HeightBox" Grid.Column="2"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="ExportOption_OnChanged"/>
                            <Button Grid.Column="3" Margin="10,0,0,0" Padding="10,5"
                                    Content="Повернуть" Click="Rotate_OnClick"/>
                        </Grid>

                        <UniformGrid Margin="0,8,0,0" Columns="5">
                            <Button Margin="0,0,4,0" Style="{StaticResource PresetButtonStyle}"
                                    Content="HD" ToolTip="1280 × 720" Tag="1280,720" Click="Preset_OnClick"/>
                            <Button Margin="2,0" Style="{StaticResource PresetButtonStyle}"
                                    Content="Full HD" ToolTip="1920 × 1080" Tag="1920,1080" Click="Preset_OnClick"/>
                            <Button Margin="2,0" Style="{StaticResource PresetButtonStyle}"
                                    Content="2K" ToolTip="2560 × 1440" Tag="2560,1440" Click="Preset_OnClick"/>
                            <Button Margin="2,0" Style="{StaticResource PresetButtonStyle}"
                                    Content="4K" ToolTip="3840 × 2160" Tag="3840,2160" Click="Preset_OnClick"/>
                            <Button Margin="4,0,0,0" Style="{StaticResource PresetButtonStyle}"
                                    Content="8K" ToolTip="7680 × 4320" Tag="7680,4320" Click="Preset_OnClick"/>
                        </UniformGrid>

                        <TextBlock Margin="0,12,0,5" Text="Формат файла"/>
                        <ComboBox x:Name="FormatBox" SelectionChanged="FormatBox_OnSelectionChanged">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                            <ComboBoxItem Content="BMP"/>
                        </ComboBox>

                        <StackPanel x:Name="JpegQualityPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Качество JPG"/>
                                <TextBlock x:Name="JpegQualityValue" Grid.Column="1" Text="95%"/>
                            </Grid>
                            <Slider x:Name="JpegQualitySlider" Minimum="1" Maximum="100" Value="95"
                                    TickFrequency="1" ValueChanged="JpegQualitySlider_OnValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,12,0,0" Header="Эффекты и качество">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabelStyle}"
                                   Text="Режим обработки"/>
                        <ComboBox x:Name="ProcessingModeBox" Grid.Row="1"
                                  SelectionChanged="ProcessingModeBox_OnSelectionChanged">
                            <ComboBoxItem Content="SSAA"/>
                            <ComboBoxItem Content="Бикубический апскейл"/>
                            <ComboBoxItem Content="Ланцош 3"/>
                        </ComboBox>
                        <TextBlock x:Name="QualityFactorLabel" Grid.Row="2" Margin="0,10,0,5"
                                   Text="Сглаживание (SSAA)"/>
                        <ComboBox x:Name="QualityFactorBox" Grid.Row="3"
                                  SelectionChanged="ExportOption_OnChanged"/>
                        <TextBlock x:Name="QualityHint" Grid.Row="4" Margin="0,9,0,0"
                                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12,10"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource Theme.BorderBrush}" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Row="0" Text="Готово" TextWrapping="Wrap"/>
                <TextBlock x:Name="ElapsedText" Grid.Row="0" Grid.Column="1" Margin="16,0,0,0"
                           MinWidth="48" HorizontalAlignment="Right" TextAlignment="Right" Text="00:00:00.0"/>
                <ProgressBar x:Name="ProgressBar" Grid.Row="1" Grid.ColumnSpan="2"
                             Margin="0,8,0,0" Height="12" Minimum="0" Maximum="100"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                    <TextBlock x:Name="RemainingText" Margin="0,7,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                               ToolTip="Приблизительное время по текущей скорости рендера. Масштабирование и запись файла не учитываются."/>
                    <TextBlock x:Name="MemoryHint" Margin="0,7,0,0"
                           Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="116"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="116"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SaveButton" Grid.Column="0" Content="Сохранить" IsDefault="True"
                    Click="SaveButton_OnClick"/>
            <Button x:Name="CancelButton" Grid.Column="2" Content="Закрыть" IsCancel="True"
                    Click="CancelButton_OnClick"/>
        </Grid>
    </Grid>
</Window>
