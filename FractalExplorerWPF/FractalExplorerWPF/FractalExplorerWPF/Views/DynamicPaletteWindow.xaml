<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.DynamicPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер палитр" Width="760" Height="560" MinWidth="660" MinHeight="470"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Создать копию" Click="Clone_OnClick"/>
                <Button x:Name="DeleteButton" Content="Удалить" Click="Delete_OnClick"/>
            </StackPanel>
            <ListBox x:Name="PaletteList" DisplayMemberPath="Name"
                     SelectionChanged="PaletteList_OnSelectionChanged"/>
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Название"/>
                <TextBox x:Name="NameBox" Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Режим"/>
                <ComboBox x:Name="ModeBox" Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Диапазон λ"/>
                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RangeBox" Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Полоса нуля"/>
                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ZeroBox" Grid.Column="1"/>
            </Grid>

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Ключевые цвета"/>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="ColorList" MinHeight="150" SelectionChanged="ColorList_OnSelectionChanged"
                             MouseDoubleClick="ColorList_OnMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="22" BorderBrush="{DynamicResource Theme.BorderBrush}"
                                            BorderThickness="1" CornerRadius="3">
                                        <Border.Background><SolidColorBrush Color="{Binding}"/></Border.Background>
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" Text="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button x:Name="AddColorButton" Margin="0,0,0,6" Content="Добавить…" Click="AddColor_OnClick"/>
                        <Button x:Name="EditColorButton" Margin="0,0,0,6" Content="Изменить…" Click="EditColor_OnClick"/>
                        <Button x:Name="RemoveColorButton" Margin="0,0,0,12" Content="Удалить" Click="RemoveColor_OnClick"/>
                        <Button x:Name="MoveColorUpButton" Margin="0,0,0,6" Content="↑ Выше" Click="MoveColorUp_OnClick"/>
                        <Button x:Name="MoveColorDownButton" Content="↓ Ниже" Click="MoveColorDown_OnClick"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="Preview" Grid.Row="2" Height="42" Margin="0,8,0,0"
                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="4"/>
            </Grid>

            <StackPanel Grid.Row="5" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Применить" Click="Apply_OnClick"/>
                <Button Content="Готово" IsDefault="True" Click="Done_OnClick"/>
                <Button Content="Отмена" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
