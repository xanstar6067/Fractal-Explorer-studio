<Window x:Class="FractalExplorerWPF.Views.JuliaParameterAtlasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        Title="Атлас параметров · Классическое Жюлиа" Width="1060" Height="820"
        MinWidth="860" MinHeight="640" WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/FractalExplorer.ico" Closed="Window_OnClosed">
    <Grid Margin="14" Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Атлас параметров · Жюлиа z² + C" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="112"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="По горизонтали: Re(C), от / до"/>
                    <UniformGrid Columns="2">
                        <TextBox x:Name="MinRealBox" controls:NumericSpinner.IsEnabled="True" Margin="0,4,4,0"/>
                        <TextBox x:Name="MaxRealBox" controls:NumericSpinner.IsEnabled="True" Margin="4,4,0,0"/>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="По вертикали: Im(C), от / до"/>
                    <UniformGrid Columns="2">
                        <TextBox x:Name="MinImaginaryBox" controls:NumericSpinner.IsEnabled="True" Margin="0,4,4,0"/>
                        <TextBox x:Name="MaxImaginaryBox" controls:NumericSpinner.IsEnabled="True" Margin="4,4,0,0"/>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Сетка"/>
                    <ComboBox x:Name="GridSizeBox" SelectedIndex="1" Margin="0,4,0,0">
                        <ComboBoxItem Content="3 × 3" Tag="3"/><ComboBoxItem Content="5 × 5" Tag="5"/><ComboBoxItem Content="7 × 7" Tag="7"/>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="3" Content="Построить" VerticalAlignment="Bottom" Padding="14,6" Click="Build_OnClick"/>
            </Grid>
            <WrapPanel Margin="0,10,0,10">
                <Button Content="Общий диапазон" Click="Overview_OnClick" Padding="10,5" Margin="0,0,8,0"/>
                <Button x:Name="BackButton" Content="Назад к диапазону" Click="Back_OnClick" IsEnabled="False" Padding="10,5"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,14,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="HorizontalRangeText" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <UniformGrid x:Name="TilesPanel" Columns="5" VerticalAlignment="Top"/>
                </ScrollViewer>
                <TextBlock x:Name="VerticalRangeText" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Выбранный вариант" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Image x:Name="SelectedPreview" Height="158" Stretch="Uniform"/>
                    <TextBlock x:Name="SelectedText" Margin="0,10,0,10" TextWrapping="Wrap"/>
                    <Button x:Name="ApplyButton" Content="Применить в текущем окне" Click="Apply_OnClick" IsEnabled="False" Padding="4,7"/>
                    <Button x:Name="NarrowButton" Content="Исследовать рядом" Click="Narrow_OnClick" IsEnabled="False" Padding="4,7" Margin="0,8,0,0"/>
                    <TextBlock Text="Щелчок — выбор. Двойной щелчок — применение C." Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock Text="Общий обзор формы и текущая палитра. Применение меняет только C, сохраняя вид основного окна." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="CancelAtlasButton" DockPanel.Dock="Right" Content="Остановить" IsEnabled="False" Padding="12,5" Click="Cancel_OnClick"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</Window>
