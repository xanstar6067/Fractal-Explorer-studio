<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.IfsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:FractalExplorerWPF.Theming" Title="IFS Барнсли / Хейуэя" Width="1140" Height="720" MinWidth="900" MinHeight="570" WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Параметры IFS"/><TextBlock Margin="0,9,0,3" Text="Готовый набор"/><ComboBox x:Name="PresetBox" SelectionChanged="Preset_OnChanged"/>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Итерации"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="IterationsBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Центр X"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CenterXBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Центр Y"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CenterYBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Масштаб"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ScaleBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Цвет фрактала" Click="FractalColor_OnClick"/><Border x:Name="FractalColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="FractalColor_OnClick"/></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Цвет фона" Click="BackgroundColor_OnClick"/><Border x:Name="BackgroundColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="BackgroundColor_OnClick"/></Grid>
            <Button Content="Аффинные преобразования" Click="Transforms_OnClick"/><Button Content="Сброс вида" Click="Reset_OnClick"/><Button Content="Запустить рендер" Click="Render_OnClick"/><Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel_OnClick"/><Button Content="Менеджер сохранений" Click="Saves_OnClick"/><Button Content="Сохранить изображение" Click="Export_OnClick"/>
            <TextBlock x:Name="ProgressText" Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Ожидание"/><ProgressBar x:Name="ProgressBar" Height="20" Maximum="100"/><TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Готово"/><TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.DisabledTextBrush}" Text="Колесо: масштаб. ЛКМ: перемещение. Рендер сначала строит орбиту, затем заполняет точки."/>
        </StackPanel></ScrollViewer></Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" ClipToBounds="True" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True" SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp"><Grid><Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="StableImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/><Image x:Name="CurrentImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid><Border x:Name="RenderBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000" Visibility="Collapsed"><TextBlock x:Name="RenderBadgeText" Foreground="White"/></Border></Grid></Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
