<Window x:Class="FractalExplorerWPF.Views.TuringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Узоры Тьюринга" Width="1280" Height="850" MinWidth="1040" MinHeight="650"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources><numeric:FlexibleDoubleConverter x:Key="FlexibleNumber"/></Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="14,9" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Узоры Тьюринга" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Живые узоры реакции и диффузии" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                </StackPanel>
                <Button x:Name="RunButton" Content="Пауза" MinWidth="88" Click="Run_OnClick" ToolTip="Остановить или продолжить развитие · Пробел"/>
                <Button x:Name="StepButton" Content="Один шаг" Click="Step_OnClick" ToolTip="Один шаг модели на паузе · →"/>
                <Button x:Name="NewButton" Content="Новый рисунок" Click="New_OnClick" ToolTip="Другой случайный старт с текущими настройками. Предыдущий рисунок можно вернуть."/>
                <Button x:Name="UndoButton" Content="Вернуть" Click="Undo_OnClick" IsEnabled="False" ToolTip="Вернуть предыдущий рисунок или отменить последний штрих · Ctrl+Z"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SavesButton" Content="Сохранения…" Click="Saves_OnClick" ToolTip="Сохранить поле, настройки и текущий вид; загрузить и продолжить"/>
                    <Button x:Name="ExportButton" Content="Экспорт…" Click="Export_OnClick" ToolTip="Сохранить изображение текущего поля без дополнительного развития"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="360"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="ControlsHost" Margin="10" Padding="12" CornerRadius="7" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Начните с готового вида" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PresetBox" SelectionChanged="Preset_OnChanged" AutomationProperties.Name="Готовый узор"/>
                        <TextBlock x:Name="PresetDescription" Margin="0,7,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                        <TabControl x:Name="SettingsTabs">
                            <TabItem Header="Форма">
                                <StackPanel Margin="8">
                                    <numeric:TuringReactionEditor x:Name="ReactionEditor" Changed="Reaction_OnChanged"/>
                                    <TextBlock Text="Меняется на текущем поле" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,0,0,10"/>
                                    <DockPanel><TextBlock Text="Размер деталей"/><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding Value, ElementName=DetailSlider, StringFormat={}{0:F2}×}"/></DockPanel>
                                    <Slider x:Name="DetailSlider" Minimum="0.25" Maximum="3" ValueChanged="Shape_OnChanged" AutomationProperties.Name="Размер деталей" ToolTip="Меньше — тонкие нити; больше — широкие каналы. Размер поля не меняется."/>
                                    <DockPanel Margin="0,0,0,10"><TextBlock Text="Тоньше" FontSize="11"/><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="Крупнее" FontSize="11"/></DockPanel>
                                    <StackPanel x:Name="McCabeDepthPanel">
                                    <DockPanel><TextBlock Text="Глубина структуры"/><TextBlock x:Name="DepthValueText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <Slider x:Name="DepthSlider" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Depth_OnChanged" AutomationProperties.Name="Число масштабов" ToolTip="Каждый масштаб добавляет свой размер деталей. Больше масштабов — богаче структура и дольше расчёт. Этот ползунок восстанавливает стандартные радиусы и отклики."/>
                                    </StackPanel>
                                    <TextBlock Text="Симметрия" Margin="0,10,0,3"/>
                                    <ComboBox x:Name="SymmetryBox" SelectionChanged="Shape_OnChanged" AutomationProperties.Name="Симметрия">
                                        <ComboBoxItem Tag="1" Content="Без симметрии — всё поле"/><ComboBoxItem Tag="2" Content="2 луча"/><ComboBoxItem Tag="4" Content="4 луча"/>
                                        <ComboBoxItem Tag="6" Content="6 лучей"/><ComboBoxItem Tag="8" Content="8 лучей"/><ComboBoxItem Tag="12" Content="12 лучей"/>
                                    </ComboBox>
                                    <CheckBox x:Name="MirrorBox" Content="Зеркальная симметрия" Margin="0,5,0,5" Click="Shape_OnChanged"/>
                                    <TextBlock x:Name="SymmetryHint" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock Text="Развитие" FontWeight="SemiBold" Margin="0,15,0,4"/>
                                    <DockPanel><TextBlock Text="Скорость просмотра"/><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}×{0:F0}}"/></DockPanel>
                                    <Slider x:Name="SpeedSlider" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Speed_OnChanged" AutomationProperties.Name="Скорость просмотра" ToolTip="Ускоряет наблюдение. Правило формирования узора не меняется."/>
                                    <TextBlock Text="Вычисления" Margin="0,7,0,3"/>
                                    <ComboBox x:Name="BackendBox" SelectionChanged="Backend_OnChanged" AutomationProperties.Name="Движок симуляции">
                                        <ComboBoxItem Content="ГП — рекомендуется"/><ComboBoxItem Content="ЦП — совместимый вариант"/>
                                    </ComboBox>
                                    <TextBlock x:Name="BackendHint" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,4,0,8"/>
                                    <TextBlock Text="Сетка симуляции" Margin="0,7,0,3"/>
                                    <ComboBox x:Name="QualityBox" SelectionChanged="Quality_OnChanged" AutomationProperties.Name="Качество поля">
                                        <ComboBoxItem Tag="128" Content="Быстро · 128 × 128"/><ComboBoxItem Tag="256" Content="Баланс · 256 × 256"/>
                                        <ComboBoxItem Tag="384" Content="Детально · 384 × 384"/><ComboBoxItem Tag="512" Content="Высокое · 512 × 512"/><ComboBoxItem Tag="768" Content="Очень высокое · 768 × 768"/>
                                    </ComboBox>
                                    <DockPanel Margin="0,5,0,0">
                                        <Button DockPanel.Dock="Right" Content="Применить" Click="GridSize_OnApply" ToolTip="Перенести текущий узор на новую сетку"/>
                                        <TextBox x:Name="GridSizeBox" Margin="0,0,5,0" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" AutomationProperties.Name="Размер сетки" ToolTip="Своя сетка: от 32 до 2048 ячеек по стороне"/>
                                    </DockPanel>
                                    <TextBlock x:Name="GridSizeError" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                    <TextBlock Text="Больше ячеек — тоньше линии, медленнее развитие. При смене качества текущий рисунок переносится на новую сетку." FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                    <Expander Header="Буфер изображения" IsExpanded="True" Margin="0,7,0,7">
                                        <StackPanel Margin="0,7,0,0">
                                            <CheckBox x:Name="AutoFrameBox" Content="Автоматически — по области показа" Click="FrameSize_OnApply"/>
                                            <TextBlock x:Name="FrameSizeHint" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,5" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                            <Grid x:Name="FrameSizeInputs"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="FrameWidthBox" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" AutomationProperties.Name="Ширина буфера"/>
                                                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBox x:Name="FrameHeightBox" Grid.Column="2" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" AutomationProperties.Name="Высота буфера"/>
                                                <Button Grid.Column="3" Content="✓" Click="FrameSize_OnApply" Margin="4,0,0,0" ToolTip="Применить размер буфера"/>
                                            </Grid>
                                            <TextBlock x:Name="FrameSizeError" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                            <TextBlock Text="Буфер определяет чёткость показа. Детали узора задаёт сетка симуляции. Колесо приближает поле с повторной отрисовкой." TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Expander>
                                    <Expander x:Name="LayersExpander" Header="Настроить отдельные масштабы" Margin="0,6,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <StackPanel x:Name="McCabeLayersPanel">
                                            <TextBlock Text="Радиус задаёт размер окружения, отклик — силу изменения. Правки вступят в силу после применения." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                            <Grid Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Радиус"/><TextBlock Grid.Column="2" Text="Отклик"/></Grid>
                                            <ItemsControl x:Name="LayersItems">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Click="Layers_OnEdited" ToolTip="Участвует в формировании узора" AutomationProperties.Name="Использовать масштаб"/>
                                                        <TextBox Grid.Column="1" Margin="0,0,4,0" numeric:NumericSpinner.IsEnabled="True" Text="{Binding Radius, Converter={StaticResource FlexibleNumber}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" TextChanged="Layers_OnEdited" ToolTip="Радиус на сетке 256: от 1 до 100" AutomationProperties.Name="Радиус масштаба"/>
                                                        <TextBox Grid.Column="2" numeric:NumericSpinner.IsEnabled="True" Text="{Binding Amount, Converter={StaticResource FlexibleNumber}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" TextChanged="Layers_OnEdited" ToolTip="Отклик от 0,001 до 0,15" AutomationProperties.Name="Отклик масштаба"/>
                                                    </Grid>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Зона подавления" Margin="0,7,0,3"/>
                                            <Slider x:Name="InhibitorSlider" Minimum="1.2" Maximum="4" ValueChanged="Layers_OnEdited" ToolTip="Во сколько раз окружение подавления шире окружения активации"/>
                                            <Button x:Name="ApplyLayersButton" Content="Применить масштабы" Click="ApplyLayers_OnClick" IsEnabled="False"/>
                                            <TextBlock x:Name="LayersError" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="Поведение на краях" Margin="0,8,0,3"/>
                                            <ComboBox x:Name="BoundaryBox" SelectionChanged="Shape_OnChanged"><ComboBoxItem Content="Замкнутое поле — противоположные края связаны"/><ComboBoxItem Content="Отражение — процессы остаются в поле"/></ComboBox>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Начальное поле" Margin="0,8,0,0">
                                        <StackPanel Margin="0,7,0,0">
                                            <TextBlock Text="Число определяет случайный старт. Одинаковые число и настройки дают одинаковый рисунок." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                            <TextBox x:Name="SeedBox" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" Margin="0,5" AutomationProperties.Name="Число случайного старта"/>
                                            <Button x:Name="RestartButton" Content="Начать заново с этим числом" Click="Restart_OnClick" ToolTip="Возвращает исходное поле и выращивает узор с текущими настройками"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Цвет">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Окраска не меняет само поле" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Палитра"/><ComboBox x:Name="PaletteBox" DisplayMemberPath="Name" SelectionChanged="Palette_OnChanged" Margin="0,3,0,5"/>
                                    <Border x:Name="PalettePreview" Height="24" CornerRadius="4" Margin="0,0,0,5" theme:ThemeContract.IgnoreAudit="True"/>
                                    <Button x:Name="PaletteEditorButton" Content="Создать или изменить палитру…" Click="PaletteEditor_OnClick"/>
                                    <TextBlock Text="Отображение" Margin="0,12,0,3"/>
                                    <ComboBox x:Name="ColoringBox" SelectionChanged="Appearance_OnChanged"><ComboBoxItem Content="Цвет поля"/><ComboBoxItem Content="Рельеф — свет и тень"/><ComboBoxItem Content="Карта масштабов"/></ComboBox>
                                    <TextBlock x:Name="ColoringHint" TextWrapping="Wrap" Margin="0,5,0,10" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                    <TextBlock Text="Контраст"/><Slider x:Name="ContrastSlider" Minimum="0.3" Maximum="3" ValueChanged="Appearance_OnChanged" AutomationProperties.Name="Контраст"/>
                                    <StackPanel x:Name="ReliefPanel"><TextBlock Text="Глубина рельефа" Margin="0,8,0,0"/><Slider x:Name="ReliefSlider" Minimum="0" Maximum="2" ValueChanged="Appearance_OnChanged" AutomationProperties.Name="Глубина рельефа"/></StackPanel>
                                    <CheckBox x:Name="ReverseBox" Content="Обратить палитру" Click="Appearance_OnChanged" Margin="0,7,0,0"/>
                                    <TextBlock Text="На паузе цвет тоже обновляется сразу. Экспорт сохраняет выбранные цвета и текущий вид. Для более тонких деталей сначала повысьте качество поля: размер файла сам по себе их не добавляет." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" FontSize="11" Margin="0,15,0,0"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Кисть">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Рисуйте левой кнопкой мыши" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Штрих меняет поле. Во время развития узор поглощает и преобразует его; на паузе удобно подготовить рисунок." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="BrushBox" SelectionChanged="Brush_OnChanged"><ComboBoxItem Content="Светлее — усилить поле"/><ComboBoxItem Content="Темнее — ослабить поле"/><ComboBoxItem Content="Шум — нарушить структуру"/></ComboBox>
                                    <TextBlock Text="Размер кисти" Margin="0,12,0,0"/><Slider x:Name="BrushSizeSlider" Minimum="0.005" Maximum="0.2" ValueChanged="Brush_OnChanged" AutomationProperties.Name="Размер кисти"/>
                                    <TextBlock Text="Сила воздействия" Margin="0,8,0,0"/><Slider x:Name="BrushStrengthSlider" Minimum="0.05" Maximum="1" ValueChanged="Brush_OnChanged" AutomationProperties.Name="Сила кисти"/>
                                    <TextBlock Text="При включённой симметрии штрих повторяется по лучам. Ctrl+Z или «Вернуть» отменяет последний штрих." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                        <Expander Header="Как образуется узор" Margin="0,12,0,0">
                            <TextBlock Margin="4,7" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                       Text="Каждая точка сравнивает среднее значение в ближнем и дальнем окружении. На нескольких масштабах одновременно возникают конкурирующие изменения. Побеждает масштаб с наименьшими различиями в окружении. После каждого шага поле нормируется. Это художественная модель Маккейба, вдохновлённая механизмом Тьюринга. Карта масштабов показывает победителя в каждой точке."/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" CornerRadius="7" Background="#0A0F16" ClipToBounds="True"
                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" theme:ThemeContract.IgnoreAudit="True"
                    MouseDown="Canvas_OnMouseDown" MouseMove="Canvas_OnMouseMove" MouseUp="Canvas_OnMouseUp" MouseWheel="Canvas_OnMouseWheel" MouseLeave="Canvas_OnMouseLeave" LostMouseCapture="Canvas_OnLostCapture">
                <Grid>
                    <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="FrameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                    <Canvas IsHitTestVisible="False"><Ellipse x:Name="BrushCursor" Visibility="Collapsed" Stroke="White" StrokeThickness="1" Fill="#18FFFFFF"/></Canvas>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="52,12,12,12" Padding="10,6" CornerRadius="5" Background="#BD0A0F16" IsHitTestVisible="False">
                        <TextBlock x:Name="FrameBadgeText" Foreground="White" Text="Подготовка поля…"/>
                    </Border>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,12,38,0" Padding="10,5" VerticalContentAlignment="Center" Content="Всё поле" Click="Fit_OnClick" ToolTip="Показать всё поле · Home"/>
                    <Border x:Name="ScaleLegend" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,48" Padding="10,6" CornerRadius="5" Background="#DD0A0F16" IsHitTestVisible="False">
                        <StackPanel><TextBlock Foreground="White" Text="Активный масштаб: от мелких деталей к крупным" Margin="0,0,0,4"/><ItemsControl x:Name="LegendItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
                    </Border>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" Padding="10,6" CornerRadius="5" Background="#BD0A0F16" IsHitTestVisible="False">
                        <TextBlock Foreground="White" FontSize="11" Text="ЛКМ — кисть  ·  колесо — масштаб  ·  ПКМ / средняя — перемещение  ·  пробел — пауза"/>
                    </Border>
                    <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#D90A0F16">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                            <TextBlock x:Name="PreparationText" Foreground="White" FontSize="17" TextAlignment="Center" TextWrapping="Wrap" Text="Выращиваем начальный узор…"/>
                            <ProgressBar x:Name="PreparationProgress" Height="5" Margin="0,14" Minimum="0" Maximum="100"/>
                            <TextBlock Foreground="#C2CDD6" Text="После подготовки можно продолжить развитие или поставить его на паузу." TextWrapping="Wrap" TextAlignment="Center" FontSize="12"/>
                            <Button Content="Остановить подготовку" Click="CancelPreparation_OnClick" Margin="20,14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
        </Grid>
        <DockPanel Grid.Row="2" Margin="12,0,12,8">
            <TextBlock x:Name="ViewText" DockPanel.Dock="Right" Text="Масштаб 100%" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
            <TextBlock x:Name="StatusText" Text="Подготовка…" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        </DockPanel>
    </Grid>
</Window>
