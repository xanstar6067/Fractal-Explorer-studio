<Window x:Class="FractalExplorerWPF.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="600"
        Height="560"
        MinWidth="520"
        MinHeight="460"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/FractalExplorer.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="52" Height="52"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Theme.ControlBackgroundAltBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Image x:Name="LogoImage" Margin="8"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="23"
                           FontWeight="SemiBold"
                           Text="Fractal Explorer Studio"/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                           Text="Менеджер и исследователь фракталов"/>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="1" Margin="0,20,0,20"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="0,0,12,14"
                       Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                       Text="Автор:"/>
            <TextBlock Grid.Column="1" Margin="0,0,0,14" Text="xanstar6067"/>

            <TextBlock Grid.Row="1" Margin="0,0,12,20"
                       Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                       Text="Репозиторий:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,20" TextWrapping="Wrap">
                <Hyperlink NavigateUri="https://github.com/xanstar6067/Fractal-Explorer-studio"
                           Foreground="{DynamicResource Theme.AccentPrimaryBrush}"
                           RequestNavigate="RepositoryLink_OnRequestNavigate">
                    github.com/xanstar6067/Fractal-Explorer-studio
                </Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="2" Margin="0,0,12,20"
                       Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                       Text="Данные:"/>
            <TextBlock x:Name="DataFolderText"
                       Grid.Row="2" Grid.Column="1" Margin="0,0,0,20"
                       TextWrapping="Wrap"
                       ToolTip="Сохранения, превью, палитры, темы, настройки и журнал ошибок"/>

            <Border Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,20"
                    Padding="14,11"
                    Background="{DynamicResource Theme.ControlBackgroundAltBrush}"
                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.AccentPrimaryBrush}"
                               Text="Создано при поддержке ИИ"/>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="В разработке помогали технологии Google AI, ChatGPT, Claude и Grok."/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4" Margin="0,0,12,0"
                       Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                       Text="Описание:"/>
            <TextBlock Grid.Row="4" Grid.Column="1"
                       LineHeight="22"
                       TextWrapping="Wrap"
                       Text="Fractal Explorer Studio — это WPF-приложение на C#, которое позволяет генерировать, исследовать и настраивать множество фракталов с гибким управлением цветом, интерактивными селекторами параметров, сохранением состояний и экспортом изображений в высоком качестве."/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,24,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Padding="14,0"
                    Content="Открыть папку с данными"
                    ToolTip="Сохранения, превью, палитры, темы, настройки и журнал ошибок"
                    Click="OpenDataFolder_OnClick"/>
            <Button DockPanel.Dock="Right"
                    Width="100"
                    IsCancel="True"
                    Content="Закрыть"/>
        </DockPanel>
    </Grid>
</Window>
