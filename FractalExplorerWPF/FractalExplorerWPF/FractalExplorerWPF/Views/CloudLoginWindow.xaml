<Window x:Class="FractalExplorerWPF.Views.CloudLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в FractalCloud" Width="450" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="FractalCloud" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="ServerText" Margin="0,6,0,18" TextWrapping="Wrap"/>
        <TextBlock Text="Email"/>
        <TextBox x:Name="EmailBox" Margin="0,5,0,12" MaxLength="254"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordInput" Margin="0,5,0,12" Padding="8" MinHeight="34"
                     Background="{DynamicResource Theme.ControlBackgroundBrush}"
                     Foreground="{DynamicResource Theme.PrimaryTextBrush}"
                     BorderBrush="{DynamicResource Theme.InputBorderBrush}"/>
        <TextBlock Text="Пароль не сохраняется. Сеанс защищён учётной записью Windows. Регистрация закрыта."
                   TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LoginButton" Content="Войти" IsDefault="True" Click="Login_OnClick" MinWidth="100"/>
            <Button Content="Отмена" IsCancel="True" MinWidth="100" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
