<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.SerpinskyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Треугольник Серпинского"
        Width="1120" Height="700"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Serpinski.ico"
        KeyDown="Window_OnKeyDown"
        Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ControlsColumn" Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ControlsHost" Grid.Column="0" Margin="10" Padding="14"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Параметры"/>

                    <TextBlock x:Name="RenderModeLabel" Margin="0,14,0,0" Text="Режим"/>
                    <ComboBox x:Name="RenderModeBox"
                              SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="Геометрический"/>
                        <ComboBoxItem Content="Игра хаоса"/>
                    </ComboBox>

                    <TextBlock x:Name="IterationsLabel" Text="Итерации / точки"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="IterationsBox"
                             TextChanged="Parameter_OnChanged"/>

                    <TextBlock Text="Приближение"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ZoomBox"
                             TextChanged="ZoomBox_OnTextChanged"/>

                    <TextBlock Text="Потоки ЦП"/>
                    <ComboBox x:Name="ThreadsBox"
                              SelectionChanged="Parameter_OnChanged"/>

                    <Button Content="Запустить рендер"
                            Click="RenderButton_OnClick"/>
                    <Button x:Name="CancelButton"
                            Content="Отмена"
                            IsEnabled="False"
                            Click="CancelButton_OnClick"/>
                    <Button Content="Настроить палитру"
                            Click="PaletteButton_OnClick"/>
                    <Button Content="Менеджер сохранений"
                            Click="SavesButton_OnClick"/>
                    <Button Content="Сохранить изображение"
                            Click="ExportButton_OnClick"/>

                    <TextBlock Margin="0,12,0,4"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               Text="Прогресс"/>
                    <ProgressBar x:Name="RenderProgress"
                                 Height="20"
                                 Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusText"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="Готово"/>

                    <TextBlock Margin="0,16,0,0"
                               Foreground="{DynamicResource Theme.DisabledTextBrush}"
                               TextWrapping="Wrap"
                               Text="Колесо мыши: масштаб. Левая кнопка: перемещение. F11: полноэкранный режим."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="CanvasHost"
                Grid.Column="1" Margin="0,10,10,10"
                Background="Black"
                ClipToBounds="True"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged"
                MouseWheel="CanvasHost_OnMouseWheel"
                MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseMove="CanvasHost_OnMouseMove"
                MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp"
                LostMouseCapture="CanvasHost_OnLostMouseCapture">
            <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="CanvasImage"
                   Stretch="Fill"
                   SnapsToDevicePixels="True"/></Grid>
        </Border>

        <Button x:Name="ToggleControlsButton" Grid.Column="1"
                Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров"
                Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
