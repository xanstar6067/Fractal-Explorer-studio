<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.IfsTransformEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Аффинные преобразования IFS" Width="930" Height="600" MinWidth="780" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="58"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Margin="10,10,5,10" Padding="10" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="2,0,2,8"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Преобразования"/><TextBlock x:Name="TotalText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
            <ListBox x:Name="TransformList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="TransformList_OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Margin="0,2" Padding="9" CornerRadius="5" Background="{DynamicResource Theme.ControlBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="Аффинное преобразование"/><TextBlock Foreground="{DynamicResource Theme.SecondaryTextBrush}"><Run Text="Вероятность "/><Run Text="{Binding Probability, StringFormat=F4}"/></TextBlock><ProgressBar Margin="0,5,0,0" Height="4" Maximum="1" Value="{Binding Probability}"/></StackPanel><Button Grid.Column="1" Width="26" Height="30" Padding="0" Content="×" ToolTip="Удалить" Click="Delete_OnClick"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Button Grid.Row="2" Margin="0,8,0,0" Content="+ Добавить преобразование" Click="Add_OnClick"/>
        </Grid></Border>
        <Border Grid.Column="1" Margin="5,10,10,10" Padding="16" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"><Grid x:Name="EditorPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="EditorTitle" FontSize="19" FontWeight="SemiBold" Text="Редактор преобразования"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0">
            <TextBlock FontWeight="SemiBold" Text="Вероятность выбора"/><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Slider x:Name="ProbabilitySlider" Maximum="1" TickFrequency=".05" ValueChanged="Probability_OnChanged"/><TextBlock x:Name="ProbabilityText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="ProbabilityPercentText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Separator/><TextBlock Margin="0,12,0,2" FontWeight="SemiBold" Text="Матрица и перенос"/><TextBlock Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="x′ = a·x + b·y + e        y′ = c·x + d·y + f"/>
            <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock HorizontalAlignment="Center" Text="a"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="b"/><TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="e (перенос X)"/>
                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ABox" Grid.Row="1" Margin="3" TextChanged="Editor_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="BBox" Grid.Row="1" Grid.Column="1" Margin="3" TextChanged="Editor_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="EBox" Grid.Row="1" Grid.Column="2" Margin="3" TextChanged="Editor_OnChanged"/>
                <TextBlock Grid.Row="2" HorizontalAlignment="Center" Text="c"/><TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Text="d"/><TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" Text="f (перенос Y)"/>
                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CBox" Grid.Row="3" Margin="3" TextChanged="Editor_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DBox" Grid.Row="3" Grid.Column="1" Margin="3" TextChanged="Editor_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="FBox" Grid.Row="3" Grid.Column="2" Margin="3" TextChanged="Editor_OnChanged"/>
            </Grid>
            <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource Theme.ControlBackgroundBrush}" CornerRadius="6"><TextBlock x:Name="MatrixText" FontFamily="Consolas" FontSize="17" TextAlignment="Center"/></Border>
        </StackPanel></ScrollViewer></Grid></Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="10,7" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UndoButton" Width="128" Content="Отменить действие" IsEnabled="False" Click="Undo_OnClick"/>
                    <Button Width="132" Content="Нормализовать" Click="Normalize_OnClick"/>
                    <Button x:Name="RandomizeButton" Width="135" Content="Сделать случайно" Click="Randomize_OnClick"/>
                    <ToggleButton x:Name="RandomSettingsButton" Width="38" Margin="4,0,0,0" Padding="0" Content="⚙" FontSize="17"
                                  Style="{StaticResource ThemeToggleButtonStyle}" ToolTip="Настроить случайную генерацию"/>
                    <Popup x:Name="RandomSettingsPopup" PlacementTarget="{Binding ElementName=RandomSettingsButton}" Placement="Top" VerticalOffset="-7"
                           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=RandomSettingsButton, Mode=TwoWay}" Closed="RandomSettingsPopup_OnClosed">
                        <Border Width="470" Padding="16" CornerRadius="7" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Настройка IFS-рандома"/>
                                <TextBlock Margin="0,3,0,13" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                                           Text="Диапазон 5–5 всегда создаёт ровно пять преобразований. Все вероятности нормализуются автоматически."/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Количество: от"/>
                                    <ComboBox x:Name="MinimumTransformCountBox" Grid.Column="1" Margin="8,0" SelectionChanged="RandomCount_OnChanged"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="до"/>
                                    <ComboBox x:Name="MaximumTransformCountBox" Grid.Column="3" Margin="8,0" SelectionChanged="RandomCount_OnChanged"/>
                                    <TextBlock x:Name="RandomCountHintText" Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                </Grid>

                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Расположение"/>
                                    <ComboBox x:Name="PlacementModeBox" Grid.Column="1" SelectionChanged="RandomOption_OnChanged"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Вероятности"/>
                                    <ComboBox x:Name="ProbabilityModeBox" Grid.Column="1" SelectionChanged="RandomOption_OnChanged"/>
                                </Grid>

                                <Separator Margin="0,14"/>
                                <DockPanel Margin="0,0,0,7">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Width="58" Height="28" Padding="4,2" Content="Все" Click="SelectAllFamilies_OnClick"/>
                                        <Button Width="78" Height="28" Padding="4,2" Content="Снять все" Click="ClearFamilies_OnClick"/>
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Семейства преобразований"/>
                                </DockPanel>
                                <UniformGrid x:Name="RandomFamilyPanel" Columns="2"/>
                                <TextBlock x:Name="RandomSettingsValidationText" Margin="0,9,0,0" Foreground="{DynamicResource Theme.AccentSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RandomSettingsSummaryText" Margin="0,7,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="90" Content="Отмена" IsCancel="True"/>
                    <Button Width="98" Content="Применить" Click="Apply_OnClick"/>
                    <Button Width="98" Content="Готово" Click="Done_OnClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
