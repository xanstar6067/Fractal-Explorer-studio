<Window x:Class="FractalExplorerWPF.Views.Ifs3DTransformEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls"
        Title="Преобразования объёмного IFS" Width="1010" Height="690"
        MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner"
        Closing="Window_OnClosing">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Margin="10,10,5,10" Padding="10" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,8">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Преобразования"/>
                    <TextBlock x:Name="TotalText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="TransformList" Grid.Row="1" SelectionChanged="TransformList_OnSelectionChanged"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Padding="9" CornerRadius="5" Background="{DynamicResource Theme.ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Объёмное преобразование"/>
                                        <TextBlock Foreground="{DynamicResource Theme.SecondaryTextBrush}">
                                            <Run Text="Вес "/><Run Text="{Binding Probability, StringFormat=F4}"/>
                                        </TextBlock>
                                        <ProgressBar Margin="0,5,0,0" Height="4" Maximum="10" Value="{Binding Probability}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Width="26" Height="30" Padding="0" Content="×"
                                            ToolTip="Удалить" Click="Delete_OnClick"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                    <Button Content="+ Добавить" Click="Add_OnClick"/>
                    <Button Content="Дублировать" Click="Duplicate_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="5,10,10,10" Padding="16" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <Grid x:Name="EditorPanel">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="EditorTitle" FontSize="19" FontWeight="SemiBold" Text="Редактор преобразования"/>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Вес выбора"/>
                        <Grid Margin="0,5,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="75"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                            <Slider x:Name="ProbabilitySlider" Maximum="10" TickFrequency=".1" ValueChanged="Probability_OnChanged"/>
                            <TextBlock x:Name="ProbabilityText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProbabilityPercentText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Separator/>
                        <TextBlock Margin="0,12,0,3" FontWeight="SemiBold" Text="Матрица и перенос"/>
                        <TextBlock Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                                   Text="Строки задают x′, y′ и z′. Последний столбец сдвигает результат по соответствующей оси."/>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock HorizontalAlignment="Center" Text="x"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="y"/>
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="z"/><TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="перенос"/>
                            <TextBox x:Name="M11Box" Grid.Row="1" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="M12Box" Grid.Row="1" Grid.Column="1" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="M13Box" Grid.Row="1" Grid.Column="2" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="TxBox" Grid.Row="1" Grid.Column="3" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="M21Box" Grid.Row="2" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="M22Box" Grid.Row="2" Grid.Column="1" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="M23Box" Grid.Row="2" Grid.Column="2" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="TyBox" Grid.Row="2" Grid.Column="3" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="M31Box" Grid.Row="3" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="M32Box" Grid.Row="3" Grid.Column="1" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="M33Box" Grid.Row="3" Grid.Column="2" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                            <TextBox x:Name="TzBox" Grid.Row="3" Grid.Column="3" Margin="3" numeric:NumericSpinner.IsEnabled="True" TextChanged="Matrix_OnChanged"/>
                        </Grid>
                        <Border Margin="0,8,0,0" Padding="14" Background="{DynamicResource Theme.ControlBackgroundBrush}" CornerRadius="6">
                            <TextBlock x:Name="MatrixText" FontFamily="Consolas" FontSize="15" TextAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="ValidationText" Margin="0,10,0,0" Foreground="{DynamicResource Theme.AccentSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="10,7" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UndoButton" Width="128" Content="Отменить действие" IsEnabled="False" Click="Undo_OnClick"/>
                    <Button Width="132" Content="Нормализовать" Click="Normalize_OnClick"/>
                    <Button x:Name="RandomizeButton" Width="138" Content="Сделать случайно" Click="Randomize_OnClick"/>
                    <ToggleButton x:Name="RandomSettingsButton" Width="38" Margin="4,0,0,0" Padding="0" Content="⚙" FontSize="17"
                                  Style="{StaticResource ThemeToggleButtonStyle}" ToolTip="Настроить случайную генерацию"/>
                    <Popup x:Name="RandomSettingsPopup" PlacementTarget="{Binding ElementName=RandomSettingsButton}" Placement="Top"
                           VerticalOffset="-7" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=RandomSettingsButton, Mode=TwoWay}" Closed="RandomSettingsPopup_OnClosed">
                        <Border Width="485" Padding="16" CornerRadius="7" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Настройка объёмного IFS-рандома"/>
                                <TextBlock Margin="0,3,0,13" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                                           Text="Генератор размещает преобразования в объёме и ограничивает их сжатие. Веса приводятся к сумме 1."/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Количество: от"/>
                                    <ComboBox x:Name="MinimumTransformCountBox" Grid.Column="1" Margin="8,0" SelectionChanged="RandomCount_OnChanged"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="до"/>
                                    <ComboBox x:Name="MaximumTransformCountBox" Grid.Column="3" Margin="8,0" SelectionChanged="RandomCount_OnChanged"/>
                                    <TextBlock x:Name="RandomCountHintText" Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                </Grid>
                                <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Расположение"/>
                                    <ComboBox x:Name="PlacementModeBox" Grid.Column="1" SelectionChanged="RandomOption_OnChanged"/>
                                </Grid>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Веса"/>
                                    <ComboBox x:Name="ProbabilityModeBox" Grid.Column="1" SelectionChanged="RandomOption_OnChanged"/>
                                </Grid>
                                <Separator Margin="0,14"/>
                                <DockPanel Margin="0,0,0,7">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Width="58" Height="28" Padding="4,2" Content="Все" Click="SelectAllFamilies_OnClick"/>
                                        <Button Width="78" Height="28" Padding="4,2" Content="Снять все" Click="ClearFamilies_OnClick"/>
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Семейства преобразований"/>
                                </DockPanel>
                                <UniformGrid x:Name="RandomFamilyPanel" Columns="2"/>
                                <TextBlock x:Name="RandomSettingsValidationText" Margin="0,9,0,0" Foreground="{DynamicResource Theme.AccentSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RandomSettingsSummaryText" Margin="0,7,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="90" Content="Отмена" IsCancel="True"/>
                    <Button Width="98" Content="Применить" Click="Apply_OnClick"/>
                    <Button Width="98" Content="Готово" Click="Done_OnClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
