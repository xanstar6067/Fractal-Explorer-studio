<Window x:Class="FractalExplorerWPF.Views.McMullenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Семейство Макмаллена" Width="1240" Height="840" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" Icon="../Assets/Icons/NewtonPool.ico"
        KeyDown="Window_OnKeyDown" Closed="Window_OnClosed">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="4,3,0,3"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryTextBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="12" CornerRadius="7"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Семейство Макмаллена" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FormulaText" Style="{StaticResource Hint}" FontSize="16"/>
                    <TextBlock Text="Готовые виды"/>
                    <ComboBox x:Name="PresetBox" DisplayMemberPath="SaveName" SelectionChanged="Preset_OnChanged"/>
                    <ComboBox x:Name="PlaneBox" SelectionChanged="Plane_OnChanged">
                        <ComboBoxItem Content="Множество Жюлиа · плоскость z"/>
                        <ComboBoxItem Content="Карта параметра λ"/>
                    </ComboBox>
                    <TextBlock x:Name="PlaneDescriptionText" Style="{StaticResource Hint}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Степень p" VerticalAlignment="Center"/>
                        <TextBox x:Name="PBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Порядок полюса q" VerticalAlignment="Center"/>
                        <TextBox x:Name="QBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Re λ" VerticalAlignment="Center"/>
                        <TextBox x:Name="LambdaRealBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Im λ" VerticalAlignment="Center"/>
                        <TextBox x:Name="LambdaImaginaryBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <TextBlock x:Name="FamilyHintText" Style="{StaticResource Hint}"/>
                    <TextBlock Text="Окрашивание" Margin="0,8,0,0"/>
                    <ComboBox x:Name="ColoringBox" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="Плавное время выхода"/><ComboBoxItem Content="Выход: наружу / через полюс"/>
                        <ComboBoxItem Content="Фаза конечной точки"/><ComboBoxItem Content="Ловушка: окружность"/>
                        <ComboBoxItem Content="Ловушка: оси координат"/><ComboBoxItem Content="Периоды и время выхода"/>
                    </ComboBox>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Масштаб цвета" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColorScaleBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Сдвиг цвета · 0…1" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColorOffsetBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Радиус ловушки" VerticalAlignment="Center"/>
                        <TextBox x:Name="TrapRadiusBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Итерации" VerticalAlignment="Center"/>
                        <TextBox x:Name="IterationsBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Радиус выхода ≥ 2" VerticalAlignment="Center"/>
                        <TextBox x:Name="EscapeRadiusBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Макс. период" VerticalAlignment="Center"/>
                        <TextBox x:Name="PeriodBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Допуск периода" VerticalAlignment="Center"/>
                        <TextBox x:Name="ToleranceBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <CheckBox x:Name="CriticalPointsBox" Content="Показать критические точки" Margin="0,8" Click="Markers_OnClick"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Центр X" VerticalAlignment="Center"/>
                        <TextBox x:Name="CenterXBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="View_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Центр Y" VerticalAlignment="Center"/>
                        <TextBox x:Name="CenterYBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="View_OnChanged"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Приближение" VerticalAlignment="Center"/>
                        <TextBox x:Name="ZoomBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" TextChanged="View_OnChanged"/>
                    </Grid>
                    <TextBlock Text="Потоки ЦП"/><ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Сглаживание предпросмотра"/>
                    <ComboBox x:Name="SsaaBox" SelectedIndex="0" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="2×" Tag="2"/><ComboBoxItem Content="4×" Tag="4"/>
                    </ComboBox>
                    <Button Content="Настроить палитру" Click="Palette_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="Saves_OnClick"/>
                    <Button Content="Сохранить изображение" Click="Export_OnClick"/>
                    <UniformGrid Columns="2">
                        <Button Content="Сбросить вид" Margin="0,3,3,3" Click="Reset_OnClick"/>
                        <Button Content="Рендер" Margin="3,3,0,3" Click="Render_OnClick"/>
                    </UniformGrid>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel_OnClick"/>
                    <ProgressBar x:Name="RenderProgress" Height="16" Minimum="0" Maximum="100" Margin="0,8"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Text="Подготовка…"/>
                    <TextBlock x:Name="CoordinateText" Style="{StaticResource Hint}" FontFamily="Consolas"/>
                    <TextBlock Text="Орбита · правая кнопка мыши" Margin="0,6"/>
                    <TextBox x:Name="OrbitText" IsReadOnly="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Колесо: масштаб; левая кнопка: перемещение; двойной щелчок на карте λ: Жюлиа; F11: полный экран. Фон означает, что выход не найден за лимит итераций."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" ClipToBounds="True" Background="Black"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True" SizeChanged="Canvas_OnSizeChanged"
                MouseWheel="Canvas_OnMouseWheel" MouseLeftButtonDown="Canvas_OnMouseDown"
                MouseMove="Canvas_OnMouseMove" MouseLeftButtonUp="Canvas_OnMouseUp"
                LostMouseCapture="Canvas_OnLostMouseCapture" MouseRightButtonDown="Canvas_OnOrbit">
            <Grid>
                <Grid x:Name="SavePreviewLayer" ClipToBounds="True">
                    <Image x:Name="StablePreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="CanvasImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                <Canvas x:Name="OrbitCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                <controls:RenderProgressOverlay x:Name="RenderOverlay" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Button x:Name="ToggleControlsButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
