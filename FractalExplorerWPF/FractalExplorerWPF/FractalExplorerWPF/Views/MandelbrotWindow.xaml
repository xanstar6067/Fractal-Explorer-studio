<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.MandelbrotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Width="1180" Height="760" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/FractalExplorer.ico"
        KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="29"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Margin" Value="0,5,0,3"/></Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ParametersColumn" Width="278"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ParametersBorder" Grid.Column="0" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>

                    <TextBlock Margin="0,14,0,0" Text="Итерации"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="IterationsBox" TextChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Порог выхода"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ThresholdBox" TextChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Приближение"/>
                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ZoomBox" TextChanged="ZoomBox_OnTextChanged"
                             ToolTip="Принимается и научная нотация: 1e500. Колесо мыши — ×1.5 за щелчок, с Ctrl — ×10, с Shift — ×1.05"/>
                    <Button x:Name="NucleusButton" Margin="0,6,0,0" Content="Навести на минимандельброт"
                            Click="NucleusButton_OnClick"
                            ToolTip="Метод Ньютона уточняет центр до ядра ближайшего минимандельброта и подбирает зум под его размер"/>
                    <TextBlock x:Name="NucleusStatusText" Margin="0,4,0,3" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>

                    <StackPanel x:Name="JuliaConstantPanel">
                        <TextBlock Text="Константа C (Re / Im)"/>
                        <UniformGrid Columns="2">
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="JuliaRealBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="JuliaImaginaryBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/>
                        </UniformGrid>
                        <Button Content="Выбрать C на карте" Click="JuliaConstantButton_OnClick"/>
                        <TextBlock Margin="0,5,0,3" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                   Text="Щёлкните по миниатюре, чтобы открыть карту" TextWrapping="Wrap"/>
                        <Border x:Name="JuliaMapPreviewHost" Height="118" Margin="0,0,0,7"
                                Background="Black" BorderThickness="1" CornerRadius="4" ClipToBounds="True"
                                Cursor="Hand" ToolTip="Открыть интерактивную карту выбора C"
                                SizeChanged="JuliaMapPreviewHost_OnSizeChanged"
                                MouseLeftButtonDown="JuliaMapPreviewHost_OnMouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.InteractiveBorderBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.InteractiveHoverBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Image x:Name="JuliaMapPreviewImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                                <Canvas x:Name="JuliaMapMarkerLayer" IsHitTestVisible="False">
                                    <Line x:Name="JuliaMapHorizontalMarker" Stroke="LimeGreen" StrokeThickness="1"/>
                                    <Line x:Name="JuliaMapVerticalMarker" Stroke="LimeGreen" StrokeThickness="1"/>
                                </Canvas>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PowerPanel">
                        <TextBlock Text="Степень"/>
                        <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PowerBox" TextChanged="Parameter_OnChanged"/>
                    </StackPanel>
                    <CheckBox x:Name="InversionBox" Content="Инверсия по горизонтали"
                              Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>

                    <TextBlock Text="Потоки ЦП"/>
                    <ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Сглаживание предпросмотра"/>
                    <ComboBox x:Name="PreviewSsaaBox" SelectedIndex="0" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="1×" Tag="1"/>
                        <ComboBoxItem Content="2×" Tag="2"/>
                        <ComboBoxItem Content="3×" Tag="3"/>
                        <ComboBoxItem Content="4×" Tag="4"/>
                    </ComboBox>
                    <TextBlock Text="Окрашивание"/>
                    <ComboBox x:Name="ColoringModeBox" SelectionChanged="ColoringMode_OnChanged">
                        <ComboBoxItem Content="Дискретное" Tag="Discrete"/>
                        <ComboBoxItem Content="Плавное" Tag="Smooth"/>
                        <ComboBoxItem Content="Гистограмма" Tag="Histogram"/>
                        <ComboBoxItem Content="Орбитальная ловушка" Tag="OrbitTrap"/>
                        <ComboBoxItem Content="Полосатое усреднение" Tag="StripeAverage"/>
                        <ComboBoxItem Content="Smooth Escape (Poly)" Tag="SmoothEscapePolynomial"/>
                        <ComboBoxItem Content="Distance Estimation (псевдо-3D)" Tag="DistanceEstimation"/>
                    </ComboBox>

                    <Expander Header="Параметры окрашивания">
                        <StackPanel Margin="12,6,0,4">
                            <TextBlock Text="Степень смешивания / сдвиг итерации" TextWrapping="Wrap"/>
                            <UniformGrid Columns="2"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="SmoothBlendPowerBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="SmoothIterationOffsetBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Контраст гистограммы"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="HistogramContrastBox" TextChanged="Parameter_OnChanged"/>
                            <CheckBox x:Name="HistogramEqualizationBox" Content="Выравнивание гистограммы" Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                            <CheckBox x:Name="HistogramSmoothInputBox" Content="Плавные значения на входе" Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                            <TextBlock Text="Сила / смещение ловушки"/>
                            <UniformGrid Columns="2"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="OrbitStrengthBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="OrbitBiasBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Частота / сила / смещение полос" TextWrapping="Wrap"/>
                            <UniformGrid Columns="3"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="StripeFrequencyBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="StripeStrengthBox" Margin="3,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="StripeBiasBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Полином A / B / C"/>
                            <UniformGrid Columns="3"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PolyABox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PolyBBox" Margin="3,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PolyCBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Gamma / blend / bias"/>
                            <UniformGrid Columns="3"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PolyGammaBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PolyBlendBox" Margin="3,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PolyBiasBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Фаза / масштаб палитры"/>
                            <UniformGrid Columns="2"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PalettePhaseBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PaletteScaleBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/></UniformGrid>
                            <TextBlock Text="Поведение границ палитры"/>
                            <ComboBox x:Name="PaletteWrapBox" SelectionChanged="Parameter_OnChanged">
                                <ComboBoxItem Content="Повтор"/><ComboBoxItem Content="Ограничение"/><ComboBoxItem Content="Зеркало"/>
                            </ComboBox>
                            <CheckBox x:Name="CustomInteriorBox" Content="Свой цвет внутренней области" Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                            <controls:ColorSelectorControl x:Name="InteriorColorSelector"
                                                           IsEnabled="{Binding IsChecked, ElementName=CustomInteriorBox}"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="DistanceEstimationExpander" Header="Distance Estimation · свет и рельеф"
                              Visibility="Collapsed" IsExpanded="True">
                        <StackPanel Margin="12,6,0,4">
                            <TextBlock Text="Сила рельефа"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceReliefBox" TextChanged="Parameter_OnChanged"/>
                            <TextBlock Text="Азимут / высота света (°)" TextWrapping="Wrap"/>
                            <UniformGrid Columns="2">
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceLightAzimuthBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceLightElevationBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/>
                            </UniformGrid>
                            <TextBlock Text="Ambient / diffuse"/>
                            <UniformGrid Columns="2">
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceAmbientBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceDiffuseBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/>
                            </UniformGrid>
                            <TextBlock Text="Specular / блеск"/>
                            <UniformGrid Columns="2">
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceSpecularBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceShininessBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/>
                            </UniformGrid>
                            <CheckBox x:Name="DistanceContoursBox" Content="Контуры одинакового расстояния"
                                      Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                            <TextBlock Text="Шаг контуров (пикс.) / сила" TextWrapping="Wrap"/>
                            <UniformGrid Columns="2">
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceContourSpacingBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceContourStrengthBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/>
                            </UniformGrid>
                            <TextBlock Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Палитра задаёт цвет рельефа; свет и контуры накладываются поверх неё."/>
                        </StackPanel>
                    </Expander>

                    <Button Content="Настроить палитру" Click="PaletteButton_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="SavesButton_OnClick"/>
                    <Button Content="Сохранить изображение" Click="ExportButton_OnClick"/>
                    <UniformGrid Columns="2">
                        <Button Margin="0,3,3,3" Content="Сбросить вид" Click="ResetButton_OnClick"/>
                        <Button Margin="3,3,0,3" Content="Рендер" Click="RenderButton_OnClick"/>
                    </UniformGrid>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>

                    <TextBlock Margin="0,10,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Прогресс"/>
                    <ProgressBar x:Name="RenderProgress" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap" Text="Готово"/>
                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource Theme.DisabledTextBrush}" TextWrapping="Wrap"
                               Text="Колесо мыши: масштаб. Левая кнопка: перемещение. F11: полноэкранный режим."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button x:Name="ToggleControlsButton" Grid.Column="1"
                Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров"
                Click="ToggleControlsButton_OnClick"/>

        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel"
                MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove"
                MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid>
                <Grid x:Name="ImageLayer" ClipToBounds="True">
                    <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="StablePreviewImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0,0"/>
                    <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                </Grid>
                <controls:RenderProgressOverlay x:Name="RenderOverlay" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
