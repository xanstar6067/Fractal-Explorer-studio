<Window x:Class="FractalExplorerWPF.Views.JuliaGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Width="1160" Height="760" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterOwner" Icon="../Assets/Icons/FractalExplorer.ico"
        Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border x:Name="ControlsHost" Grid.Column="0" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,14,0,0" Text="Диапазон Re(C)"/>
                    <UniformGrid Columns="2">
                        <TextBox x:Name="RealMinBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/>
                        <TextBox x:Name="RealMaxBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/>
                    </UniformGrid>
                    <TextBlock Text="Диапазон Im(C)"/>
                    <UniformGrid Columns="2">
                        <TextBox x:Name="ImaginaryMinBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/>
                        <TextBox x:Name="ImaginaryMaxBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/>
                    </UniformGrid>
                    <TextBlock Text="Столбцы / строки"/>
                    <UniformGrid Columns="2">
                        <TextBox x:Name="ColumnsBox" Margin="0,2,3,7" TextChanged="Parameter_OnChanged"/>
                        <TextBox x:Name="RowsBox" Margin="3,2,0,7" TextChanged="Parameter_OnChanged"/>
                    </UniformGrid>
                    <TextBlock Text="Размер ячейки, px"/>
                    <TextBox x:Name="TileSizeBox" TextChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Итерации"/>
                    <TextBox x:Name="IterationsBox" TextChanged="Parameter_OnChanged"/>
                    <CheckBox x:Name="OpenOnClickBox" Margin="0,4,0,10" IsChecked="True"
                              Content="Открывать фрактал щелчком"/>
                    <Button Content="Настроить палитру" Click="Palette_OnClick"/>
                    <Button Content="Экспортировать галерею" Click="Export_OnClick"/>
                    <Button Content="Перерисовать" Click="Render_OnClick"/>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel_OnClick"/>
                    <TextBlock Margin="0,10,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Прогресс"/>
                    <ProgressBar x:Name="RenderProgress" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                               Text="Готово" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource Theme.DisabledTextBrush}" TextWrapping="Wrap"
                               Text="Изменение параметров запускает автоматический рендер. Щелчок по ячейке открывает её в полноценном окне Жюлиа."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Margin="0,10,10,10" Background="Black"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True">
            <Grid>
                <Image x:Name="GalleryImage" Stretch="Uniform" SnapsToDevicePixels="True"
                       MouseLeftButtonDown="GalleryImage_OnMouseLeftButtonDown"/>
                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontSize="16" Text="Подготовка галереи..."/>
            </Grid>
        </Border>

        <Button x:Name="ToggleControlsButton" Grid.Column="1"
                Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров"
                Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
