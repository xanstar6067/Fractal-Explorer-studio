<Window x:Class="FractalExplorerWPF.Views.CloudConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфликт облачного сохранения" Width="860" Height="520" MinWidth="740" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Сохранение изменено на двух компьютерах" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,14" TextWrapping="Wrap"
                       Text="Сохранить обе: локальная версия станет отдельной копией на ПК и в облаке, а исходная получит актуальную версию сервера. Заменяемый локальный файл отправляется в Корзину."/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock x:Name="LocalTitle" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBox x:Name="LocalData" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="RemoteTitle" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBox x:Name="RemoteData" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
        <WrapPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right">
            <Button Content="Сохранить обе" Click="Both_OnClick" IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="Взять из облака" Click="Cloud_OnClick" Margin="0,0,8,0"/>
            <Button Content="Оставить локальную" Click="Local_OnClick" Margin="0,0,8,0"/>
            <Button Content="Отмена" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
