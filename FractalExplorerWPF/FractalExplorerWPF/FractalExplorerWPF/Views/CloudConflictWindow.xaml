<Window x:Class="FractalExplorerWPF.Views.CloudConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нужно решение — FractalCloud" Width="740" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/Icons/Save.ico"
        Background="{DynamicResource Theme.BaseBackgroundBrush}" Foreground="{DynamicResource Theme.PrimaryTextBrush}">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SideCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>

        <!-- Choice cards: a radio button rendered as a selectable tile. -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
            <Setter Property="GroupName" Value="Choice"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="13,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource Theme.InputBorderBrush}" StrokeThickness="1.5"
                                             Fill="{DynamicResource Theme.ControlBackgroundBrush}"/>
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Theme.AccentForegroundBrush}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Theme.HoverBackgroundBrush}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Theme.InteractiveHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Theme.ControlBackgroundBrush}"/>
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Theme.FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <DockPanel>
            <Border x:Name="KindBadge" Width="42" Height="42" CornerRadius="21" VerticalAlignment="Top"
                    Background="{DynamicResource Theme.WarningSoftBrush}">
                <TextBlock x:Name="KindIcon" FontFamily="{StaticResource IconFont}" FontSize="19" Text="&#xE7BA;"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.WarningBrush}"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SideCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE977;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                        <TextBlock Text="На этом ПК" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="LocalNameText" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LocalMetaText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SideCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE753;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                        <TextBlock Text="В облаке" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="RemoteNameText" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="RemoteMetaText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel x:Name="DifferencesPanel" Margin="0,14,0,0">
            <TextBlock x:Name="DifferencesTitle" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
            <Border Style="{StaticResource SideCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,8,14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Параметр" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="1" Text="На ПК" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="2" Text="В облаке" Style="{StaticResource Caption}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="132" VerticalScrollBarVisibility="Auto" Margin="0,0,4,6">
                        <ItemsControl x:Name="DifferencesList" Margin="14,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Local}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                                   ToolTip="{Binding Local}" FontFamily="Consolas" FontSize="12.5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Remote}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Remote}" FontFamily="Consolas" FontSize="12.5"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Text="Что сделать?" FontWeight="SemiBold" Margin="2,18,0,8"/>
        <RadioButton x:Name="KeepBothOption" Style="{StaticResource ChoiceCard}" Tag="KeepBoth">
            <StackPanel>
                <TextBlock Text="Сохранить обе версии" FontWeight="SemiBold"/>
                <TextBlock x:Name="KeepBothText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Префикс для версии с ПК:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="PrefixBox" Width="180" MaxLength="40" HorizontalAlignment="Left"
                             TextChanged="PrefixBox_OnTextChanged" GotKeyboardFocus="PrefixBox_OnGotKeyboardFocus"/>
                </DockPanel>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="UseLocalOption" Style="{StaticResource ChoiceCard}" Tag="UseLocal">
            <StackPanel>
                <TextBlock Text="Оставить версию с этого ПК" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                           Text="Облачная запись будет перезаписана версией с ПК. Прежнюю облачную версию восстановить нельзя."/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="UseCloudOption" Style="{StaticResource ChoiceCard}" Tag="UseCloud">
            <StackPanel>
                <TextBlock Text="Взять версию из облака" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                           Text="Файл на этом ПК будет заменён облачной версией. Прежний файл и его превью уйдут в Корзину."/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="RestoreOption" Style="{StaticResource ChoiceCard}" Tag="Restore">
            <StackPanel>
                <TextBlock x:Name="RestoreTitle" FontWeight="SemiBold"/>
                <TextBlock x:Name="RestoreText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="SkipOption" Style="{StaticResource ChoiceCard}" Tag="Skip">
            <StackPanel>
                <TextBlock Text="Пропустить" FontWeight="SemiBold"/>
                <TextBlock x:Name="SkipText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </RadioButton>

        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Остановить всё" IsCancel="True" Margin="12,0,0,0"
                        ToolTip="Прервать операцию. Уже выполненные шаги сохранятся."/>
                <Button x:Name="ContinueButton" Content="Продолжить" IsDefault="True" MinWidth="120" Margin="8,0,0,0" Click="Continue_OnClick"/>
            </StackPanel>
            <CheckBox x:Name="ApplyToAllBox" VerticalAlignment="Center">
                <TextBlock x:Name="ApplyToAllText" TextWrapping="Wrap"/>
            </CheckBox>
        </DockPanel>
    </StackPanel>
</Window>
