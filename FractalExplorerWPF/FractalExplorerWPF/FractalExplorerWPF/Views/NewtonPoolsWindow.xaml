<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.NewtonPoolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        Title="Бассейны Ньютона+" Width="1120" Height="700"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/NewtonPool.ico" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ControlsColumn" Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ControlsHost" Grid.Column="0" Margin="10" Padding="14"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Параметры бассейнов"/>

                    <TextBlock Margin="0,14,0,0" Text="Готовая формула"/>
                    <ComboBox x:Name="FormulaPresetBox" SelectionChanged="FormulaPresetBox_OnSelectionChanged"/>

                    <TextBlock Text="Полином / функция f(z)"/>
                    <TextBox x:Name="FormulaBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             ToolTip="Поддерживаются z, i, pi, e, числа, +, −, *, /, ^, sin, cos, tan, exp, log, sqrt и гиперболические функции."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Применить формулу" Click="ApplyFormulaButton_OnClick"/>
                        <Button Grid.Column="1" Margin="6,4,0,4" Content="⚂" ToolTip="Случайная корректная формула"
                                Click="RandomFormulaButton_OnClick"/>
                    </Grid>

                    <Expander Margin="0,8,0,4" Header="Поиск и корни" IsExpanded="True">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="Стратегия поиска"/>
                            <ComboBox x:Name="RootSearchModeBox" SelectedIndex="0"
                                      SelectionChanged="RootSearchModeBox_OnSelectionChanged">
                                <ComboBoxItem Content="Авто: полином / адаптивно"/>
                                <ComboBoxItem Content="Всегда адаптивный"/>
                                <ComboBoxItem Content="Только вручную"/>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Точность корней"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RootToleranceBox" Text="1e-6"/></StackPanel>
                            </Grid>
                            <Grid x:Name="RootSearchRadiusPanel">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Радиус поиска"
                                           ToolTip="Поиск выполняется вокруг точки 0 + 0i"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RootSearchRadiusBox" Text="8"
                                         ToolTip="Радиус области поиска вокруг точки 0 + 0i"/></StackPanel>
                            </Grid>
                            <Button Content="Повторить поиск корней" Click="FindRootsButton_OnClick"/>

                            <TextBlock x:Name="RootCountText" Margin="0,5,0,5"
                                       Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Найдено корней: 0"/>
                            <ListBox x:Name="RootListBox" Height="86" Margin="0,0,0,4"/>
                            <TextBlock Text="Ручной корень"/>
                            <TextBox x:Name="ManualRootBox" ToolTip="Например: 1+2*i или -0.5*i"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Margin="0,0,3,4" Content="Добавить" Click="AddRootButton_OnClick"/>
                                <Button Grid.Column="1" Margin="3,0,0,4" Content="Удалить" Click="RemoveRootButton_OnClick"/>
                            </Grid>

                            <TextBlock Margin="0,4,0,0" Text="Отображение корней"/>
                            <ComboBox x:Name="RootDisplayModeBox" SelectedIndex="0"
                                      SelectionChanged="RootDisplayModeBox_OnSelectionChanged">
                                <ComboBoxItem Content="Скрыть"/>
                                <ComboBoxItem Content="Маркеры"/>
                                <ComboBoxItem Content="Маркеры и координаты"/>
                            </ComboBox>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,4" Header="Диагностическая раскраска">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="Режим отображения"/>
                            <ComboBox x:Name="DiagnosticColoringBox" SelectedIndex="0"
                                      SelectionChanged="DiagnosticColoringBox_OnSelectionChanged">
                                <ComboBoxItem Content="Выключена — обычные бассейны"/>
                                <ComboBoxItem Content="Исход орбиты"/>
                                <ComboBoxItem Content="Только циклы периода 2–8"/>
                                <ComboBoxItem Content="Остаток |f(z)|"/>
                                <ComboBoxItem Content="Фаза последнего f(z)"/>
                            </ComboBox>
                            <TextBlock x:Name="DiagnosticModeHint"
                                       Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>

                    <TextBlock Margin="0,8,0,0" Text="Метод итерации"/>
                    <ComboBox x:Name="MethodBox" SelectionChanged="MethodBox_OnSelectionChanged">
                        <ComboBoxItem Content="Newton"/>
                        <ComboBoxItem Content="Halley"/>
                        <ComboBoxItem Content="Householder"/>
                        <ComboBoxItem Content="Relaxed Newton"/>
                    </ComboBox>

                    <Grid x:Name="HouseholderOrderPanel">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Порядок Householder"/>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="HouseholderOrderBox" Text="3" TextChanged="Parameter_OnChanged"/></StackPanel>
                    </Grid>

                    <StackPanel x:Name="RelaxedNewtonPanel" Margin="0,2,0,4">
                        <TextBlock Text="Плоскость Relaxed Newton"/>
                        <ComboBox x:Name="RelaxedPlaneModeBox" SelectedIndex="0"
                                  SelectionChanged="RelaxedPlaneModeBox_OnSelectionChanged">
                            <ComboBoxItem Content="Плоскость z — λ фиксирована"/>
                            <ComboBoxItem Content="Плоскость λ — z₀ фиксировано"/>
                        </ComboBox>

                        <StackPanel x:Name="RelaxationPanel">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Re λ"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RelaxationRealBox" Text="1" TextChanged="Parameter_OnChanged"/></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Im λ"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RelaxationImaginaryBox" Text="0" TextChanged="Parameter_OnChanged"/></StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="FixedInitialZPanel">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Re z₀"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="FixedInitialZRealBox" Text="0.5" TextChanged="Parameter_OnChanged"/></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Im z₀"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="FixedInitialZImaginaryBox" Text="0.5" TextChanged="Parameter_OnChanged"/></StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="RelaxedPlaneHint"
                                   Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Итерации"/>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="IterationsBox" Text="500" TextChanged="Parameter_OnChanged"/></StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Приближение"/>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ZoomBox" Text="1" TextChanged="ZoomBox_OnTextChanged" ToolTip="Число или научная нотация, например 1e300; до 1e1000"/></StackPanel>
                    </Grid>

                    <TextBlock Text="Потоки ЦП"/>
                    <ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>

                    <TextBlock Text="Сглаживание предпросмотра"/>
                    <ComboBox x:Name="PreviewSsaaBox" SelectedIndex="0" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="1×" Tag="1"/>
                        <ComboBoxItem Content="2×" Tag="2"/>
                        <ComboBoxItem Content="3×" Tag="3"/>
                        <ComboBoxItem Content="4×" Tag="4"/>
                    </ComboBox>

                    <Button Content="Запустить рендер" Click="RenderButton_OnClick"/>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>
                    <Button Content="Настроить палитру" Click="PaletteButton_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="SavesButton_OnClick"/>
                    <Button Content="Сохранить изображение" Click="ExportButton_OnClick"/>

                    <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Прогресс"/>
                    <ProgressBar x:Name="RenderProgress" Height="20" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap" Text="Готово"/>

                    <Expander Margin="0,12,0,0" Header="Производные и диагностика">
                        <TextBox x:Name="DebugOutput" Margin="0,6,0,0" MinHeight="110" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Expander>
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Theme.DisabledTextBrush}"
                               TextWrapping="Wrap" Text="Колесо мыши: масштаб (Ctrl — ×10, Shift — точно), глубокий зум до 1e1000. Левая кнопка: перемещение. F11: полноэкранный режим."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" ClipToBounds="True"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True" SizeChanged="CanvasHost_OnSizeChanged"
                MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid>
                <Grid x:Name="ImageLayer" ClipToBounds="True">
                    <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="StablePreviewImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                </Grid>
                <Canvas x:Name="RootOverlay" ClipToBounds="True" IsHitTestVisible="False"/>
                <controls:RenderProgressOverlay x:Name="RenderOverlay" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Button x:Name="ToggleControlsButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров" Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
