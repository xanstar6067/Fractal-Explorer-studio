<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.FlameTransformEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трансформации фрактального пламени" Width="980" Height="640" MinWidth="820" MinHeight="540" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Margin="10,10,5,10" Padding="10" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,8"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Трансформации"/><TextBlock x:Name="TotalWeightText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                <ListBox x:Name="TransformList" Grid.Row="1" SelectionChanged="TransformList_OnSelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Border Margin="0,2" Padding="9" CornerRadius="5" Background="{DynamicResource Theme.ControlBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <Border Width="14" Height="14" CornerRadius="7" VerticalAlignment="Top" Background="{Binding Color}"/>
                            <StackPanel Grid.Column="1" Margin="7,0"><TextBlock FontWeight="SemiBold" Text="Трансформация"/><TextBlock Foreground="{DynamicResource Theme.SecondaryTextBrush}"><Run Text="{Binding Variation}"/><Run Text=" · вес "/><Run Text="{Binding Weight, StringFormat=F3}"/></TextBlock><ProgressBar Margin="0,5,0,0" Height="4" Maximum="10" Value="{Binding Weight}"/></StackPanel>
                            <Button Grid.Column="2" Width="26" Height="30" Padding="0" Content="×" ToolTip="Удалить" CommandParameter="{Binding}" Click="Delete_OnClick"/>
                        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="2" Margin="0,8,0,0" Content="+ Добавить трансформацию" Click="Add_OnClick"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Margin="5,10,10,10" Padding="16" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <Grid x:Name="EditorPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="EditorTitle" FontSize="19" FontWeight="SemiBold" Text="Редактор трансформации"/>
                <TabControl Grid.Row="1" Margin="0,10,0,0">
                    <TabItem Header="Параметры"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Вариация"/><ComboBox x:Name="VariationBox" Grid.Column="1" SelectionChanged="Editor_OnChanged"/></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Цвет"/><Button x:Name="ColorButton" Grid.Column="1" Height="36" Click="Color_OnClick"><Border x:Name="ColorPreview" Height="20" CornerRadius="4"/></Button></Grid>
                        <TextBlock Margin="0,14,0,4" Text="Вес трансформации"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Slider x:Name="WeightSlider" Maximum="10" TickFrequency=".5" ValueChanged="Weight_OnChanged"/><TextBlock x:Name="WeightText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="WeightPercentText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <Separator Margin="0,14"/><TextBlock FontWeight="SemiBold" Text="Аффинное преобразование"/><TextBlock Margin="0,3,0,10" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="x′ = a·x + b·y + c        y′ = d·x + e·y + f"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock HorizontalAlignment="Center" Text="a"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="b"/><TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="c"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ABox" Grid.Row="1" Margin="3" TextChanged="Editor_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="BBox" Grid.Row="1" Grid.Column="1" Margin="3" TextChanged="Editor_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CBox" Grid.Row="1" Grid.Column="2" Margin="3" TextChanged="Editor_OnChanged"/>
                            <TextBlock Grid.Row="2" HorizontalAlignment="Center" Text="d"/><TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Text="e"/><TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" Text="f"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DBox" Grid.Row="3" Margin="3" TextChanged="Editor_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="EBox" Grid.Row="3" Grid.Column="1" Margin="3" TextChanged="Editor_OnChanged"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="FBox" Grid.Row="3" Grid.Column="2" Margin="3" TextChanged="Editor_OnChanged"/>
                        </Grid>
                        <Border Margin="0,14,0,0" Padding="10" CornerRadius="5" Background="{DynamicResource Theme.ControlBackgroundBrush}"><TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Совет: a=e=0.5, b=d=0 — равномерное сжатие. Поворот: a=cos θ, b=−sin θ, d=sin θ, e=cos θ."/></Border>
                    </StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="Матрица"><StackPanel Margin="18"><TextBlock FontSize="15" FontWeight="SemiBold" Text="Матрица текущей трансформации"/><Border Margin="0,16" Padding="22" Background="{DynamicResource Theme.ControlBackgroundBrush}" CornerRadius="6"><TextBlock x:Name="MatrixText" FontFamily="Consolas" FontSize="18" TextAlignment="Center"/></Border><TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Первые две строки задают линейную часть и перенос. Вариация применяется после аффинного преобразования."/></StackPanel></TabItem>
                </TabControl>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="10,7" Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,1,0,0"><DockPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UndoButton" Width="145" Content="Отменить действие" IsEnabled="False" Click="Undo_OnClick"/>
                <Button x:Name="RandomizeButton" Width="155" Content="Сделать случайно" Click="Randomize_OnClick"/>
                <ToggleButton x:Name="RandomSettingsButton" Width="38" Margin="4,0,0,0" Padding="0" Content="⚙" FontSize="17"
                              Style="{StaticResource ThemeToggleButtonStyle}" ToolTip="Настроить случайную генерацию"/>
                <Popup x:Name="RandomSettingsPopup" PlacementTarget="{Binding ElementName=RandomSettingsButton}" Placement="Top" VerticalOffset="-7"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=RandomSettingsButton, Mode=TwoWay}" Closed="RandomSettingsPopup_OnClosed">
                    <Border Width="430" Padding="16" CornerRadius="7" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Настройка рандома"/>
                            <TextBlock Margin="0,3,0,13" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Каждая трансформация — отдельный слой Flame. Диапазон 5–5 всегда создаёт ровно пять слоёв."/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Количество: от"/>
                                <ComboBox x:Name="MinimumTransformCountBox" Grid.Column="1" Margin="8,0" SelectionChanged="RandomCount_OnChanged"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="до"/>
                                <ComboBox x:Name="MaximumTransformCountBox" Grid.Column="3" Margin="8,0" SelectionChanged="RandomCount_OnChanged"/>
                                <TextBlock x:Name="RandomCountHintText" Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                            </Grid>

                            <Separator Margin="0,14"/>
                            <DockPanel Margin="0,0,0,7">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Width="58" Height="28" Padding="4,2" Content="Все" Click="SelectAllVariations_OnClick"/>
                                    <Button Width="78" Height="28" Padding="4,2" Content="Снять все" Click="ClearVariations_OnClick"/>
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Допустимые вариации"/>
                            </DockPanel>
                            <UniformGrid x:Name="RandomVariationPanel" Columns="2"/>
                            <TextBlock x:Name="RandomSettingsValidationText" Margin="0,9,0,0" Foreground="{DynamicResource Theme.AccentSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RandomSettingsSummaryText" Margin="0,7,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal"><Button Width="95" Content="Отмена" IsCancel="True"/><Button Width="105" Content="Применить" Click="Apply_OnClick"/><Button Width="105" Content="Готово" Click="Done_OnClick"/></StackPanel>
        </DockPanel></Border>
    </Grid>
</Window>
