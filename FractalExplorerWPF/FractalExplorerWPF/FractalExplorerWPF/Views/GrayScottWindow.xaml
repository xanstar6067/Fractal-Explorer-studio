<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.GrayScottWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Gray–Scott reaction–diffusion" Width="1180" Height="780" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="330"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Gray–Scott reaction–diffusion"/>
                    <TextBlock Margin="0,3,0,10" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Двухкомпонентная пространственная система"/>

                    <TextBlock Margin="0,0,0,3" Text="Готовый режим"/>
                    <ComboBox x:Name="PresetBox" SelectionChanged="Preset_OnChanged"/>
                    <TextBlock x:Name="PresetHint" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>

                    <GroupBox Header="Поиск узоров" Margin="0,10,0,0">
                        <StackPanel Margin="7">
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Что искать"/>
                                <ComboBox x:Name="SearchTargetBox" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Что искать">
                                    <ComboBoxItem Content="Любой узор"/><ComboBoxItem Content="Пятна"/><ComboBoxItem Content="Нити и лабиринты"/>
                                    <ComboBoxItem Content="Сетка с отверстиями"/><ComboBoxItem Content="Подвижный узор"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="SearchPaletteBox" Margin="0,5,0,0" Content="Подбирать палитру"/>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button x:Name="SearchButton" Margin="0,0,3,0" Content="Случайный узор" Click="SearchRandom_OnClick" ToolTip="Новые F/K и затравка; каждый вариант проверяется пробным прогоном"/>
                                <Button x:Name="VariationButton" Margin="3,0,0,0" Content="Вариация" Click="SearchVariation_OnClick" ToolTip="Немного сдвинуть F/K текущего узора, затравку оставить"/>
                            </UniformGrid>
                            <Button x:Name="SearchUndoButton" Margin="0,5,0,0" Content="Вернуть предыдущий" Click="SearchUndo_OnClick" IsEnabled="False" ToolTip="Вернуть поле и параметры до последнего найденного узора"/>
                            <TextBlock x:Name="SearchStatus" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                                       Text="F и K выбираются в полосе карты Пирсона, где живут узоры. Каждый вариант сначала проходит короткий пробный прогон: пустые и однородные поля отбрасываются."
                                       Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Вычисления и качество" Margin="0,10,0,0">
                        <StackPanel Margin="7">
                            <ComboBox x:Name="BackendBox" SelectionChanged="Backend_OnChanged" AutomationProperties.Name="Движок Gray–Scott">
                                <ComboBoxItem Content="ГП — рекомендуется"/><ComboBoxItem Content="ЦП — совместимый вариант"/>
                            </ComboBox>
                            <TextBlock x:Name="BackendHint" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,4,0,8"/>
                            <TextBlock Text="Сетка симуляции · 32–2048" Margin="0,0,0,3"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Применить" Click="GridSize_OnApply" ToolTip="Перенести концентрации на новую сетку без перезапуска"/>
                                <TextBox x:Name="GridSizeBox" Margin="0,0,5,0" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" AutomationProperties.Name="Размер сетки"/>
                            </DockPanel>
                            <TextBlock x:Name="GridSizeError" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                            <TextBlock Text="Сетка задаёт детали узора. При смене размера текущее поле переносится, номер шага сохраняется." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,5,0,8"/>
                            <Expander Header="Буфер изображения" IsExpanded="True">
                                <StackPanel Margin="0,7,0,0">
                                    <CheckBox x:Name="AutoFrameBox" Click="FrameSize_OnApply"><TextBlock Text="Автоматически — по области показа" TextWrapping="Wrap"/></CheckBox>
                                    <TextBlock x:Name="FrameSizeHint" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,4,0,5"/>
                                    <Grid x:Name="FrameSizeInputs"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="FrameWidthBox" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" AutomationProperties.Name="Ширина буфера"/>
                                        <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="FrameHeightBox" Grid.Column="2" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" AutomationProperties.Name="Высота буфера"/>
                                        <Button Grid.Column="3" Content="✓" Click="FrameSize_OnApply" Margin="4,0,0,0" ToolTip="Применить размер буфера"/>
                                    </Grid>
                                    <TextBlock x:Name="FrameSizeError" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                    <TextBlock Text="Буфер задаёт чёткость показа. Авто учитывает DPI; ручной размер сохраняет пропорции поля." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,10,0,0" Header="Уравнение">
                        <StackPanel Margin="7">
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Диффузия U"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DiffusionUBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Диффузия V"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DiffusionVBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Подача F"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="FeedBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Удаление K"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="KillBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Шаг времени Δt"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DeltaTimeBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,8,0,0" Header="Затравка и кисть">
                        <StackPanel Margin="7">
                            <TextBlock Margin="0,5,0,3" Text="Начальное состояние"/>
                            <ComboBox x:Name="SeedModeBox" SelectionChanged="Parameter_OnChanged">
                                <ComboBoxItem Content="Квадрат в центре"/><ComboBoxItem Content="Случайные пятна"/>
                                <ComboBoxItem Content="Кольцо"/><ComboBoxItem Content="Шум по полю"/>
                            </ComboBox>
                            <Grid Margin="0,5,0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Число пятен"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="SeedCountBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Радиус затравки"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="SeedRadiusBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Seed генератора"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="RandomSeedBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Радиус кисти"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="BrushRadiusBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,8,0,0" Header="Анимация и цвет">
                        <StackPanel Margin="7">
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Шагов на кадр"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="StepsPerFrameBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Целевая частота"/><ComboBox x:Name="TargetFpsBox" Grid.Column="1" SelectionChanged="TargetFps_OnChanged"><ComboBoxItem Tag="30" Content="30 FPS"/><ComboBoxItem Tag="60" Content="60 FPS"/></ComboBox></Grid>
                            <TextBlock Text="Скорость развития задают шаги на кадр. FPS задаёт плавность показа. Правки скорости применяются при перезапуске." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,4,0,5"/>
                            <TextBlock Margin="0,5,0,3" Text="Отображаемое поле"/>
                            <ComboBox x:Name="FieldModeBox" SelectionChanged="Appearance_OnChanged"><ComboBoxItem Content="Концентрация V"/><ComboBoxItem Content="Концентрация U"/><ComboBoxItem Content="Разность U − V"/></ComboBox>
                            <Grid Margin="0,5,0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Минимум диапазона"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RangeMinimumBox" Grid.Column="1" TextChanged="Appearance_OnChanged"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Максимум диапазона"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RangeMaximumBox" Grid.Column="1" TextChanged="Appearance_OnChanged"/></Grid>
                            <CheckBox x:Name="ReversePaletteBox" Margin="0,5,0,2" Content="Инвертировать палитру" Click="PaletteMapping_OnChanged"/>
                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                <Button Content="Палитры Gray–Scott…" Click="Palette_OnClick"/>
                                <Border x:Name="PalettePreview" Grid.Column="1" Margin="5" Height="25" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" theme:ThemeContract.IgnoreAudit="True"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <TextBlock x:Name="PendingText" Margin="0,8,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Параметры изменены — примените их" Visibility="Collapsed"/>
                    <Button x:Name="ResetButton" Margin="0,6,0,0" Content="Применить и перезапустить" Click="Reset_OnClick"/>
                    <Button Content="Новая случайная затравка" Click="Randomize_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="Saves_OnClick"/>
                    <Button Content="Сохранить текущий кадр" Click="Export_OnClick"/>
                    <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Подготовка симуляции…"/>
                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.DisabledTextBrush}"
                               Text="ЛКМ по полю добавляет затравку. Сетка замкнута по краям. Частота 30/60 FPS является целевой и автоматически ограничивается скоростью расчёта."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" ClipToBounds="True"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True"
                MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid>
                <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="FrameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,12,12,12" Padding="3" CornerRadius="5" Background="#B0000000">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RunButton" Content="Пауза" MinWidth="90" Click="RunPause_OnClick" ToolTip="Остановить или продолжить развитие · Пробел"/>
                        <Button x:Name="StepButton" Content="Один кадр" Click="Step_OnClick" ToolTip="Выполнить выбранное число шагов на паузе"/>
                    </StackPanel>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000">
                    <TextBlock x:Name="FrameBadgeText" Foreground="White" Text="0 FPS · шаг 0"/>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,6" CornerRadius="5" Background="#90000000">
                    <TextBlock Foreground="White" Text="ЛКМ — добавить затравку"/>
                </Border>
            </Grid>
        </Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕"
                ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
