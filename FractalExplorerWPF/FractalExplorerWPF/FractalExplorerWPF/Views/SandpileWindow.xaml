<Window x:Class="FractalExplorerWPF.Views.SandpileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Абелева песочная куча" Width="1200" Height="850" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" CornerRadius="7"
                Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Абелева песочная куча" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Из простого правила — фрактальная мозаика" TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <ComboBox x:Name="PresetBox" SelectionChanged="Preset_OnChanged" ToolTip="Готовые начальные состояния. Выбор начинает новую симуляцию."/>
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button x:Name="RunButton" Content="Пауза" Click="Run_OnClick" Margin="0,0,3,0"/>
                        <Button x:Name="StepButton" Content="Одна порция" Click="Step_OnClick" Margin="3,0,0,0" ToolTip="Обработать одну порцию активных клеток на паузе."/>
                    </UniformGrid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Header="Новое поле">
                            <StackPanel Margin="8">
                                <TextBlock Text="Решётка" Margin="0,0,0,3"/>
                                <ComboBox x:Name="LatticeBox">
                                    <ComboBoxItem Content="Квадратная · 4 соседа"/>
                                    <ComboBoxItem Content="Треугольная · 6 соседей"/>
                                </ComboBox>
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Размер поля" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SizeBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True" ToolTip="Нечётное число от 33 до 513. Песок за краем поля теряется."/>
                                </Grid>
                                <ComboBox x:Name="SeedBox" Margin="0,7,0,0">
                                    <ComboBoxItem Content="Одна куча в центре"/><ComboBoxItem Content="Четыре кучи"/>
                                    <ComboBoxItem Content="Переполненное поле"/><ComboBoxItem Content="Пустое поле"/>
                                </ComboBox>
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Всего песчинок" VerticalAlignment="Center"/>
                                    <TextBox x:Name="InitialBox" Grid.Column="1" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True" ToolTip="0–10 000 000, суммарно для одной или четырёх куч. Переполненное поле получает 4 или 6 песчинок в каждой клетке."/>
                                </Grid>
                                <Button x:Name="ResetButton" Content="Создать новое поле" Click="Reset_OnClick" Margin="0,8,0,0"/>
                                <TextBlock Text="Эти параметры применяются при создании поля." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Подсыпка и скорость" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Песчинок на клетку" VerticalAlignment="Center"/>
                                    <TextBox x:Name="BrushGrainsBox" Grid.Column="1" TextChanged="LiveOptions_OnChanged" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True"/>
                                </Grid>
                                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Радиус кисти" VerticalAlignment="Center"/>
                                    <TextBox x:Name="BrushRadiusBox" Grid.Column="1" TextChanged="LiveOptions_OnChanged" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True" ToolTip="0 — одна клетка; максимум 20."/>
                                </Grid>
                                <Button Content="Подсыпать в центр" Click="AddCenter_OnClick"/>
                                <CheckBox x:Name="AutoDropBox" Content="Подсыпать после каждой лавины" Click="LiveOptions_OnChanged" Margin="0,6,0,0"/>
                                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Автоподсыпка" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DropBox" Grid.Column="1" TextChanged="LiveOptions_OnChanged" controls:NumericSpinner.IsEnabled="True" controls:NumericSpinner.IsInteger="True" ToolTip="Песчинок в центр после стабилизации предыдущей лавины."/>
                                </Grid>
                                <TextBlock Text="Скорость · клеток за кадр" Margin="0,8,0,0"/>
                                <Slider x:Name="SpeedSlider" Minimum="1000" Maximum="500000" TickFrequency="1000" IsSnapToTickEnabled="True" ValueChanged="Speed_OnChanged"/>
                                <TextBlock Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:N0}}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Окраска" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <ComboBox x:Name="ColoringBox" SelectionChanged="Appearance_OnChanged">
                                    <ComboBoxItem Content="По числу песчинок"/><ComboBoxItem Content="По числу обрушений"/><ComboBoxItem Content="Активная лавина"/>
                                </ComboBox>
                                <ComboBox x:Name="PaletteBox" SelectionChanged="Palette_OnChanged" Margin="0,6,0,0"/>
                                <UniformGrid x:Name="ColorButtons" Columns="3" Margin="0,6,0,0"/>
                                <TextBlock Text="Оранжевый отмечает неустойчивые клетки." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                            </StackPanel>
                        </GroupBox>
                        <Button Content="Вместить поле" Click="Fit_OnClick"/>
                        <Button x:Name="SavesButton" Content="Менеджер сохранений" Click="Saves_OnClick"/>
                        <Button x:Name="ExportButton" Content="Экспорт текущего поля" Click="Export_OnClick"/>
                        <TextBlock x:Name="RuleText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                        <TextBlock x:Name="StatusText" Text="Подготовка поля…" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" CornerRadius="7" ClipToBounds="True"
                Background="#080F20" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" theme:ThemeContract.IgnoreAudit="True"
                MouseDown="Canvas_OnMouseDown" MouseUp="Canvas_OnMouseUp" MouseMove="Canvas_OnMouseMove"
                MouseWheel="Canvas_OnMouseWheel" LostMouseCapture="Canvas_OnLostCapture" SizeChanged="Canvas_OnSizeChanged">
            <Grid>
                <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="FrameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000" IsHitTestVisible="False">
                    <TextBlock x:Name="MassText" Foreground="White" Text="Подготовка…"/>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000" IsHitTestVisible="False">
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="ЛКМ — песок · ПКМ — перемещение · колесо — масштаб · пробел — пауза"/>
                </Border>
            </Grid>
        </Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
