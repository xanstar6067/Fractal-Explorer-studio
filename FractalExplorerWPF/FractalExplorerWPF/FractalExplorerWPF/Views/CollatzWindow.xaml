<Window x:Class="FractalExplorerWPF.Views.CollatzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        Title="Фрактал Коллатца" Width="1120" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6,3"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4,0,4"/></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Параметры Коллатца"/>
                    <TextBlock Margin="0,12,0,0" Text="Вариация формулы"/>
                    <ComboBox x:Name="VariationBox" SelectionChanged="VariationBox_OnSelectionChanged">
                        <ComboBoxItem Content="Стандартная (cos)"/>
                        <ComboBoxItem Content="Синусная арт-вариация (sin)"/>
                        <ComboBoxItem Content="Ветви 1 / (p−1)n (арт)"/>
                        <ComboBoxItem Content="Обобщённая Cₚ: n/2, pn+1"/>
                        <ComboBoxItem Content="Семейство C(p,q) (+q·sin πz)"/>
                    </ComboBox>
                    <TextBlock x:Name="VariationHintText" Margin="0,0,0,7"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <Grid x:Name="PParameterPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Параметр p"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox x:Name="PParameterBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                    </Grid>
                    <StackPanel x:Name="QParameterPanel">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Re(q)"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox x:Name="QRealParameterBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Im(q)"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox x:Name="QImaginaryParameterBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                        </Grid>
                    </StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Итерации"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox x:Name="IterationsBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Порог выхода"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox x:Name="ThresholdBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Приближение"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox x:Name="ZoomBox" TextChanged="ZoomBox_OnChanged"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Потоки ЦП"/><ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Сглаживание предпросмотра"/>
                    <ComboBox x:Name="SsaaBox" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="Выкл. (1×)" Tag="1"/><ComboBoxItem Content="Низкое (2×)" Tag="2"/><ComboBoxItem Content="Высокое (4×)" Tag="4"/>
                    </ComboBox>
                    <TextBlock Text="Режим окрашивания"/>
                    <ComboBox x:Name="ColoringModeBox" SelectionChanged="ColoringMode_OnSelectionChanged">
                        <ComboBoxItem Content="Escape Time"/>
                        <ComboBoxItem Content="Final Argument"/>
                        <ComboBoxItem Content="Final Magnitude"/>
                        <ComboBoxItem Content="Cycle Basins"/>
                        <ComboBoxItem Content="Integer Trap"/>
                        <ComboBoxItem Content="Real Axis Trap"/>
                        <ComboBoxItem Content="Orbit Density"/>
                        <ComboBoxItem Content="Period Detection"/>
                    </ComboBox>
                    <TextBlock x:Name="ColoringDescriptionText" Margin="0,0,0,5"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <Expander x:Name="ColoringParametersExpander" Header="Параметры окрашивания" IsExpanded="True" Margin="0,2,0,7">
                        <StackPanel Margin="12,6,0,2">
                            <StackPanel x:Name="EscapeColoringPanel">
                                <TextBlock Text="Расчёт Escape Time"/>
                                <ComboBox x:Name="EscapeSmoothingBox" SelectionChanged="Parameter_OnChanged">
                                    <ComboBoxItem Content="Дискретный"/><ComboBoxItem Content="Плавный"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="ArgumentColoringPanel">
                                <TextBlock Text="Обороты палитры по аргументу" TextWrapping="Wrap"/>
                                <TextBox x:Name="ArgumentCyclesBox" TextChanged="Parameter_OnChanged"/>
                            </StackPanel>
                            <StackPanel x:Name="MagnitudeColoringPanel">
                                <TextBlock Text="Масштаб log(1+|z|)"/>
                                <TextBox x:Name="MagnitudeScaleBox" TextChanged="Parameter_OnChanged"/>
                            </StackPanel>
                            <StackPanel x:Name="TrapColoringPanel">
                                <TextBlock Text="Чувствительность ловушки"/>
                                <TextBox x:Name="TrapScaleBox" TextChanged="Parameter_OnChanged"/>
                            </StackPanel>
                            <StackPanel x:Name="CycleColoringPanel">
                                <TextBlock Text="Допуск обнаружения цикла"/>
                                <TextBox x:Name="CycleToleranceBox" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Text="Максимальный период"/>
                                <TextBox x:Name="MaximumPeriodBox" TextChanged="Parameter_OnChanged"/>
                            </StackPanel>
                            <StackPanel x:Name="DensityColoringPanel">
                                <TextBlock Text="Экспозиция плотности"/>
                                <TextBox x:Name="DensityExposureBox" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Text="Шаг начальных точек (1–8)" TextWrapping="Wrap"/>
                                <TextBox x:Name="DensitySampleStepBox" TextChanged="Parameter_OnChanged"/>
                                <CheckBox x:Name="DensityEscapedOnlyBox" Margin="0,3,0,7"
                                          Content="Только вышедшие орбиты"
                                          Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                            </StackPanel>
                            <Separator Margin="0,3,0,8"/>
                            <TextBlock Text="Заполнение внутренней области" TextWrapping="Wrap"/>
                            <ComboBox x:Name="InteriorFillModeBox"
                                      SelectionChanged="InteriorFillMode_OnSelectionChanged">
                                <ComboBoxItem Content="По режиму окрашивания"/>
                                <ComboBoxItem Content="Авто (фон палитры)"/>
                                <ComboBoxItem Content="Чёрный"/>
                                <ComboBoxItem Content="Белый"/>
                                <ComboBoxItem Content="Свой цвет"/>
                            </ComboBox>
                            <controls:ColorSelectorControl x:Name="CustomInteriorColorSelector"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                        </StackPanel>
                    </Expander>
                    <Button Content="Запустить рендер" Click="RenderButton_OnClick"/>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>
                    <Button Content="Настроить палитру" Click="PaletteButton_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="SavesButton_OnClick"/>
                    <Button Content="Сохранить изображение" Click="ExportButton_OnClick"/>
                    <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Прогресс"/>
                    <ProgressBar x:Name="RenderProgress" Height="20" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap" Text="Готово"/>
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Theme.DisabledTextBrush}" TextWrapping="Wrap"
                               Text="Колесо мыши: масштаб. Левая кнопка: перемещение. F11: полноэкранный режим."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" ClipToBounds="True"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True" SizeChanged="CanvasHost_OnSizeChanged"
                MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid>
                <Grid ClipToBounds="True">
                    <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="StablePreviewImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                </Grid>
                <controls:RenderProgressOverlay x:Name="RenderOverlay" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Button x:Name="ToggleControlsButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров" Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
