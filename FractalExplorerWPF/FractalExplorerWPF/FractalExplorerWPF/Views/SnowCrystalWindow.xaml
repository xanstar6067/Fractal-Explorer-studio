<Window x:Class="FractalExplorerWPF.Views.SnowCrystalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Рост снежных кристаллов" Width="1180" Height="820" MinWidth="930" MinHeight="650"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="330"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" CornerRadius="7"
                Background="{DynamicResource Theme.PanelBackgroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Снежные кристаллы" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="От ледяной затравки до снежинки" Margin="0,3,0,12" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock Text="Готовая форма" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PresetBox" SelectionChanged="Preset_OnChanged"/>
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button x:Name="RunButton" Content="Пауза" Click="Run_OnClick" Margin="0,0,3,0"/>
                        <Button x:Name="StepButton" Content="Один шаг" Click="Step_OnClick" Margin="3,0,0,0"/>
                    </UniformGrid>
                    <Button x:Name="ResetButton" Content="Новый рост" Click="Reset_OnClick"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="Условия роста" Margin="0,10,0,0">
                        <StackPanel Margin="8">
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Диффузия пара α" VerticalAlignment="Center"/>
                                <TextBox x:Name="DiffusionBox" Grid.Column="1" TextChanged="Conditions_OnChanged" numeric:NumericSpinner.IsEnabled="True" ToolTip="Перенос водяного пара между соседними ячейками: 0,05–2."/>
                            </Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Насыщенность β" VerticalAlignment="Center"/>
                                <TextBox x:Name="VaporBox" Grid.Column="1" TextChanged="Conditions_OnChanged" numeric:NumericSpinner.IsEnabled="True" ToolTip="Запас пара в начале и на границе поля: 0–0,99."/>
                            </Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Осаждение γ" VerticalAlignment="Center"/>
                                <TextBox x:Name="DepositionBox" Grid.Column="1" TextChanged="Conditions_OnChanged" numeric:NumericSpinner.IsEnabled="True" ToolTip="Добавление массы к поверхности кристалла на каждом шаге: 0–0,05."/>
                            </Grid>
                            <Button x:Name="ApplyButton" Content="Изменить условия роста" Margin="0,7,0,0" Click="Apply_OnClick"/>
                            <TextBlock x:Name="PendingText" Text="Новые условия ещё не применены" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Поле и скорость" Margin="0,8,0,0">
                        <StackPanel Margin="8">
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Радиус поля" VerticalAlignment="Center"/>
                                <TextBox x:Name="RadiusBox" Grid.Column="1" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" ToolTip="32–320 ячеек от центра до границы. Применяется при новом росте."/>
                            </Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Радиус затравки" VerticalAlignment="Center"/>
                                <TextBox x:Name="SeedRadiusBox" Grid.Column="1" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" ToolTip="0 — одна ячейка; 1–8 — маленький шестиугольник. Применяется при новом росте."/>
                            </Grid>
                            <TextBlock Text="Скорость · шагов на кадр" Margin="0,7,0,0"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SpeedSlider" Minimum="1" Maximum="128" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Speed_OnChanged"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Окраска" Margin="0,8,0,0">
                        <StackPanel Margin="8">
                            <ComboBox x:Name="PaletteBox" SelectionChanged="Palette_OnChanged">
                                <ComboBoxItem Content="Полярный лёд"/><ComboBoxItem Content="Северное сияние"/>
                                <ComboBoxItem Content="Золотой кристалл"/><ComboBoxItem Content="Белый иней"/>
                            </ComboBox>
                            <ComboBox x:Name="ColoringBox" Margin="0,6,0,0" SelectionChanged="Appearance_OnChanged">
                                <ComboBoxItem Content="По времени замерзания"/><ComboBoxItem Content="По накопленной массе"/><ComboBoxItem Content="От центра к краю"/>
                            </ComboBox>
                            <UniformGrid Columns="3" Margin="0,6,0,0">
                                <Button x:Name="CenterColorButton" Content="Центр" Click="Color_OnClick" ToolTip="Выбрать цвет центра"/>
                                <Button x:Name="TipColorButton" Content="Край" Click="Color_OnClick" ToolTip="Выбрать цвет молодых ветвей"/>
                                <Button x:Name="BackgroundButton" Content="Фон" Click="Color_OnClick" ToolTip="Выбрать цвет фона"/>
                            </UniformGrid>
                            <CheckBox x:Name="VaporVisibleBox" Content="Показать водяной пар" Margin="0,7,0,0" Click="Appearance_OnChanged"/>
                        </StackPanel>
                    </GroupBox>
                    <Button Content="Вместить кристалл" Click="Fit_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="Saves_OnClick"/>
                    <Button Content="Экспорт текущего кристалла" Click="Export_OnClick"/>
                    <TextBlock x:Name="StatusText" Text="Подготовка поля…" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock Text="Условия можно менять по ходу роста. Размер поля и затравки применяются кнопкой «Новый рост»." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Theme.DisabledTextBrush}"/>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" CornerRadius="7" ClipToBounds="True"
                Background="#030A18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" theme:ThemeContract.IgnoreAudit="True"
                MouseWheel="Canvas_OnMouseWheel" MouseLeftButtonDown="Canvas_OnMouseDown" MouseLeftButtonUp="Canvas_OnMouseUp" MouseMove="Canvas_OnMouseMove" LostMouseCapture="Canvas_OnLostCapture">
            <Grid>
                <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="FrameImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000">
                    <TextBlock x:Name="GrowthText" Foreground="White" Text="Шаг 0 · ледяная затравка"/>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,6" CornerRadius="5" Background="#90000000">
                    <TextBlock Foreground="White" Text="Колесо — масштаб · ЛКМ — перемещение · пробел — пауза"/>
                </Border>
            </Grid>
        </Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
