<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.PhoenixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        Title="Исследователь фрактала Феникс"
        Width="1180" Height="760" MinWidth="940" MinHeight="600" WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Phoenix.ico" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6,3"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4,0,4"/></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Формула Феникса"/>
                    <TextBlock Margin="0,5,0,9" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="zₙ₊₁ = F(zₙ)ᵃ + C1·F(zₙ)ᵇ + C2·zₙ₋₁"/>

                    <TextBlock Text="Плоскость"/>
                    <ComboBox x:Name="PlaneModeBox" SelectionChanged="PlaneModeBox_OnChanged">
                        <ComboBoxItem Content="Динамическая (Julia)" Tag="Julia"/>
                        <ComboBoxItem Content="Параметрическая C1" Tag="ParameterC1"/>
                    </ComboBox>
                    <TextBlock Text="Вариант F(z)"/>
                    <ComboBox x:Name="VariantBox" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="Классический" Tag="Classic"/>
                        <ComboBoxItem Content="Трикорн" Tag="Tricorn"/>
                        <ComboBoxItem Content="Горящий Феникс" Tag="BurningShip"/>
                        <ComboBoxItem Content="Кельтский Феникс" Tag="Celtic"/>
                        <ComboBoxItem Content="Буффало Феникс" Tag="Buffalo"/>
                    </ComboBox>

                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="C1 Re (seed)"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="C1RealBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="C1 Im"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="C1ImaginaryBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="C2 Re (память)"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="C2RealBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="C2 Im"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="C2ImaginaryBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                    </Grid>
                    <Button Content="Исследовать плоскости C1/C2…" Click="ParameterSelector_OnClick"/>

                    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="12"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Степени a / b"/>
                        <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="PrimaryPowerBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/>
                        <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="SecondaryPowerBox" Grid.Column="3" TextChanged="Parameter_OnChanged"/>
                    </Grid>

                    <Expander Header="Начальные значения параметрических плоскостей" Margin="0,3,0,7">
                        <StackPanel Margin="0,7,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0"><TextBlock Text="z₀ Re"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="InitialZRealBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="z₀ Im"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="InitialZImaginaryBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0"><TextBlock Text="z₋₁ Re"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PreviousRealBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="z₋₁ Im"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PreviousImaginaryBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Итерации"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="IterationsBox" TextChanged="Parameter_OnChanged"/></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Радиус выхода"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ThresholdBox" TextChanged="Parameter_OnChanged"/></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Приближение"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ZoomBox" TextChanged="ZoomBox_OnChanged"
                                 ToolTip="Принимается и научная нотация: 1e500. Колесо мыши — ×1.2 за щелчок, с Ctrl — ×10, с Shift — ×1.05"/></StackPanel></Grid>
                    <Button x:Name="NucleusButton" Content="Навести на ядро" Click="NucleusButton_OnClick"
                            ToolTip="Метод Ньютона уточняет центр до ближайшей точки, чья орбита проходит через ноль (ядро мини-копии), и подбирает зум под её размер. Только для классического варианта."/>
                    <TextBlock x:Name="NucleusStatusText" Margin="0,2,0,4" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>

                    <TextBlock Text="Окрашивание"/>
                    <ComboBox x:Name="ColoringBox" SelectionChanged="ColoringBox_OnChanged">
                        <ComboBoxItem Content="Дискретное время выхода" Tag="Discrete"/>
                        <ComboBoxItem Content="Плавное время выхода" Tag="Smooth"/>
                        <ComboBoxItem Content="Ловушка орбиты" Tag="OrbitTrap"/>
                        <ComboBoxItem Content="Полосы по аргументу" Tag="StripeAverage"/>
                        <ComboBoxItem Content="Среднее неравенства треугольника" Tag="TriangleInequalityAverage"/>
                        <ComboBoxItem Content="Финальный аргумент" Tag="FinalArgument"/>
                        <ComboBoxItem Content="Периодические бассейны" Tag="Period"/>
                    </ComboBox>

                    <StackPanel x:Name="OrbitTrapPanel">
                        <TextBlock Text="Форма ловушки"/>
                        <ComboBox x:Name="OrbitTrapBox" SelectionChanged="Parameter_OnChanged">
                            <ComboBoxItem Content="Оси" Tag="Axes"/>
                            <ComboBoxItem Content="Окружность" Tag="Circle"/>
                            <ComboBoxItem Content="Точка в начале координат" Tag="Point"/>
                        </ComboBox>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Радиус"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="OrbitTrapRadiusBox" TextChanged="Parameter_OnChanged"/></StackPanel></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Сила"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="OrbitTrapStrengthBox" TextChanged="Parameter_OnChanged"/></StackPanel></Grid>
                    </StackPanel>
                    <StackPanel x:Name="StripePanel">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Частота полос"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="StripeFrequencyBox" TextChanged="Parameter_OnChanged"/></StackPanel></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Сила полос"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="StripeStrengthBox" TextChanged="Parameter_OnChanged"/></StackPanel></Grid>
                    </StackPanel>
                    <StackPanel x:Name="PeriodPanel">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Допуск цикла"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CycleToleranceBox" TextChanged="Parameter_OnChanged"/></StackPanel></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Макс. период"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="MaximumPeriodBox" TextChanged="Parameter_OnChanged"/></StackPanel></Grid>
                    </StackPanel>

                    <TextBlock Text="Потоки ЦП"/><ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>
                    <TextBlock Text="Сглаживание предпросмотра"/>
                    <ComboBox x:Name="SsaaBox" SelectionChanged="Parameter_OnChanged"><ComboBoxItem Content="Выкл. (1×)" Tag="1"/><ComboBoxItem Content="Низкое (2×)" Tag="2"/><ComboBoxItem Content="Высокое (4×)" Tag="4"/></ComboBox>
                    <Button Content="Запустить рендер" Click="RenderButton_OnClick"/><Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>
                    <Button Content="Настроить палитру" Click="PaletteButton_OnClick"/><Button Content="Менеджер сохранений" Click="SavesButton_OnClick"/>
                    <Button Content="Сохранить изображение" Click="ExportButton_OnClick"/>
                    <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Прогресс"/>
                    <ProgressBar x:Name="RenderProgress" Height="20" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap" Text="Готово"/>
                    <TextBlock x:Name="NavigationHint" Margin="0,12,0,0" Foreground="{DynamicResource Theme.DisabledTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="7" ClipToBounds="True" theme:ThemeContract.IgnoreAudit="True" SizeChanged="CanvasHost_OnSizeChanged"
                MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown" MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid>
                <Grid x:Name="ImageLayer" ClipToBounds="True">
                    <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="StablePreviewImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                </Grid>
                <controls:RenderProgressOverlay x:Name="RenderOverlay" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Button x:Name="ToggleControlsButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров" Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
