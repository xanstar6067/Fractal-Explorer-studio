<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.MathematicalLaboratoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Width="1180" Height="760" MinWidth="920" MinHeight="590"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ControlsColumn" Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ControlsHost" Margin="10" Padding="14"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DescriptionText" Margin="0,6,0,12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>

                    <TextBlock Text="Режим"/>
                    <ComboBox x:Name="ModeBox" Margin="0,3,0,8" SelectionChanged="Parameter_OnChanged"/>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PrimaryLabel" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="PrimaryBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SecondaryLabel" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="SecondaryBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TertiaryLabel" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="TertiaryBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ParameterLabel" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ParameterBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Поворот, °"/>
                        <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RotationBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/>
                    </Grid>

                    <CheckBox x:Name="ShowGuidesCheck" Margin="0,8,0,3" Content="Направляющие / связи"
                              Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                    <CheckBox x:Name="FilledCheck" Margin="0,3" Content="Заливка элементов"
                              Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                    <CheckBox x:Name="AnimateCheck" Margin="0,3,0,7" Content="Анимация"
                              Checked="AnimateCheck_OnChanged" Unchecked="AnimateCheck_OnChanged"/>

                    <Expander Header="Палитра" IsExpanded="False" Margin="0,3,0,6">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="Основной цвет"/>
                            <controls:ColorSelectorControl x:Name="PrimaryColorSelector"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                            <TextBlock Margin="0,5,0,0" Text="Второй цвет"/>
                            <controls:ColorSelectorControl x:Name="SecondaryColorSelector"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                            <TextBlock Margin="0,5,0,0" Text="Акцент"/>
                            <controls:ColorSelectorControl x:Name="AccentColorSelector"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                            <TextBlock Margin="0,5,0,0" Text="Фон"/>
                            <controls:ColorSelectorControl x:Name="BackgroundColorSelector"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                        </StackPanel>
                    </Expander>

                    <Button x:Name="ClearInputButton" Content="Очистить введённые точки"
                            Click="ClearInputButton_OnClick"/>
                    <Button x:Name="NewVariantButton" Content="Новый случайный вариант"
                            Click="NewVariantButton_OnClick"/>
                    <UniformGrid Columns="2">
                        <Button Margin="0,4,3,4" Content="Сбросить вид" Click="ResetView_OnClick"/>
                        <Button Margin="3,4,0,4" Content="Перерисовать" Click="Render_OnClick"/>
                    </UniformGrid>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="Saves_OnClick"/>
                    <Button Content="Сохранить изображение" Click="Export_OnClick"/>

                    <TextBlock x:Name="ProgressText" Margin="0,10,0,4"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Ожидание"/>
                    <ProgressBar x:Name="ProgressBar" Height="20" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,7,0,0" Text="Готово" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock x:Name="InteractionText" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.DisabledTextBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black"
                ClipToBounds="True" BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel"
                MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseRightButtonDown="CanvasHost_OnMouseRightButtonDown"
                MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid>
                <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                <Border x:Name="RenderBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000"
                        Visibility="Collapsed">
                    <TextBlock x:Name="RenderBadgeText" Foreground="White" Text="Рендер…"/>
                </Border>
            </Grid>
        </Border>
        <Button x:Name="ToggleControlsButton" Grid.Column="1"
                Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕"
                ToolTip="Скрыть панель параметров" Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
