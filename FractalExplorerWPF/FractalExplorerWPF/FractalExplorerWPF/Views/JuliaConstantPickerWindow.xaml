<Window x:Class="FractalExplorerWPF.Views.JuliaConstantPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Выбор константы C" Width="860" Height="650" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterOwner" Icon="../Assets/Icons/FractalExplorer.ico"
        Closing="Window_OnClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Margin="0,3,12,8" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                           Text="Щёлкните по карте, чтобы выбрать C. Колесо — масштаб (Ctrl — ×10, Shift — точно), средняя кнопка — перемещение." TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0">
                <TextBlock Text="Re(C)"/>
                <TextBox x:Name="RealBox" Padding="6,4" TextChanged="ConstantText_OnChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="6,0">
                <TextBlock Text="Im(C)"/>
                <TextBox x:Name="ImaginaryBox" Padding="6,4" TextChanged="ConstantText_OnChanged"/>
            </StackPanel>
        </Grid>

        <Border x:Name="MapHost" Grid.Row="1" Margin="0,8" Background="Black"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True" ClipToBounds="True"
                SizeChanged="MapHost_OnSizeChanged" MouseWheel="MapHost_OnMouseWheel"
                MouseLeftButtonUp="MapHost_OnMouseLeftButtonUp"
                MouseDown="MapHost_OnMouseDown" MouseMove="MapHost_OnMouseMove" MouseUp="MapHost_OnMouseUp">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                <Canvas x:Name="MarkerLayer" IsHitTestVisible="False">
                    <Line x:Name="HorizontalMarker" Stroke="LimeGreen" StrokeThickness="2"/>
                    <Line x:Name="VerticalMarker" Stroke="LimeGreen" StrokeThickness="2"/>
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Подготовка карты..."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="105" Margin="4" Content="Сбросить вид" Click="Reset_OnClick"/>
                <Button Width="105" Margin="4" Content="Применить" IsDefault="True" Click="Accept_OnClick"/>
                <Button Width="105" Margin="4" Content="Отмена" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
