<Window x:Class="FractalExplorerWPF.Views.Fractal3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Трёхмерный фрактал" Width="1240" Height="800"
        MinWidth="960" MinHeight="600" WindowStartupLocation="CenterOwner"
        KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ControlsColumn" Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ControlsHost" Margin="10" Padding="14"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="PanelTitleText" FontSize="18" FontWeight="SemiBold" Text="Трёхмерный фрактал"/>
                    <TextBlock x:Name="KindDescriptionText" Margin="0,5,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>

                    <TextBlock Style="{StaticResource FieldCaption}" Text="Готовый вид"/>
                    <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_OnSelectionChanged"/>
                    <controls:LSystem3DEditor x:Name="LSystemEditor" Visibility="Collapsed" SettingsChanged="LSystem_OnChanged" Margin="0,8,0,0"/>

                    <StackPanel x:Name="DlaGrowthPanel" Visibility="Collapsed" Margin="0,8,0,4">
                        <TextBlock x:Name="DlaCountText" FontWeight="SemiBold" Text="Готовим затравку…"/>
                        <ProgressBar x:Name="DlaGrowthProgress" Height="6" Margin="0,6,0,6" Maximum="6000"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="DlaPlayButton" Content="▶ Наблюдать рост" Click="DlaPlay_OnClick" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="↺ Сначала" Click="DlaRestart_OnClick" Margin="4,0,0,0" ToolTip="Та же затравка и случайное число: воспроизводит тот же кластер"/>
                        </Grid>
                        <Button Content="Вписать коралл в кадр" Click="DlaFit_OnClick" ToolTip="Подобрать расстояние камеры по выросшему кластеру"/>
                        <TextBlock x:Name="DlaSpeedText" Style="{StaticResource FieldCaption}" Text="Темп показа"/>
                        <Slider x:Name="DlaSpeedSlider" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DlaDisplay_OnChanged"/>
                        <TextBlock Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11"
                                   Text="Вращайте мышью и приближайте колесом во время роста. Темп меняет размер порции, сохраняя форму кластера."/>
                    </StackPanel>

                    <Expander x:Name="ShapeExpander" Header="Форма" IsExpanded="True" Margin="0,6,0,4">
                        <StackPanel Margin="10,6,0,2">
                            <controls:Buddhabrot4DEditor x:Name="BuddhabrotEditor" Visibility="Collapsed" SettingsChanged="Parameter_OnChanged"/>
                            <StackPanel x:Name="DlaPanel" Visibility="Collapsed">
                                <TextBlock Text="Затравка" Style="{StaticResource FieldCaption}"/>
                                <ListBox x:Name="DlaSeedShapeBox" SelectionChanged="DlaGrowth_OnChanged" SelectedIndex="0" Margin="0,4,0,6">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBoxItem HorizontalContentAlignment="Center"><StackPanel><Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.AccentPrimaryBrush}" Margin="0,8,0,10"/><TextBlock Text="Точка" FontSize="11"/></StackPanel></ListBoxItem>
                                    <ListBoxItem HorizontalContentAlignment="Center"><StackPanel><Rectangle Width="4" Height="26" Fill="{DynamicResource Theme.AccentPrimaryBrush}"/><TextBlock Text="Стержень" FontSize="11"/></StackPanel></ListBoxItem>
                                    <ListBoxItem HorizontalContentAlignment="Center"><StackPanel><Ellipse Width="26" Height="26" StrokeThickness="3" Stroke="{DynamicResource Theme.AccentPrimaryBrush}"/><TextBlock Text="Кольцо" FontSize="11"/></StackPanel></ListBoxItem>
                                    <ListBoxItem HorizontalContentAlignment="Center"><StackPanel><Ellipse Width="26" Height="14" Fill="{DynamicResource Theme.AccentPrimaryBrush}" Margin="0,6"/><TextBlock Text="Диск" FontSize="11"/></StackPanel></ListBoxItem>
                                </ListBox>
                                <StackPanel x:Name="DlaSeedSizePanel">
                                    <TextBlock x:Name="DlaSeedSizeText" Style="{StaticResource FieldCaption}" Text="Размер затравки"/>
                                    <Slider x:Name="DlaSeedSizeSlider" Minimum="2" Maximum="24" Value="12" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="DlaGrowth_OnChanged"/>
                                </StackPanel>
                                <TextBlock x:Name="DlaStickText" Style="{StaticResource FieldCaption}" Text="Прилипание · 100 %"/>
                                <Slider x:Name="DlaStickSlider" Minimum="5" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DlaGrowth_OnChanged"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap"
                                           Text="Реже прилипают → проникают глубже, ветви плотнее. Чаще → тонкие разветвлённые дендриты."/>
                                <TextBlock x:Name="DlaTargetText" Style="{StaticResource FieldCaption}" Text="Цель · 6 000 частиц"/>
                                <Slider x:Name="DlaTargetSlider" Minimum="100" Maximum="20000" Value="6000" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="DlaDisplay_OnChanged"/>
                                <Expander Header="Поток частиц" IsExpanded="False" Margin="0,8,0,4">
                                    <StackPanel>
                                        <TextBlock x:Name="DlaFlowText" Style="{StaticResource FieldCaption}" Text="Без потока · свободная диффузия"/>
                                        <Slider x:Name="DlaFlowSlider" Minimum="0" Maximum="65" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DlaGrowth_OnChanged"/>
                                        <StackPanel x:Name="DlaDirectionPanel">
                                            <TextBlock Text="Направление · вид сверху (XZ)" FontSize="11" Margin="0,6,0,0"/>
                                            <controls:DirectionCompass x:Name="DlaCompass" Width="154" Height="154" HorizontalAlignment="Center"
                                                Angle="{Binding ElementName=DlaYawSlider, Path=Value, Mode=TwoWay}"/>
                                            <Slider x:Name="DlaYawSlider" Minimum="-180" Maximum="180" Value="0" Visibility="Collapsed" ValueChanged="DlaGrowth_OnChanged"/>
                                            <TextBlock x:Name="DlaPitchText" Text="Поток сверху вниз" FontSize="11"/>
                                            <Slider x:Name="DlaPitchSlider" Minimum="-90" Maximum="90" Value="-90" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DlaGrowth_OnChanged"/>
                                            <TextBlock Text="↓ −Y     ·     горизонтально     ·     ↑ +Y" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Стрелка показывает, куда летят частицы. Кластер растёт навстречу потоку." FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Expander>
                                <Button Content="Другой коралл" Click="DlaRandom_OnClick" ToolTip="Новое случайное число с теми же параметрами роста"/>
                                <Expander Header="Воспроизводимость" IsExpanded="False">
                                    <StackPanel>
                                        <TextBlock Text="Случайное число" Style="{StaticResource FieldCaption}"/>
                                        <TextBox x:Name="DlaRandomSeedBox" Text="42" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" TextChanged="DlaGrowth_OnChanged"/>
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Сохранение запоминает достигнутую стадию. После загрузки её можно продолжить кнопкой «Растить»."/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                           Text="Изменение затравки, прилипания или потока начинает новый рост. Палитра, свет и камера меняют готовый объём."/>
                            </StackPanel>
                            <StackPanel x:Name="GrayPanel" Visibility="Collapsed">
                                <TextBlock Text="U + 2V → 3V · реакция внутри объёма" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Вычисления на видеокарте"/>
                                <TextBlock x:Name="GrayDeviceText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Сетка по каждой оси (32–128)"/>
                                <TextBox x:Name="GraySizeBox" Text="64" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Подача F"/>
                                        <TextBox x:Name="GrayFeedBox" Text="0.030" numeric:NumericSpinner.IsEnabled="True"/>
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Диффузия U"/>
                                        <TextBox x:Name="GrayDuBox" Text="0.12" numeric:NumericSpinner.IsEnabled="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Убыль K"/>
                                        <TextBox x:Name="GrayKillBox" Text="0.062" numeric:NumericSpinner.IsEnabled="True"/>
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Диффузия V"/>
                                        <TextBox x:Name="GrayDvBox" Text="0.06" numeric:NumericSpinner.IsEnabled="True"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Затравка"/>
                                <ComboBox x:Name="GraySeedBox">
                                    <ComboBoxItem Content="Восемь сфер"/><ComboBoxItem Content="Шум внутри куба"/>
                                    <ComboBoxItem Content="Кольцо"/><ComboBoxItem Content="Чистая среда"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Случайное число"/>
                                <TextBox x:Name="GrayRandomBox" Text="42" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True"/>
                                <Button Content="Применить и начать заново" Click="GrayRestart_OnClick"/>
                                <TextBlock Text="Границы замкнуты по трём осям. Новый узор сначала развивается до стартовой стадии и встаёт на паузу. Пробел — пауза и продолжение." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Шагов на кадр"/>
                                <Slider x:Name="GraySpeedSlider" Minimum="1" Maximum="256" Value="16" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{Binding ElementName=GraySpeedSlider, Path=Value, StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Уровень поверхности V"/>
                                <Slider x:Name="GrayThresholdSlider" Minimum="0.01" Maximum="0.9" Value="0.18" ValueChanged="GrayView_OnChanged"/>
                                <TextBlock Text="{Binding ElementName=GrayThresholdSlider, Path=Value, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Срез объёма"/>
                                <ComboBox x:Name="GrayCutBox" SelectionChanged="GrayView_OnChanged">
                                    <ComboBoxItem Content="Целый объём"/><ComboBoxItem Content="По X"/>
                                    <ComboBoxItem Content="По Y"/><ComboBoxItem Content="По Z"/>
                                </ComboBox>
                                <Slider x:Name="GrayCutSlider" Minimum="-1" Maximum="1" Value="0" ValueChanged="GrayView_OnChanged"/>
                                <TextBlock Text="{Binding ElementName=GrayCutSlider, Path=Value, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Радиус сферической кисти"/>
                                <Slider x:Name="GrayBrushSlider" Minimum="0.02" Maximum="0.2" Value="0.08"/>
                                <Button x:Name="GrayBrushButton" Content="Добавить затравку в центре" Click="GrayBrush_OnClick"/>
                                <TextBlock Text="Shift + щелчок: сферическая затравка на выбранном срезе. Стиль «Плотность» показывает облако V; остальные стили — его поверхность." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="PowerPanel">
                                <TextBlock x:Name="PowerLabel" Style="{StaticResource FieldCaption}" Text="Степень n"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PowerBox"
                                         TextChanged="Parameter_OnChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PhoenixPowerPanel" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Степень при C₁ (0 или 1)"/>
                                <TextBox x:Name="PhoenixSecondaryPowerBox" numeric:NumericSpinner.IsEnabled="True"
                                         numeric:NumericSpinner.IsInteger="True" TextChanged="Parameter_OnChanged"
                                         ToolTip="0: qᵖ + C₁ + C₂qₙ₋₁; 1: qᵖ + C₁q + C₂qₙ₋₁"/>
                            </StackPanel>

                            <StackPanel x:Name="BurningShipFormulaPanel" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Формула 3D"/>
                                <ComboBox x:Name="BurningShipFormulaBox" SelectionChanged="Parameter_OnChanged">
                                    <ComboBoxItem Content="Кватернион · два отражения"/>
                                    <ComboBoxItem Content="Кватернион · три отражения"/>
                                    <ComboBoxItem Content="Сферическая степень · два отражения"/>
                                    <ComboBoxItem Content="Сферическая степень · три отражения"/>
                                </ComboBox>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                           Text="Кватернионная формула сохраняет плоский срез; сферическая даёт форму ближе к Мандельбульбу."/>
                            </StackPanel>

                            <StackPanel x:Name="JuliaPanel">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Константа C"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,4,4,4" numeric:NumericSpinner.IsEnabled="True"
                                             x:Name="JuliaCXBox" ToolTip="Первая координата C"
                                             TextChanged="Parameter_OnChanged"/>
                                    <TextBox Grid.Column="1" Margin="0,4,4,4" numeric:NumericSpinner.IsEnabled="True"
                                             x:Name="JuliaCYBox" ToolTip="Вторая координата C"
                                             TextChanged="Parameter_OnChanged"/>
                                    <TextBox Grid.Column="2" Margin="0,4,0,4" numeric:NumericSpinner.IsEnabled="True"
                                             x:Name="JuliaCZBox" ToolTip="Третья координата C"
                                             TextChanged="Parameter_OnChanged"/>
                                </Grid>
                                <StackPanel x:Name="QuaternionPanel">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Четвёртая координата C"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="JuliaCWBox"
                                             TextChanged="Parameter_OnChanged"/>
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Координата среза w"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="SliceBox"
                                             TextChanged="Parameter_OnChanged"/>
                                </StackPanel>
                                <StackPanel x:Name="JuliabulbPickerPanel" Margin="0,7,0,3">
                                    <Button x:Name="JuliaPickerButton" Content="Выбрать C на Мандельбульбе" Click="JuliabulbPicker_OnClick"/>
                                    <TextBlock Margin="0,4,0,4" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                               Text="Щёлкните по миниатюре, чтобы открыть 3D-карту выбора C"/>
                                    <Border x:Name="JuliabulbMapHost" Height="150" Background="Black"
                                            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                            CornerRadius="5" ClipToBounds="True" Cursor="Hand"
                                            ToolTip="Открыть 3D-карту выбора C"
                                            theme:ThemeContract.IgnoreAudit="True"
                                            SizeChanged="JuliabulbMapHost_OnSizeChanged"
                                            MouseLeftButtonDown="JuliabulbMapHost_OnMouseLeftButtonDown">
                                        <Grid>
                                            <Image x:Name="JuliabulbMapImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="PhoenixMemoryPanel" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Константа памяти C₂ (вещественная; i; j)"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,4,4,4" x:Name="PhoenixMemoryXBox"
                                             numeric:NumericSpinner.IsEnabled="True" ToolTip="Вещественная часть C₂"
                                             TextChanged="Parameter_OnChanged"/>
                                    <TextBox Grid.Column="1" Margin="0,4,4,4" x:Name="PhoenixMemoryYBox"
                                             numeric:NumericSpinner.IsEnabled="True" ToolTip="Координата i константы C₂"
                                             TextChanged="Parameter_OnChanged"/>
                                    <TextBox Grid.Column="2" Margin="0,4,0,4" x:Name="PhoenixMemoryZBox"
                                             numeric:NumericSpinner.IsEnabled="True" ToolTip="Координата j константы C₂"
                                             TextChanged="Parameter_OnChanged"/>
                                </Grid>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                           Text="Начальная предыдущая итерация равна нулю. При нулевых i, j у C₁ и C₂ срез z = 0 повторяет 2D Phoenix."/>
                            </StackPanel>

                            <StackPanel x:Name="BoxPanel">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Масштаб свёртки"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="BoxScaleBox"
                                         TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Минимальный радиус инверсии"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="BoxMinRadiusBox"
                                         TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Предел свёртки по кубу"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="BoxFoldingBox"
                                         TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Форма инверсии"/>
                                <ComboBox x:Name="BoxInversionShapeBox" SelectionChanged="BoxInversionShape_OnChanged">
                                    <ComboBoxItem Content="Сфера (классическая)"/>
                                    <ComboBoxItem Content="Куб"/>
                                    <ComboBoxItem Content="Вытянутая сфера"/>
                                    <ComboBoxItem Content="Скруглённый куб"/>
                                </ComboBox>
                                <StackPanel x:Name="BoxInversionStretchPanel">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Вытяжение по оси Z (0,5–2)"/>
                                    <Slider x:Name="BoxInversionStretchSlider" Minimum="0.5" Maximum="2"
                                            TickFrequency="0.1" IsSnapToTickEnabled="False"
                                            ValueChanged="Parameter_OnChanged"/>
                                    <TextBlock Text="{Binding ElementName=BoxInversionStretchSlider, Path=Value, StringFormat={}{0:F2}×}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel x:Name="BoxInversionPowerPanel">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Округлость куба (2–16)"/>
                                    <Slider x:Name="BoxInversionPowerSlider" Minimum="2" Maximum="16"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="Parameter_OnChanged"/>
                                    <TextBlock Text="{Binding ElementName=BoxInversionPowerSlider, Path=Value, StringFormat={}{0:F0}}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="HybridPanel" Margin="0,7,0,0">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Начало цикла"/>
                                <ComboBox x:Name="HybridOrderBox" SelectionChanged="Parameter_OnChanged">
                                    <ComboBoxItem Content="Сначала Мандельбульб"/>
                                    <ComboBoxItem Content="Сначала Мандельбокс"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Итераций Мандельбульба подряд (1–6)"/>
                                <TextBox x:Name="HybridBulbStepsBox" numeric:NumericSpinner.IsEnabled="True"
                                         numeric:NumericSpinner.IsInteger="True" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Итераций Мандельбокса подряд (1–6)"/>
                                <TextBox x:Name="HybridBoxStepsBox" numeric:NumericSpinner.IsEnabled="True"
                                         numeric:NumericSpinner.IsInteger="True" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Доля второй операции (0–1)"/>
                                <TextBox x:Name="HybridMixBox" numeric:NumericSpinner.IsEnabled="True"
                                         ToolTip="0 — строгое чередование; 0,5 — равная смесь; 1 — операции меняются местами"
                                         TextChanged="Parameter_OnChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="KifsPanel" Visibility="Collapsed">
                                <CheckBox x:Name="KifsNearbyBox" Content="Вариации текущей формы" IsChecked="True" ToolTip="Выключите для случайного выбора семейства из готовых форм"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <Button Content="Случайная форма" Click="KifsRandom_OnClick" Margin="0,4,5,4"/>
                                    <Button Grid.Column="1" Content="Отменить" Click="KifsUndo_OnClick" ToolTip="Откат карты смещения, рандомайзера или обнуления поворота"/>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Симметрия отражений"/>
                                <ComboBox x:Name="KifsSymmetryBox" SelectionChanged="Kifs_OnChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Тетраэдр · четыре вершины"/>
                                    <ComboBoxItem Content="Октаэдр · восемь граней"/>
                                    <ComboBoxItem Content="Куб · зеркала по осям"/>
                                    <ComboBoxItem Content="Звезда · радиальные зеркала"/>
                                </ComboBox>
                                <StackPanel x:Name="KifsSectorsPanel" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Число лучей звезды (3–16)"/>
                                    <TextBox x:Name="KifsSectorsBox" Text="6" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" TextChanged="Kifs_OnChanged"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Масштаб на каждой итерации"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="KifsScaleSlider" Minimum="1.2" Maximum="4" Value="2" SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="Kifs_OnChanged"/>
                                    <TextBox Grid.Column="1" x:Name="KifsScaleBox" Text="{Binding ElementName=KifsScaleSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Kifs_OnChanged"/>
                                </Grid>
                                <TextBlock Text="Смещение · перетащите точку на карте" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                <ComboBox x:Name="KifsPlaneBox" SelectedIndex="0" SelectionChanged="Kifs_OnChanged" ToolTip="Третья координата сохраняется при смене плоскости">
                                    <ComboBoxItem Content="Плоскость XY"/><ComboBoxItem Content="Плоскость XZ"/><ComboBoxItem Content="Плоскость YZ"/>
                                </ComboBox>
                                <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                    <Canvas x:Name="KifsOffsetMap" Height="170" Background="{DynamicResource Theme.BaseBackgroundBrush}" Cursor="Cross" SizeChanged="KifsMap_OnSizeChanged" MouseLeftButtonDown="KifsMap_OnMouseDown" MouseMove="KifsMap_OnMouseMove" MouseLeftButtonUp="KifsMap_OnMouseUp"/>
                                </Border>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Смещение X"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="KifsOffsetXSlider" Minimum="-2" Maximum="2" Value="1" SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="Kifs_OnChanged"/>
                                    <TextBox Grid.Column="1" x:Name="KifsOffsetXBox" Text="{Binding ElementName=KifsOffsetXSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Kifs_OnChanged"/>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Смещение Y"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="KifsOffsetYSlider" Minimum="-2" Maximum="2" Value="1" SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="Kifs_OnChanged"/>
                                    <TextBox Grid.Column="1" x:Name="KifsOffsetYBox" Text="{Binding ElementName=KifsOffsetYSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Kifs_OnChanged"/>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Смещение Z"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="KifsOffsetZSlider" Minimum="-2" Maximum="2" Value="1" SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="Kifs_OnChanged"/>
                                    <TextBox Grid.Column="1" x:Name="KifsOffsetZBox" Text="{Binding ElementName=KifsOffsetZSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Kifs_OnChanged"/>
                                </Grid>
                                <Expander Header="Поворот и исходная форма" IsExpanded="False" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Исходная форма на последнем уровне"/>
                                        <ComboBox x:Name="KifsSeedBox" SelectedIndex="0" SelectionChanged="Kifs_OnChanged">
                                            <ComboBoxItem Content="Сфера · округлые кристаллы"/>
                                            <ComboBoxItem Content="Куб · многогранные лабиринты"/>
                                            <ComboBoxItem Content="Октаэдр · острые грани"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Размер исходной формы"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="KifsRadiusSlider" Minimum="0.1" Maximum="2" Value="1" SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="Kifs_OnChanged"/>
                                            <TextBox Grid.Column="1" x:Name="KifsRadiusBox" Text="{Binding ElementName=KifsRadiusSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Kifs_OnChanged"/>
                                        </Grid>
                                        <TextBlock Text="Поворот на каждой итерации" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="X · градусы"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="KifsRotationXSlider" Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="10" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="Kifs_OnChanged"/>
                                            <TextBox Grid.Column="1" x:Name="KifsRotationXBox" Text="{Binding ElementName=KifsRotationXSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Kifs_OnChanged"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Y · градусы"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="KifsRotationYSlider" Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="10" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="Kifs_OnChanged"/>
                                            <TextBox Grid.Column="1" x:Name="KifsRotationYBox" Text="{Binding ElementName=KifsRotationYSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Kifs_OnChanged"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Z · градусы"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="KifsRotationZSlider" Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="10" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="Kifs_OnChanged"/>
                                            <TextBox Grid.Column="1" x:Name="KifsRotationZBox" Text="{Binding ElementName=KifsRotationZSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" numeric:NumericSpinner.IsEnabled="True" TextChanged="Kifs_OnChanged"/>
                                        </Grid>
                                        <Button Content="Обнулить поворот" Click="KifsResetRotation_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="Порядок: отражения → поворот X/Y/Z → масштаб → смещение × (масштаб − 1). Итерации ниже задают глубину деталей." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Margin="0,6"/>
                            </StackPanel>
                            <StackPanel x:Name="SierpinskiPanel">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Масштаб складывания"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="SierpinskiScaleBox"
                                         TextChanged="Parameter_OnChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="CubeThicknessPanel">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Толщина элементов"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CubeThicknessBox"
                                         ToolTip="1 — классическая форма; меньше — тоньше, больше — массивнее"
                                         TextChanged="Parameter_OnChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="TerrainPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Тип поверхности"/>
                                <ComboBox x:Name="TerrainTypeBox" SelectionChanged="Terrain_OnChanged">
                                    <ComboBoxItem Content="Холмы — fBm"/>
                                    <ComboBoxItem Content="Горные хребты"/>
                                    <ComboBoxItem Content="Гибридный рельеф"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Начальное число (0–2 147 483 647)"/>
                                <TextBox x:Name="TerrainSeedBox" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" ToolTip="Одно и то же число воспроизводит тот же ландшафт" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Уровни деталей (1–12)"/>
                                <TextBox x:Name="TerrainOctavesBox" numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" ToolTip="Слишком мелкие для выбранной сетки уровни отсекаются" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Шероховатость (0,05–0,95)"/>
                                <TextBox x:Name="TerrainRoughnessBox" numeric:NumericSpinner.IsEnabled="True" ToolTip="Амплитуда следующего уровня: больше — грубее" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Отношение масштабов (1,5–3)"/>
                                <TextBox x:Name="TerrainLacunarityBox" numeric:NumericSpinner.IsEnabled="True" ToolTip="Рост частоты между соседними уровнями" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Масштаб деталей (0,25–16)"/>
                                <TextBox x:Name="TerrainScaleBox" numeric:NumericSpinner.IsEnabled="True" ToolTip="Число базовых волн на участке: больше — мельче" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Высота (0,05–8)"/>
                                <TextBox x:Name="TerrainHeightBox" numeric:NumericSpinner.IsEnabled="True" ToolTip="Белый цвет карты высот соответствует этой высоте" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Размер участка (1–20)"/>
                                <TextBox x:Name="TerrainSizeBox" numeric:NumericSpinner.IsEnabled="True" ToolTip="Ширина и длина участка в единицах мира" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Сетка / размер карты высот"/>
                                <ComboBox x:Name="TerrainResolutionBox" SelectionChanged="Terrain_OnChanged">
                                    <ComboBoxItem Content="257 × 257"/><ComboBoxItem Content="513 × 513"/>
                                    <ComboBoxItem Content="1025 × 1025"/><ComboBoxItem Content="2049 × 2049"/>
                                </ComboBox>
                                <Button Content="Новый ландшафт" Click="TerrainRandom_OnClick" Margin="0,6,0,0"/>
                                <Button x:Name="TerrainExportButton" Content="Экспорт карты высот…" Click="TerrainExport_OnClick" Margin="0,6,0,0"/>
                                <TextBlock Text="PNG 16 бит: чёрный = 0, белый = высота. X слева направо, Z сверху вниз; весь участок без света и перспективы." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                            </StackPanel>

                            <StackPanel x:Name="FlamePanel" Visibility="Collapsed">
                                <Button Content="Преобразования и рандомайзер…" Click="FlameTransforms_OnClick"/>
                                <TextBlock Margin="0,5,0,8" Text="Цвет приходит от орбит. Начните с готового вида или создайте свой набор в редакторе." TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Начальное число (воспроизводимый узор)"/>
                                <TextBox x:Name="FlameSeedBox" TextChanged="Parameter_OnChanged" numeric:NumericSpinner.IsEnabled="True"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Прогрев орбиты (10–1000)"/>
                                <TextBox x:Name="FlameWarmupBox" TextChanged="Parameter_OnChanged" numeric:NumericSpinner.IsEnabled="True"/>
                                <TextBlock FontWeight="SemiBold" Text="Тональная коррекция" Margin="0,10,0,3"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Экспозиция (0,05–20)"/>
                                <TextBox x:Name="FlameExposureBox" TextChanged="Parameter_OnChanged" numeric:NumericSpinner.IsEnabled="True"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Гамма (0,5–4)"/>
                                <TextBox x:Name="FlameGammaBox" TextChanged="Parameter_OnChanged" numeric:NumericSpinner.IsEnabled="True"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Плотность / поглощение (0,05–10)"/>
                                <TextBox x:Name="FlameDensityBox" TextChanged="Parameter_OnChanged" numeric:NumericSpinner.IsEnabled="True"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Насыщенность (0–2)"/>
                                <TextBox x:Name="FlameVibrancyBox" TextChanged="Parameter_OnChanged" numeric:NumericSpinner.IsEnabled="True"/>
                                <TextBlock Text="Эти четыре параметра меняют готовый объём без повторного накопления. «Шейдер» переключает облако и освещённую скульптуру." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="IfsPanel" Visibility="Collapsed">
                                <Button Content="Трансформации" Click="IfsTransforms_OnClick"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                           Text="Матрицы, веса и случайная генерация — в отдельном редакторе." TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel x:Name="AttractorPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Система"/>
                                <ComboBox x:Name="AttractorSystemBox" SelectionChanged="AttractorSystem_OnChanged">
                                    <ComboBoxItem Content="Лоренц · двойное крыло"/>
                                    <ComboBoxItem Content="Рёсслер · спираль и изгиб"/>
                                    <ComboBoxItem Content="Томас · три переплетения"/>
                                    <ComboBoxItem Content="Халворсен · тройная симметрия"/>
                                    <ComboBoxItem Content="Айзава · круговая воронка"/>
                                    <ComboBoxItem Content="Дадрас · раскрытые крылья"/>
                                    <ComboBoxItem Content="Чуа · двойная спираль"/>
                                </ComboBox>
                                <TextBlock x:Name="AttractorDescriptionText" Margin="0,5,0,8" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                                <TextBlock Text="Параметры потока" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <StackPanel x:Name="AttractorAField"><TextBlock x:Name="AttractorALabel" Style="{StaticResource FieldCaption}"/><TextBox x:Name="AttractorABox" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/></StackPanel>
                                <StackPanel x:Name="AttractorBField"><TextBlock x:Name="AttractorBLabel" Style="{StaticResource FieldCaption}"/><TextBox x:Name="AttractorBBox" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/></StackPanel>
                                <StackPanel x:Name="AttractorCField"><TextBlock x:Name="AttractorCLabel" Style="{StaticResource FieldCaption}"/><TextBox x:Name="AttractorCBox" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/></StackPanel>
                                <StackPanel x:Name="AttractorDField"><TextBlock x:Name="AttractorDLabel" Style="{StaticResource FieldCaption}"/><TextBox x:Name="AttractorDBox" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/></StackPanel>
                                <StackPanel x:Name="AttractorEField"><TextBlock x:Name="AttractorELabel" Style="{StaticResource FieldCaption}"/><TextBox x:Name="AttractorEBox" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/></StackPanel>
                                <StackPanel x:Name="AttractorFField"><TextBlock x:Name="AttractorFLabel" Style="{StaticResource FieldCaption}"/><TextBox x:Name="AttractorFBox" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/></StackPanel>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Шаг времени (0,0001–0,05)"/>
                                <TextBox x:Name="AttractorStepBox" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Начальная точка X / Y / Z"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="AttractorStartXBox" Grid.Column="0" Margin="0,0,4,0" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                                    <TextBox x:Name="AttractorStartYBox" Grid.Column="1" Margin="0,0,4,0" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                                    <TextBox x:Name="AttractorStartZBox" Grid.Column="2" numeric:NumericSpinner.IsEnabled="True" TextChanged="Parameter_OnChanged"/>
                                </Grid>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}"
                                           Text="Пресеты наверху задают готовый вид. Смена системы здесь загружает её классические параметры. Число точек задаётся ниже; камера вращается без повторного расчёта траектории."/>
                            </StackPanel>

                            <TextBlock x:Name="IterationsLabel" Style="{StaticResource FieldCaption}" Text="Итерации"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True"
                                     x:Name="IterationsBox" TextChanged="Parameter_OnChanged"/>

                            <StackPanel x:Name="BailoutPanel">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Радиус вылета"/>
                                <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="BailoutBox"
                                         TextChanged="Parameter_OnChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Камера" IsExpanded="True" Margin="0,2,0,4">
                        <StackPanel Margin="10,6,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Азимут, °"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="YawBox"
                                             TextChanged="Camera_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Наклон, °"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PitchBox"
                                             TextChanged="Camera_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Крен, °"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RollBox"
                                             ToolTip="Поворот камеры вокруг оси взгляда; положительный крен поворачивает картинку по часовой стрелке."
                                             TextChanged="Camera_OnChanged"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Расстояние"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DistanceBox"
                                             TextChanged="Camera_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Поле зрения, °"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="FieldOfViewBox"
                                             TextChanged="Camera_OnChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Точка, на которую смотрит камера"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,4,4,4" numeric:NumericSpinner.IsEnabled="True"
                                         x:Name="TargetXBox" ToolTip="X" TextChanged="Camera_OnChanged"/>
                                <TextBox Grid.Column="1" Margin="0,4,4,4" numeric:NumericSpinner.IsEnabled="True"
                                         x:Name="TargetYBox" ToolTip="Y" TextChanged="Camera_OnChanged"/>
                                <TextBox Grid.Column="2" Margin="0,4,0,4" numeric:NumericSpinner.IsEnabled="True"
                                         x:Name="TargetZBox" ToolTip="Z" TextChanged="Camera_OnChanged"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44*"/><ColumnDefinition Width="56*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Height="40" Margin="0,0,4,0" Padding="4,0" FontSize="11" Content="Сбросить вид"
                                        Click="ResetViewButton_OnClick"/>
                                <Button Grid.Column="1" Height="40" Padding="4,0" FontSize="11" Content="Выровнять горизонт"
                                        ToolTip="Убрать крен, не меняя направления взгляда (двойной щелчок средней кнопкой)."
                                        Click="LevelHorizonButton_OnClick"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Навигация" Margin="0,2,0,4">
                        <StackPanel Margin="10,6,0,2">
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Управление камерой"/>
                            <ComboBox x:Name="NavigationModeBox" SelectionChanged="NavigationMode_OnChanged">
                                <ComboBoxItem Content="CAD"/>
                                <ComboBoxItem Content="Игровой"/>
                            </ComboBox>
                            <StackPanel x:Name="GameNavigationPanel" Visibility="Collapsed">
                                <TextBlock x:Name="GameSpeedLabel" Style="{StaticResource FieldCaption}" Text="Скорость движения: 1,0×"/>
                                <Slider x:Name="GameSpeedSlider" Minimum="0.1" Maximum="5" Value="1"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.5"
                                        AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"
                                        ValueChanged="GameSlider_OnValueChanged"/>
                                <TextBlock x:Name="GameSensitivityLabel" Style="{StaticResource FieldCaption}" Text="Чувствительность мыши: 1,0×"/>
                                <Slider x:Name="GameSensitivitySlider" Minimum="0.1" Maximum="3" Value="1"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.5"
                                        AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"
                                        ValueChanged="GameSlider_OnValueChanged"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Качество в движении"/>
                            <ComboBox x:Name="MotionQualityBox" SelectionChanged="Navigation_OnChanged"
                                      ToolTip="Чем жертвует живой кадр, пока камера движется. После остановки кадр всегда достраивается полностью.">
                                <ComboBoxItem Content="Полное"/>
                                <ComboBoxItem Content="Без мягких теней"/>
                                <ComboBoxItem Content="Черновое"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Разрешение в движении"/>
                            <ComboBox x:Name="MotionResolutionBox" SelectionChanged="Navigation_OnChanged"
                                      ToolTip="Размер живого кадра, пока камера движется. «Авто» уменьшает его, чтобы держать около 30 к/с; «Полное» не снижает разрешение никогда.">
                                <ComboBoxItem Content="Авто (около 30 к/с)"/>
                                <ComboBoxItem Content="Полное (100%)"/>
                                <ComboBoxItem Content="75%"/>
                                <ComboBoxItem Content="50%"/>
                            </ComboBox>
                            <CheckBox x:Name="RotationInertiaBox" Content="Инерция вращения"
                                      Checked="Navigation_OnChanged" Unchecked="Navigation_OnChanged"/>
                            <CheckBox x:Name="AutoRotateBox" Content="Автовращение"
                                      Checked="Navigation_OnChanged" Unchecked="Navigation_OnChanged"/>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Скорость автовращения, °/сек"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="AutoRotateSpeedBox"
                                     TextChanged="Navigation_OnChanged"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Качество" Margin="0,2,0,4">
                        <StackPanel Margin="10,6,0,2">
                            <Grid x:Name="RayQualityGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Шагов луча"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True"
                                             x:Name="MaxStepsBox" TextChanged="Parameter_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Детализация"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="DetailBox"
                                             ToolTip="Порог попадания в долях пикселя: меньше — тоньше детали и дольше рендер."
                                             TextChanged="Parameter_OnChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="MaxDistanceLabel" Style="{StaticResource FieldCaption}" Text="Дальность трассировки"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="MaxDistanceBox"
                                     TextChanged="Parameter_OnChanged"/>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Сглаживание предпросмотра"/>
                            <ComboBox x:Name="SsaaBox" SelectionChanged="Parameter_OnChanged">
                                <ComboBoxItem Content="Выкл. (1×)" Tag="1"/>
                                <ComboBoxItem Content="Низкое (2×)" Tag="2"/>
                                <ComboBoxItem Content="Высокое (4×)" Tag="4"/>
                            </ComboBox>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.DisabledTextBrush}"
                                       Text="Во время движения размер живого кадра подбирается по времени предыдущего, после остановки считаются полный кадр и сглаживание."/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="LightExpander" Header="Свет и тени" Margin="0,2,0,4">
                        <StackPanel Margin="10,6,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Азимут света, °"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="LightYawBox"
                                             TextChanged="Parameter_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Высота света, °"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="LightPitchBox"
                                             TextChanged="Parameter_OnChanged"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Фоновый свет"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="AmbientBox"
                                             TextChanged="Parameter_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldCaption}" Text="Блики"/>
                                    <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="SpecularBox"
                                             TextChanged="Parameter_OnChanged"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="SoftShadowsBox" Content="Мягкие тени"
                                      Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Жёсткость теней"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ShadowSharpnessBox"
                                     TextChanged="Parameter_OnChanged"/>
                            <CheckBox x:Name="AmbientOcclusionBox" Content="Затенение складок (AO)"
                                      Checked="Parameter_OnChanged" Unchecked="Parameter_OnChanged"/>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Сила затенения"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="AoStrengthBox"
                                     TextChanged="Parameter_OnChanged"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="ShadingExpander" Header="Шейдер" Margin="0,2,0,4">
                        <StackPanel Margin="10,6,0,2">
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Освещение"/>
                            <ComboBox x:Name="ShadingStyleBox" SelectionChanged="Parameter_OnChanged"
                                      ToolTip="Набор встроенных шейдеров: форма фрактала не меняется, меняется способ превратить поверхность в цвет.">
                                <ComboBoxItem Content="Классический"/>
                                <ComboBoxItem Content="Глина"/>
                                <ComboBoxItem Content="Металл"/>
                                <ComboBoxItem Content="Свечение"/>
                                <ComboBoxItem Content="Плотность"/>
                                <ComboBoxItem Content="Студийный свет"/>
                                <ComboBoxItem Content="Контурный"/>
                                <ComboBoxItem Content="Просвечивание"/>
                                <ComboBoxItem Content="Зеркало"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Сила эффекта"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="EffectStrengthBox"
                                     ToolTip="Насколько выражен эффект выбранного шейдера: ореол свечения, отражение металла, число ступеней контура или сила зеркального отражения."
                                     TextChanged="Parameter_OnChanged"/>
                            <TextBlock x:Name="ShadingStyleHint" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.DisabledTextBrush}"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="ColoringExpander" Header="Окраска" Margin="0,2,0,4">
                        <StackPanel Margin="10,6,0,2">
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Источник цвета"/>
                            <ComboBox x:Name="ColoringModeBox" SelectionChanged="ColoringModeBox_OnSelectionChanged"
                                      ToolTip="Какая величина превращается в позицию на палитре.">
                                <ComboBoxItem Content="Материал"/>
                                <ComboBoxItem Content="По нормали"/>
                                <ComboBoxItem Content="Орбитальная ловушка"/>
                                <ComboBoxItem Content="По глубине"/>
                                <ComboBoxItem Content="Ловушка по осям"/>
                                <ComboBoxItem Content="Номер итерации"/>
                                <ComboBoxItem Content="Скорость убегания"/>
                                <ComboBoxItem Content="По высоте"/>
                                <ComboBoxItem Content="По затенению складок"/>
                                <ComboBoxItem Content="По углу взгляда"/>
                                <ComboBoxItem Content="По числу шагов луча"/>
                            </ComboBox>

                            <StackPanel x:Name="MaterialColorPanel">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Цвет материала"/>
                                <controls:ColorSelectorControl x:Name="SurfaceColorSelector"
                                                               SelectedColorChanged="Parameter_OnChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PalettePanel">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Палитра"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PaletteBox" DisplayMemberPath="Name"
                                              SelectionChanged="PaletteBox_OnSelectionChanged"/>
                                    <Button x:Name="PaletteManagerButton" Grid.Column="1" Margin="6,4,0,4" MinWidth="42" Content="…"
                                            ToolTip="Менеджер палитр трёхмерных фракталов"
                                            Click="PaletteManagerButton_OnClick"/>
                                </Grid>
                                <Border x:Name="PalettePreview" Height="16" Margin="0,2,0,2" CornerRadius="3"
                                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                        theme:ThemeContract.IgnoreAudit="True"/>
                                <TextBlock x:Name="DlaAgeLegend" Visibility="Collapsed" FontSize="11"
                                           Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Старые частицы  ←  цвет  →  молодые"/>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Повтор палитры"/>
                                <ComboBox x:Name="ColorRepeatBox" SelectionChanged="Parameter_OnChanged"
                                          ToolTip="Что делать со значениями вне палитры: зажать по краям, повторять по кругу или отражать туда и обратно.">
                                    <ComboBoxItem Content="Зажать"/>
                                    <ComboBoxItem Content="По кругу"/>
                                    <ComboBoxItem Content="Отражать"/>
                                </ComboBox>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Масштаб цвета"/>
                                        <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ColorScaleBox"
                                                 TextChanged="Parameter_OnChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldCaption}" Text="Сдвиг цвета"/>
                                        <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ColorOffsetBox"
                                                 TextChanged="Parameter_OnChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldCaption}" Text="Фон вверху"/>
                            <controls:ColorSelectorControl x:Name="BackgroundTopSelector"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Фон внизу"/>
                            <controls:ColorSelectorControl x:Name="BackgroundBottomSelector"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Цвет света"/>
                            <controls:ColorSelectorControl x:Name="LightColorSelector"
                                                           SelectedColorChanged="Parameter_OnChanged"/>
                            <TextBlock Style="{StaticResource FieldCaption}" Text="Влияние неба на свет"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="SkyLightMixBox"
                                     ToolTip="0 — фоновый свет нейтральный, как раньше. 1 — фоновый свет полностью берёт цвет неба над точкой."
                                     TextChanged="Parameter_OnChanged"/>
                        </StackPanel>
                    </Expander>

                    <Button Content="Запустить рендер" Click="RenderButton_OnClick"/>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="SavesButton_OnClick"/>
                    <Button Content="Сохранить изображение" Click="ExportButton_OnClick"/>

                    <TextBlock Margin="0,12,0,4" Text="Прогресс"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <ProgressBar x:Name="RenderProgress" Height="20" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="CameraText" Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock x:Name="StatusText" Margin="0,7,0,0" Text="Готово" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                    <TextBlock x:Name="NavigationHelpText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.DisabledTextBrush}"
                               Text="Левая кнопка: вращение вокруг точки, за которую схватили; по фону — поворот взгляда на месте. Правая: сдвиг. Средняя: влево-вправо — крен, вверх-вниз — наклон взгляда на месте. Колесо: приближение к точке под курсором (Ctrl — быстро, Shift — точно). Двойной щелчок левой: перелёт к точке, средней: выровнять горизонт. F11: полноэкранный режим."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" Focusable="True"
                ClipToBounds="True" BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel"
                MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseRightButtonDown="CanvasHost_OnMouseRightButtonDown"
                MouseDown="CanvasHost_OnMouseDown"
                MouseMove="CanvasHost_OnMouseMove"
                MouseLeftButtonUp="CanvasHost_OnMouseUp"
                MouseRightButtonUp="CanvasHost_OnMouseUp"
                MouseUp="CanvasHost_OnMouseUp" LostMouseCapture="CanvasHost_OnLostMouseCapture">
            <Grid>
                <Grid x:Name="SavePreviewLayer" ClipToBounds="True">
                    <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Border x:Name="DlaGrowthOverlay" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="12" Padding="10,6" CornerRadius="6" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding ElementName=DlaCountText, Path=Text}" FontSize="11"/>
                        <Button Content="{Binding ElementName=DlaPlayButton, Path=Content}" Click="DlaPlay_OnClick"/>
                    </StackPanel>
                </Border>
                <Border x:Name="GrayOverlay" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="12" Padding="10,6" CornerRadius="6" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="GrayTimeText" FontSize="11"/>
                        <Button x:Name="GrayPlayButton" Content="▶ Продолжить" Click="GrayPlay_OnClick"/>
                        <Button x:Name="GrayStepButton" Content="Один кадр" Click="GrayStep_OnClick"/>
                    </StackPanel>
                </Border>
                <!-- Оси мира поверх кадра; в превью сохранения не попадают. -->
                <Canvas x:Name="AxisTriad" Width="64" Height="64" Margin="8"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Button x:Name="ToggleControlsButton" Grid.Column="1"
                Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕"
                ToolTip="Скрыть панель параметров" Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
