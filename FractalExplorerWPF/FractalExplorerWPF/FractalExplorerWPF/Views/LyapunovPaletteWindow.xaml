<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.LyapunovPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Палитры экспоненты Ляпунова" Width="900" Height="640"
        MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Color.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Список палитр">
            <Grid Margin="6">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="PaletteList" MinHeight="180" SelectionChanged="PaletteList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Margin="5,0,0,0" Opacity="0.65" Text="[Встроенная]">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,0">
                    <Button Margin="2" Content="Новая" Click="New_OnClick"/>
                    <Button Margin="2" Content="Копия" Click="Copy_OnClick"/>
                    <Button x:Name="DeleteButton" Margin="2" Content="Удалить" Click="Delete_OnClick"/>
                </UniformGrid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Редактор палитры Ляпунова">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,3" Text="Название палитры"/>
                            <TextBox x:Name="NameBox" Padding="7" TextChanged="Editor_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,3" Text="Режим окраски"/>
                            <ComboBox x:Name="ModeBox" DisplayMemberPath="DisplayName" SelectionChanged="Editor_OnChanged"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,3" Text="Диапазон экспоненты λ"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="RangeBox" Padding="7" TextChanged="Editor_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,3" Text="Ширина нулевой зоны"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ZeroBox" Padding="7" TextChanged="Editor_OnChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Height="46" Margin="0,12,0,10" ClipToBounds="True"
                            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="4"
                            theme:ThemeContract.IgnoreAudit="True">
                        <Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,3" Text="Ключевые цвета"/>
                            <ListBox x:Name="ColorList" MinHeight="190" AllowDrop="True"
                                     SelectionChanged="ColorList_OnSelectionChanged" MouseDoubleClick="ColorList_OnMouseDoubleClick"
                                     PreviewMouseLeftButtonDown="ColorList_OnPreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ColorList_OnPreviewMouseMove" DragOver="ColorList_OnDragOver" Drop="ColorList_OnDrop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="26" Height="20" BorderBrush="#707070" BorderThickness="1" CornerRadius="2">
                                                <Border.Background><SolidColorBrush Color="{Binding}"/></Border.Background>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="Перетаскивайте цвета мышью или используйте стрелки. Двойной щелчок изменяет цвет."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,22,0,0">
                            <Button x:Name="AddButton" Margin="0,0,0,6" Content="Добавить…" Click="Add_OnClick"/>
                            <Button x:Name="EditButton" Margin="0,0,0,6" Content="Изменить…" Click="Edit_OnClick"/>
                            <Button x:Name="RemoveButton" Margin="0,0,0,12" Content="Удалить" Click="Remove_OnClick"/>
                            <Button x:Name="UpButton" Margin="0,0,0,6" Content="↑ Выше" Click="Up_OnClick"/>
                            <Button x:Name="DownButton" Margin="0,0,0,12" Content="↓ Ниже" Click="Down_OnClick"/>
                            <Button x:Name="RandomButton" Content="Случайные" Click="Random_OnClick"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="EditHint" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Button HorizontalAlignment="Left" MinWidth="160" Content="Сохранить изменения" Click="Save_OnClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Margin="0,0,8,0" Content="Применить" Click="Apply_OnClick"/>
                <Button Width="110" Content="Закрыть" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
