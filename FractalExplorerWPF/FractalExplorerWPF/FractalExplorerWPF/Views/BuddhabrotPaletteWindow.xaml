<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.BuddhabrotPaletteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Палитры Буддаброта" Width="900" Height="620" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListBox x:Name="PaletteList" DisplayMemberPath="Name" SelectionChanged="PaletteList_OnSelectionChanged"/>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,8"><Button Content="Новая" Click="New_OnClick"/><Button Content="Копия" Click="Copy_OnClick"/><Button x:Name="DeleteButton" Content="Удалить" Click="Delete_OnClick"/></UniformGrid>
            <Button Grid.Row="2" Content="Сохранить изменения" Click="Save_OnClick"/>
        </Grid>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Название"/><TextBox x:Name="NameBox" Margin="0,4,0,10"/>
            <TextBlock Text="Предпросмотр плотности"/>
            <Border Height="48" Margin="0,4,0,12" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"><Rectangle x:Name="PreviewRect"/></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Нормализация"/><ComboBox x:Name="ModeBox"><ComboBoxItem Content="Логарифмическая"/><ComboBoxItem Content="Квадратный корень"/><ComboBoxItem Content="Линейная"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Гамма"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="GammaBox"/></StackPanel>
            </Grid>
            <CheckBox x:Name="GradientBox" Margin="0,10,0,4" Content="Плавный градиент"/><CheckBox x:Name="AlignBox" Content="Согласовать шаги с итерациями рендера"/>
            <TextBlock Margin="0,10,0,0" Text="Количество цветовых шагов"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="StepsBox"/>
            <TextBlock Margin="0,12,0,4" Text="Цвета"/>
            <ListBox x:Name="ColorList" Height="190" SelectionChanged="ColorList_OnSelectionChanged">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="28" Height="22" Margin="2" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"><Border.Background><SolidColorBrush Color="{Binding}"/></Border.Background></Border><TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <UniformGrid Columns="5" Margin="0,6"><Button Content="Добавить" Click="Add_OnClick"/><Button x:Name="EditButton" Content="Изменить" Click="Edit_OnClick"/><Button x:Name="RemoveButton" Content="Удалить" Click="Remove_OnClick"/><Button Content="↑" Click="Up_OnClick"/><Button Content="↓" Click="Down_OnClick"/></UniformGrid>
            <Button Content="Случайные цвета" Click="Random_OnClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Width="120" Content="Применить" Click="Apply_OnClick"/><Button Width="100" Margin="8,0,0,0" Content="Закрыть" IsCancel="True"/></StackPanel>
        </StackPanel></ScrollViewer>
    </Grid>
</Window>
