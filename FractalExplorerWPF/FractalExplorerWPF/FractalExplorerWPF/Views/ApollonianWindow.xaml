<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.ApollonianWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Аполлонова прокладка" Width="1140" Height="740" MinWidth="900" MinHeight="590"
        WindowStartupLocation="CenterOwner" KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ControlsColumn" Width="310"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14"
                Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Аполлонова упаковка"/>
                    <TextBlock Margin="0,9,0,3" Text="Раскраска"/>
                    <ComboBox x:Name="ColoringBox" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="По глубине рекурсии"/>
                        <ComboBoxItem Content="По кривизне"/>
                        <ComboBoxItem Content="По родительской окружности"/>
                    </ComboBox>
                    <TextBlock Margin="0,7,0,3" Text="Отрисовка"/>
                    <ComboBox x:Name="DrawModeBox" SelectionChanged="Parameter_OnChanged">
                        <ComboBoxItem Content="Заполненные окружности"/>
                        <ComboBoxItem Content="Контуры"/>
                    </ComboBox>
                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Глубина"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="DepthBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Макс. окружностей"/><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="CircleLimitBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Мин. радиус"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="MinimumRadiusBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Толщина линии"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="LineWidthBox" Grid.Column="1" TextChanged="Parameter_OnChanged"/></Grid>
                    <Separator Margin="0,8"/>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Центр X"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CenterXBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Центр Y"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CenterYBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Ширина вида"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ViewWidthBox" Grid.Column="1" TextChanged="Viewport_OnChanged"/></Grid>
                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Начальный цвет" Click="StartColor_OnClick"/><Border x:Name="StartColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="StartColor_OnClick"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Конечный цвет" Click="EndColor_OnClick"/><Border x:Name="EndColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="EndColor_OnClick"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Content="Цвет фона" Click="BackgroundColor_OnClick"/><Border x:Name="BackgroundColorSwatch" Grid.Column="1" Margin="5" CornerRadius="4" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" MouseLeftButtonDown="BackgroundColor_OnClick"/></Grid>
                    <Button Content="Сбросить вид" Click="ResetView_OnClick"/>
                    <Button Content="Запустить рендер" Click="Render_OnClick"/>
                    <Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel_OnClick"/>
                    <Button Content="Менеджер сохранений" Click="Saves_OnClick"/>
                    <Button Content="Сохранить изображение" Click="Export_OnClick"/>
                    <TextBlock x:Name="ProgressText" Margin="0,12,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Ожидание"/>
                    <ProgressBar x:Name="ProgressBar" Height="20" Maximum="100"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Готово"/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.DisabledTextBrush}" Text="Колесо: масштаб. ЛКМ: перемещение. Мелкие касающиеся окружности добавляются рекурсивно."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" ClipToBounds="True"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7"
                theme:ThemeContract.IgnoreAudit="True" SizeChanged="CanvasHost_OnSizeChanged"
                MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid>
                <Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="StableImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="CurrentImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                <Border x:Name="RenderBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="5" Background="#B0000000" Visibility="Collapsed"><TextBlock x:Name="RenderBadgeText" Foreground="White"/></Border>
            </Grid>
        </Border>
        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}" Content="✕" ToolTip="Скрыть панель параметров" Click="Toggle_OnClick"/>
    </Grid>
</Window>
