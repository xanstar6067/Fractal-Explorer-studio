<Window xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls" x:Class="FractalExplorerWPF.Views.NovaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming" xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        Width="1140" Height="760" MinWidth="920" MinHeight="600" WindowStartupLocation="CenterOwner"
        KeyDown="Window_OnKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6,3"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4,0,4"/></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Theme.BaseBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControlsColumn" Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ControlsHost" Margin="10" Padding="14" Background="{DynamicResource Theme.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Margin="0,10,0,2" Text="Комплексная степень P"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,5,0"><TextBlock Text="Re"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PRealBox" TextChanged="MapFormulaParameter_OnChanged"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Im"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="PImaginaryBox" TextChanged="MapFormulaParameter_OnChanged"/></StackPanel>
                </Grid>
                <TextBlock Text="Начальные условия Z₀"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,5,0"><TextBlock Text="Re"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="Z0RealBox" TextChanged="MapFormulaParameter_OnChanged"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Im"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="Z0ImaginaryBox" TextChanged="MapFormulaParameter_OnChanged"/></StackPanel>
                </Grid>
                <StackPanel x:Name="JuliaParametersPanel">
                    <TextBlock Text="Константа C"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="Re"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CRealBox" TextChanged="JuliaMapParameter_OnChanged"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Im"/><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="CImaginaryBox" TextChanged="JuliaMapParameter_OnChanged"/></StackPanel>
                    </Grid>
                </StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Релаксация m"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="MBox" TextChanged="MapFormulaParameter_OnChanged"/></StackPanel>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Итерации"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" numeric:NumericSpinner.IsInteger="True" x:Name="IterationsBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Порог"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ThresholdBox" TextChanged="Parameter_OnChanged"/></StackPanel>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterRowLabelStyle}" Text="Приближение"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="ZoomBox" TextChanged="ZoomBox_OnChanged"/></StackPanel>
                </Grid>
                <TextBlock Text="Потоки ЦП"/><ComboBox x:Name="ThreadsBox" SelectionChanged="Parameter_OnChanged"/>
                <TextBlock Text="SSAA"/><ComboBox x:Name="SsaaBox" SelectionChanged="Parameter_OnChanged">
                    <ComboBoxItem Content="Выкл. (1×)" Tag="1"/><ComboBoxItem Content="Низкое (2×)" Tag="2"/><ComboBoxItem Content="Высокое (4×)" Tag="4"/>
                </ComboBox>
                <TextBlock Text="Окрашивание"/><ComboBox x:Name="ColoringBox" SelectionChanged="Parameter_OnChanged">
                    <ComboBoxItem Content="Дискретное"/><ComboBoxItem Content="Плавное"/>
                </ComboBox>
                <Button Content="Запустить рендер" Click="RenderButton_OnClick"/><Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="CancelButton_OnClick"/>
                <Button Content="Настроить палитру" Click="PaletteButton_OnClick"/><Button Content="Менеджер сохранений" Click="SavesButton_OnClick"/>
                <Button Content="Сохранить изображение" Click="ExportButton_OnClick"/>
                <TextBlock Margin="0,10,0,4" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Прогресс"/>
                <ProgressBar x:Name="RenderProgress" Height="20" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="StatusText" Margin="0,7,0,0" Foreground="{DynamicResource Theme.SecondaryTextBrush}" TextWrapping="Wrap" Text="Готово"/>
                <StackPanel x:Name="JuliaMapPanel" Margin="0,12,0,0">
                    <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource Theme.SecondaryTextBrush}" Text="Кликните по карте для выбора C"/>
                    <Border x:Name="JuliaMapHost" Height="150" Background="Black" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="5"
                            theme:ThemeContract.IgnoreAudit="True" MouseLeftButtonUp="JuliaMapPreview_OnMouseLeftButtonUp"
                            SizeChanged="JuliaMapHost_OnSizeChanged">
                        <Grid ClipToBounds="True"><Image x:Name="JuliaMapPreviewImage" Stretch="Fill"/><Canvas x:Name="JuliaMapMarker" IsHitTestVisible="False"/></Grid>
                    </Border>
                </StackPanel>
            </StackPanel></ScrollViewer>
        </Border>
        <Border x:Name="CanvasHost" Grid.Column="1" Margin="0,10,10,10" Background="Black" ClipToBounds="True"
                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="7" theme:ThemeContract.IgnoreAudit="True"
                SizeChanged="CanvasHost_OnSizeChanged" MouseWheel="CanvasHost_OnMouseWheel" MouseLeftButtonDown="CanvasHost_OnMouseLeftButtonDown"
                MouseMove="CanvasHost_OnMouseMove" MouseLeftButtonUp="CanvasHost_OnMouseLeftButtonUp">
            <Grid><Grid ClipToBounds="True"><Grid x:Name="SavePreviewLayer" ClipToBounds="True"><Image x:Name="StablePreviewImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/><Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Grid>
                <controls:RenderProgressOverlay x:Name="RenderOverlay" IsHitTestVisible="False"/></Grid>
        </Border>
        <Button x:Name="ToggleControlsButton" Grid.Column="1" Style="{StaticResource FractalPanelToggleButtonStyle}"
                Content="✕" ToolTip="Скрыть панель параметров" Click="ToggleControlsButton_OnClick"/>
    </Grid>
</Window>
