<Window x:Class="FractalExplorerWPF.Views.Fractal3DPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:numeric="clr-namespace:FractalExplorerWPF.Controls"
        xmlns:theme="clr-namespace:FractalExplorerWPF.Theming"
        Title="Палитры трёхмерных фракталов" Width="1020" Height="780"
        MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterOwner" Icon="../Assets/Icons/Color.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>

        <GroupBox Header="Палитры">
            <Grid Margin="6">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="PaletteList" SelectionChanged="PaletteList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Margin="5,0,0,0" Opacity="0.62" Text="[Встроенная]">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,0">
                    <Button Margin="2" Content="Новая" Click="New_OnClick"/>
                    <Button Margin="2" Content="Копия" Click="Copy_OnClick"/>
                    <Button x:Name="DeleteButton" Margin="2" Content="Удалить" Click="Delete_OnClick"/>
                </UniformGrid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Редактор палитры">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Margin="0,0,3,3" Text="Название"/>
                            <TextBox x:Name="NameBox"/>
                        </StackPanel>
                        <CheckBox x:Name="GradientBox" Grid.Column="1" Margin="0,21,12,0" Content="Плавный градиент"
                                  ToolTip="Снятый флажок превращает палитру в резкие полосы одинаковой ширины."
                                  Checked="Editor_OnChanged" Unchecked="Editor_OnChanged"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,3" Text="Гамма (0.1–5)"/>
                            <TextBox numeric:NumericSpinner.IsEnabled="True" x:Name="GammaBox"
                                     ToolTip="Сдвигает градиент к началу или к концу, не меняя цветов."
                                     TextChanged="Editor_OnChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="GradientPreview" Grid.Row="1" Height="40" Margin="0,12,0,10"
                            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="4"
                            theme:ThemeContract.IgnoreAudit="True"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="272"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="ColorList" MinHeight="210"
                                 MouseDoubleClick="ColorList_OnMouseDoubleClick"
                                 SelectionChanged="ColorList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Width="28" Height="21" BorderBrush="#707070" BorderThickness="1" CornerRadius="2">
                                            <Border.Background><SolidColorBrush Color="{Binding}"/></Border.Background>
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                            <Button x:Name="AddButton" Margin="0,0,0,6" Content="Добавить…" Click="Add_OnClick"/>
                            <Button x:Name="EditButton" Margin="0,0,0,6" Content="Изменить…" Click="Edit_OnClick"/>
                            <Button x:Name="RemoveButton" Margin="0,0,0,12" Content="Удалить" Click="Remove_OnClick"/>
                            <Button x:Name="UpButton" Margin="0,0,0,6" Content="↑ Выше" Click="Up_OnClick"/>
                            <Button x:Name="DownButton" Margin="0,0,0,12" Content="↓ Ниже" Click="Down_OnClick"/>
                            <Button x:Name="ReverseButton" Margin="0,0,0,6" Content="Перевернуть" Click="Reverse_OnClick"/>
                            <Button x:Name="RandomButton" Content="Случайная" Click="Random_OnClick"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="Black" ClipToBounds="True"
                                BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
                                CornerRadius="4" theme:ThemeContract.IgnoreAudit="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="PreviewHint" Margin="10" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#B0B0B0" theme:ThemeContract.IgnoreAudit="True"
                                           Text="Предпросмотр"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <GroupBox Grid.Row="3" Margin="0,12,0,0" Header="Окружение">
                        <StackPanel Margin="8,4,8,8">
                            <CheckBox x:Name="EnvironmentBox" Content="Палитра задаёт фон, свет и материал"
                                      ToolTip="Выключено — палитра меняет только цвет фигуры, а фон и свет остаются такими, как настроены в окне."
                                      Checked="Editor_OnChanged" Unchecked="Editor_OnChanged"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,4,0,2" Text="Фон вверху"/>
                                    <controls:ColorSelectorControl x:Name="BackgroundTopSelector"
                                                                   SelectedColorChanged="Editor_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,4,0,2" Text="Фон внизу"/>
                                    <controls:ColorSelectorControl x:Name="BackgroundBottomSelector"
                                                                   SelectedColorChanged="Editor_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Margin="0,8,0,2" Text="Цвет света"/>
                                    <controls:ColorSelectorControl x:Name="LightColorSelector"
                                                                   SelectedColorChanged="Editor_OnChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Margin="0,8,0,2" Text="Цвет материала"/>
                                    <controls:ColorSelectorControl x:Name="SurfaceColorSelector"
                                                                   SelectedColorChanged="Editor_OnChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <TextBlock x:Name="EditHint" Grid.Row="4" Margin="0,9,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextBrush}"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Button HorizontalAlignment="Left" MinWidth="155" Content="Сохранить изменения" Click="Save_OnClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Margin="0,0,8,0" Content="Применить" Click="Apply_OnClick"/>
                <Button Width="110" Content="Закрыть" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
